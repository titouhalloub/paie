<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta http-equiv="x-ua-compatible" content="IE=9">
<title>Paie - Rappel individualise v6</title>
<HTA:APPLICATION ID="HTA" APPLICATIONNAME="Paie" BORDER="thick" CAPTION="yes" SYSMENU="yes"
  MAXIMIZEBUTTON="yes" MINIMIZEBUTTON="yes" SHOWINTASKBAR="yes" WINDOWSTATE="maximize" SCROLL="no" />
<style>
body{font-family:"Segoe UI",Tahoma,Arial,sans-serif;font-size:13px;margin:0;background:#f3f5f8;color:#1d232b}
#top{background:#1f3a5f;color:#fff;padding:8px 14px;height:34px}
#top b{font-size:16px;margin-right:18px}
#top span{color:#bcd0ee}
#tabs{background:#dfe6f0;padding:6px 14px 0 14px;height:26px}
#tabs a{display:inline-block;padding:5px 16px;margin-right:3px;background:#c8d3e3;color:#1d232b;text-decoration:none;border-radius:4px 4px 0 0}
#tabs a.on{background:#fff;font-weight:bold}
.pane{display:none;padding:10px 14px;overflow:auto;position:absolute;top:100px;left:0;right:0;bottom:0}
.on{display:block}
table{border-collapse:collapse;background:#fff;font-size:12px}
th,td{border:1px solid #cfd6e0;padding:3px 7px;text-align:left;vertical-align:top;white-space:nowrap}
th{background:#e6ecf5}
td.num{text-align:right}
tr.foot td{background:#eef3fa;font-weight:bold}
#rpDetail table{border-collapse:collapse}
#rpDetail th,#rpDetail td{border:1px solid #cfd6e0;padding:4px 7px}
#rpDetail th{border-bottom:2px solid #718096}
#rpDetail tr.rp-employee-end td{border-bottom:2px solid #596579}
#rpDetail tr.rp-grand-total td{border-top:2px solid #26384f;font-weight:bold;background:#eef3fa}
.bar{margin-bottom:8px}
tr.click:hover{background:#eaf2ff;cursor:pointer}
.err{color:#b00020;font-weight:bold}
.ok{color:#0a7d2c;font-weight:bold}
.muted{color:#6b7480}
.box{background:#fff;border:1px solid #cfd6e0;padding:8px;margin-bottom:10px}
pre{background:#fff;border:1px solid #cfd6e0;padding:10px;font-family:Consolas,"Courier New",monospace;font-size:12px;white-space:pre-wrap}
button,input,select{font-size:12px;padding:3px 8px}
#tl{float:left;width:260px;height:100%;overflow:auto;background:#fff;border:1px solid #cfd6e0}
#tl div{padding:3px 8px;cursor:pointer;border-bottom:1px solid #eef1f5}
#tl div:hover{background:#eaf2ff}
#tg{margin-left:272px}
a{color:#0b5cd5}
.engbar{margin:6px 0}.engbar button{padding:4px 12px;margin-right:4px}.engbar button.on{font-weight:bold;background:#cfe0ff}.engsub{display:none}.engsub.on{display:block}
</style>


<script language="VBScript">
' Reads a field from a recordset as display text (VBScript handles Currency/Decimal safely)
Function CellText(rs, i)
  Dim v, t, s
  On Error Resume Next
  v = rs.Fields(i).Value
  If Err.Number <> 0 Then
    CellText = "#err"
    Exit Function
  End If
  If IsNull(v) Then
    CellText = ""
    Exit Function
  End If
  If IsArray(v) Then
    CellText = "[binaire]"
    Exit Function
  End If
  t = rs.Fields(i).Type
  Select Case t
    Case 6, 14, 131
      CellText = FormatNumber(v, 2, -1, 0, -1)
    Case 7, 133, 135
      If IsDate(v) Then
        CellText = Year(v) & "-" & Right("0" & Month(v), 2) & "-" & Right("0" & Day(v), 2)
      Else
        CellText = CStr(v)
      End If
    Case 11
      If v Then
        CellText = "Oui"
      Else
        CellText = "Non"
      End If
    Case Else
      s = CStr(v)
      If Len(s) > 300 Then s = Left(s, 300) & "..."
      CellText = s
  End Select
End Function

' Whole row as typed text, cells joined by Chr(1): N<number> I<integer> D<yyyy-mm-dd> S<text> E(empty)
Function RowRaw(rs)
  Dim i, v, t, c, s
  s = ""
  For i = 0 To rs.Fields.Count - 1
    On Error Resume Next
    v = rs.Fields(i).Value
    If Err.Number <> 0 Then
      Err.Clear
      c = "E"
    Else
      On Error GoTo 0
      If IsNull(v) Then
        c = "E"
      ElseIf IsArray(v) Then
        c = "S[binaire]"
      Else
        t = rs.Fields(i).Type
        Select Case t
          Case 6, 14, 131, 4, 5
            c = "N" & Replace(CStr(CDbl(v)), ",", ".")
          Case 2, 3, 16, 17, 18, 19, 20, 21
            c = "I" & CStr(v)
          Case 7, 133, 135
            If IsDate(v) Then
              c = "D" & Year(v) & "-" & Right("0" & Month(v), 2) & "-" & Right("0" & Day(v), 2)
            Else
              c = "S" & CStr(v)
            End If
          Case 11
            If v Then c = "SOui" Else c = "SNon"
          Case Else
            c = "S" & CStr(v)
        End Select
      End If
    End If
    On Error GoTo 0
    If i > 0 Then s = s & Chr(1)
    s = s & c
  Next
  RowRaw = s
End Function
</script>

<script language="JScript">
var PASSWORD = "Mus_lml";      // database password (built in)
window.onerror = function (msg, url, line) {
  try { document.getElementById("status").innerHTML = '<span style="color:#ff9b9b">Erreur script (ligne ' + line + '): ' + String(msg).replace(/</g, "&lt;") + '</span>'; } catch (x) { }
  return true;
};
var PAGE = 50;
var conn = null, cat = null, dbPath = "", tableNames = [], views = {};
var fso = new ActiveXObject("Scripting.FileSystemObject");
var sh = new ActiveXObject("WScript.Shell");

function $(id) { return document.getElementById(id); }
function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }
function sq(s) { return String(s).replace(/'/g, "''"); }
function enc(s) { return encodeURIComponent(String(s)).replace(/'/g, "%27"); }
function errText(e) { return (e && (e.description || e.message)) || String(e); }

/* step log (paie_log.txt next to the app, or in %TEMP%): shows where the app stopped if it ever closes by itself */
var logPath = "";
function log(m) {
  try {
    var f;
    if (!logPath) logPath = hostFolder() + "\\paie_log.txt";
    try { f = fso.OpenTextFile(logPath, 8, true); }
    catch (e1) { logPath = sh.ExpandEnvironmentStrings("%TEMP%") + "\\paie_log.txt"; f = fso.OpenTextFile(logPath, 8, true); }
    f.WriteLine(new Date().toString() + " [" + (proc64 ? "64" : "32") + " bits] " + m);
    f.Close();
  } catch (e) { }
}
/* USB / network / CD drives are slow and fragile for a big .mdb: work on a local copy in %TEMP% (reused if unchanged) */
function localCopy(path) {
  try {
    var dt = 3;
    try { dt = fso.GetDrive(fso.GetDriveName(path)).DriveType; } catch (e0) { dt = 3; }
    if (dt == 2) return path;                       // fixed local disk: open in place
    var dst = sh.ExpandEnvironmentStrings("%TEMP%") + "\\paie_cache" + path.substring(path.lastIndexOf("."));
    var src = fso.GetFile(path);
    if (fso.FileExists(dst)) {
      var d = fso.GetFile(dst);
      if (d.Size == src.Size && String(d.DateLastModified) == String(src.DateLastModified)) { log("copie locale deja a jour"); return dst; }
    }
    $("status").innerHTML = 'Copie locale de la base (' + Math.round(src.Size / 1048576) + ' Mo)... patientez, ne fermez pas';
    log("copie locale -> " + dst);
    fso.CopyFile(path, dst, true);
    return dst;
  } catch (e) { log("copie locale impossible: " + errText(e)); return path; }
}

/* ---------- location of this file ---------- */
function hostFile() {
  var p = unescape(location.pathname).replace(/\//g, "\\");
  if (p.charAt(0) == "\\" && p.charAt(2) == ":") p = p.substring(1);
  return p;
}
function hostFolder() { var p = hostFile(); return p.substring(0, p.lastIndexOf("\\")); }

/* Bitness handling: Jet is 32-bit only, ACE may be installed as 64-bit only.
   Start 32-bit first; if every provider fails, retry once in 64-bit. Markers in the command line prevent loops. */
var cmdLine = "", proc64 = false, os64 = false;
function detectArch() {
  try { cmdLine = String(HTA.commandLine); } catch (e) { }
  var env = sh.Environment("Process");
  var a = String(env("PROCESSOR_ARCHITECTURE")).toUpperCase();
  var w = String(env("PROCESSOR_ARCHITEW6432")).toUpperCase();
  proc64 = (a == "AMD64" || a == "IA64");
  os64 = proc64 || w == "AMD64";
}
function relaunch(want64, marker) {
  try {
    var root = sh.ExpandEnvironmentStrings("%SystemRoot%");
    var m = want64 ? (proc64 ? root + "\\System32\\mshta.exe" : root + "\\Sysnative\\mshta.exe") : root + "\\SysWOW64\\mshta.exe";
    if (!want64 && !fso.FileExists(m)) return false;
    log("relance en mode " + (want64 ? "64" : "32") + " bits (" + marker + ")");
    sh.Run('"' + m + '" "' + hostFile() + '" ' + marker + (pendingDb ? ' /db "' + pendingDb + '"' : ''), 1, false);
    $("status").innerHTML = 'Redemarrage en mode ' + (want64 ? '64' : '32') + ' bits... une nouvelle fenetre va s\'ouvrir';
    setTimeout(function () { window.close(); }, 1500);
    return true;
  } catch (e) { return false; }
}

/* ---------- connection ---------- */
function openConn(path) {
  var ext = path.substring(path.lastIndexOf(".") + 1).toLowerCase();
  var provs = (ext == "accdb") ? ["Microsoft.ACE.OLEDB.12.0"] : ["Microsoft.Jet.OLEDB.4.0", "Microsoft.ACE.OLEDB.12.0"];
  var modes = ["Mode=Read;", ""];
  var errs = [];
  for (var i = 0; i < provs.length; i++) {
    for (var m = 0; m < modes.length; m++) {
      try {
        var c = new ActiveXObject("ADODB.Connection");
        c.Open("Provider=" + provs[i] + ";Data Source=" + path + ";" + modes[m] + "Jet OLEDB:Database Password=" + PASSWORD + ";");
        return c;
      } catch (e) { errs.push(provs[i] + " " + (modes[m] || "(default mode)") + " -> " + errText(e)); }
    }
  }
  throw new Error(errs.join("\n"));
}

var autoStart = true, pendingDb = "";
function connectTo(path) {
  pendingDb = path;
  $("status").innerHTML = 'Ouverture de la base... (fichier volumineux: patientez, ne fermez pas la fenetre)';
  log("ouverture: " + path);
  setTimeout(function () { doConnect(path); }, 80);     // lets the window paint before the heavy work
}
/* Background copy for slow drives: cmd does the copy while the window stays alive and shows progress */
function prepareDb(path, cb) {
  var dt = 3, src, dst, part, stall = 0, last = -1;
  try { dt = fso.GetDrive(fso.GetDriveName(path)).DriveType; } catch (e0) { dt = 3; }
  if (dt == 2) { cb(path); return; }                // fixed local disk: open in place
  try {
    src = fso.GetFile(path);
    dst = sh.ExpandEnvironmentStrings("%TEMP%") + "\\paie_cache" + path.substring(path.lastIndexOf("."));
    part = dst + ".part";
    if (fso.FileExists(dst)) {
      var d = fso.GetFile(dst);
      if (d.Size == src.Size && String(d.DateLastModified) == String(src.DateLastModified)) { log("copie locale deja a jour"); cb(dst); return; }
      try { fso.DeleteFile(dst, true); } catch (e1) { }
    }
    try { if (fso.FileExists(part)) fso.DeleteFile(part, true); } catch (e2) { }
    log("copie locale (arriere-plan) -> " + dst);
    sh.Run('cmd /c copy /Y /B "' + path + '" "' + part + '" >nul && move /Y "' + part + '" "' + dst + '" >nul', 0, false);
  } catch (e) { log("copie locale impossible: " + errText(e)); cb(path); return; }
  var total = src.Size;
  function tick() {
    try {
      if (fso.FileExists(dst)) {
        if (fso.GetFile(dst).Size == total) { log("copie locale terminee"); cb(dst); return; }
      }
      var cur = fso.FileExists(part) ? fso.GetFile(part).Size : 0;
      stall = (cur == last) ? stall + 1 : 0;
      last = cur;
      if (stall > 60) { log("copie bloquee, ouverture directe"); cb(path); return; }     // ~30 s without progress
      $("status").innerHTML = 'Copie locale de la base: ' + Math.round(cur / 1048576) + ' / ' + Math.round(total / 1048576) + ' Mo ... (la fenetre reste utilisable)';
    } catch (e3) { log("copie: " + errText(e3)); cb(path); return; }
    setTimeout(tick, 500);
  }
  tick();
}
function doConnect(path) {
  prepareDb(path, function (realPath) { finishConnect(path, realPath); });
}
function finishConnect(path, realPath) {
  try {
    if (conn) { try { conn.Close(); } catch (x) { } }
    conn = openConn(realPath);
    log("connexion ok (" + realPath + ")");
    try { sh.RegWrite("HKCU\\Software\\PaieHta\\Bits", proc64 ? "64" : "32", "REG_SZ"); } catch (xr) { }
    dbPath = path;
    cat = new ActiveXObject("ADOX.Catalog");
    cat.ActiveConnection = conn;
    tableNames = [];
    for (var i = 0; i < cat.Tables.Count; i++) {
      var t = cat.Tables.Item(i);
      if (t.Type == "TABLE" || t.Type == "LINK") tableNames.push(t.Name);
    }
    tableNames.sort();
    log("catalogue ok: " + tableNames.length + " tables");
    $("status").innerHTML = '<span class="ok">Connecte</span> &mdash; ' + esc(path) + ' &mdash; chargement des listes...';
    buildTableList();
    buildQueryList();
    log("listes tables/requetes ok");
    $("schemaOut").innerHTML = '<span class="muted">Cliquez sur l\'onglet pour generer.</span>';
    schemaBuilt = false;
    showTab("slip");
    setTimeout(function () {
      try {
        loadLists();
        log("listes mois/corps ok");
        $("status").innerHTML = '<span class="ok">Connecte</span> &mdash; ' + esc(path);
      } catch (e2) {
        log("listes mois/corps: " + errText(e2));
        $("status").innerHTML = '<span class="err">Connecte, mais listes mois/corps illisibles: ' + esc(errText(e2)) + '</span>';
      }
    }, 100);
  } catch (e) {
    conn = null;
    log("echec: " + errText(e));
    if (autoStart && os64 && !proc64 && cmdLine.indexOf("/t64") < 0) {
      if (relaunch(true, "/t32 /t64")) return;       // retry once with the 64-bit engine
    }
    if (errText(e).indexOf("another domain") >= 0 && cmdLine.indexOf("/u") < 0) {
      // file carries the "downloaded from internet" mark: blank it, then restart once
      try { sh.Run('cmd /c type nul > "' + hostFile() + ':Zone.Identifier"', 0, true); } catch (x) { }
      if (relaunch(proc64, (cmdLine.indexOf("/t64") >= 0 ? "/t32 /t64 /u" : "/t32 /u"))) return;
    }
    $("status").innerHTML = '<span class="err">Echec de connexion (processus ' + (proc64 ? "64" : "32") + ' bits' +
      (os64 ? ", Windows 64 bits" : ", Windows 32 bits") + ')</span>';
    $("tg").innerHTML = '<pre>' + esc(errText(e)) + '\n\nFichier: ' + esc(path) + (errText(e).indexOf("another domain") >= 0 ?
      '\n\nSOLUTION: clic droit sur Paie.hta > Proprietes > bouton "Debloquer" (Unblock) > OK, puis relancer.\nSi le dossier est sur un lecteur reseau/amovible, copiez Paie.hta et la base sur C:\\ (ex: C:\\paie) puis debloquez.' : '') + '</pre>';
    showTab("tables");
  }
}

function findDbs(folder) {
  var res = [];
  try {
    var en = new Enumerator(fso.GetFolder(folder).Files);
    for (; !en.atEnd(); en.moveNext()) {
      var f = en.item(); var n = String(f.Name).toLowerCase();
      if (/\.(mdb|accdb)$/.test(n)) res.push(f.Path);
    }
  } catch (e) { }
  return res;
}

function pickFile() { var v = $("fileIn").value; if (v) connectTo(v); }
function switchDb() { var s = $("dbSel"); if (s.value) connectTo(s.value); }

/* ---------- Access -> JSON database export (table-by-table) ---------- */
function jsonSafeFileName(name){
  var src=String(name),out="",i,ch;
  for(i=0;i<src.length;i++){ch=src.charAt(i);if(ch===":"||ch==="*"||ch==="?"||ch==='"'||ch==="<"||ch===">"||ch==="|"||ch.charCodeAt(0)===92||ch.charCodeAt(0)===47)ch="_";out+=ch;}
  return out.replace(/[. ]+$/g,"");
}
function jsonWriteUtf8(path,txt){
  var st=new ActiveXObject("ADODB.Stream");st.Type=2;st.Charset="utf-8";st.Open();
  try{st.WriteText(txt);st.Position=0;st.Type=1;st.Position=3;var out=new ActiveXObject("ADODB.Stream");out.Type=1;out.Open();try{st.CopyTo(out);out.SaveToFile(path,2);}finally{out.Close();}}finally{st.Close();}
}
function jsonValue(v,typ){
  if(v===null||v===undefined)return null;
  if(typ===11)return !!v;
  if(typ===7||typ===133||typ===135){try{var d=new Date(v);if(!isNaN(d.getTime()))return d.getFullYear()+"-"+rpPad(d.getMonth()+1)+"-"+rpPad(d.getDate())+"T"+rpPad(d.getHours())+":"+rpPad(d.getMinutes())+":"+rpPad(d.getSeconds());}catch(x){}return String(v);}
  if(typ===6||typ===14||typ===131||typ===4||typ===5||typ===2||typ===3||typ===16||typ===17||typ===18||typ===19||typ===20||typ===21){var n=Number(v);return isNaN(n)?String(v):n;}
  if(v&&typeof v==="object"&&typeof v.length==="number")return null;
  return String(v);
}
function jsonBrowseFolder(title){var app=new ActiveXObject("Shell.Application"),f=app.BrowseForFolder(0,title,0,0);if(!f)return "";return String(f.Self.Path);}
function jsonSaveStreamUtf8(stream,path){
  stream.Position=0;stream.Type=1;stream.Position=3;
  var bin=new ActiveXObject("ADODB.Stream");bin.Type=1;bin.Open();
  try{stream.CopyTo(bin);bin.SaveToFile(path,2);}finally{bin.Close();stream.Close();}
}
function jsonExportArchiveDetails(c,outDir){
  var rs=new ActiveXObject("ADODB.Recordset"),fields=[],i,idx=-1,row,j,id,lastId=null,stream=null,first=true,files={},count=0,detailRowCount=0,detailDir=fso.BuildPath(outDir,"Archive_Detail"),fileName;
  if(!fso.FolderExists(detailDir))fso.CreateFolder(detailDir);
  rs.CursorLocation=3;rs.Open("SELECT * FROM [Archive_Detail] ORDER BY [Cle_Archive]",c,0,1);
  for(i=0;i<rs.Fields.Count;i++){fields.push({name:String(rs.Fields(i).Name),type:Number(rs.Fields(i).Type)});if(String(rs.Fields(i).Name).toLowerCase()==="cle_archive")idx=i;}
  if(idx<0){rs.Close();throw new Error("Archive_Detail ne contient pas Cle_Archive.");}
  try{
    while(!rs.EOF){
      id=rs.Fields(idx).Value;id=(id===null||id===undefined)?"__NULL__":String(id);
      if(lastId===null||id!==lastId){
        if(stream){stream.WriteText("]");jsonSaveStreamUtf8(stream,fso.BuildPath(detailDir,fileName));}
        count++;fileName="archive_"+("00000000"+count).slice(-8)+".json";
        files[id]="Archive_Detail\\"+fileName;
        stream=new ActiveXObject("ADODB.Stream");stream.Type=2;stream.Charset="utf-8";stream.Open();stream.WriteText("[");first=true;lastId=id;
      }
      row={};for(j=0;j<rs.Fields.Count;j++)row[String(rs.Fields(j).Name)]=jsonValue(rs.Fields(j).Value,Number(rs.Fields(j).Type));
      if(!first)stream.WriteText(",");stream.WriteText(JSON.stringify(row));first=false;detailRowCount++;rs.MoveNext();
    }
    if(stream){stream.WriteText("]");jsonSaveStreamUtf8(stream,fso.BuildPath(detailDir,fileName));stream=null;}
  }finally{if(stream)try{stream.Close();}catch(x){}rs.Close();}
  return {fields:fields,files:files,groups:count,rows:detailRowCount};
}
function jsonConvertOne(dbFile,outRoot){
  var c=null,cat0=null,dbName=fso.GetBaseName(dbFile),outDir=fso.BuildPath(outRoot,jsonSafeFileName(dbName)),tables=[],i,t,rs,fields,j,row,rowsPath,tableFile,rowCount=0,errors=[],detailFiles={};
  if(!fso.FolderExists(outDir))fso.CreateFolder(outDir);
  c=openConn(localCopy(dbFile));cat0=new ActiveXObject("ADOX.Catalog");cat0.ActiveConnection=c;
  try{
    for(i=0;i<cat0.Tables.Count;i++){
      t=cat0.Tables.Item(i);if((t.Type!=="TABLE"&&t.Type!=="LINK")||/^MSys/i.test(String(t.Name)))continue;rs=null;
      try{
        if(String(t.Name).toLowerCase()==="archive_detail"){
          var splitDetails=jsonExportArchiveDetails(c,outDir);detailFiles=splitDetails.files;rowCount+=splitDetails.rows;
          tables.push({name:String(t.Name),splitBy:"Cle_Archive",groups:splitDetails.groups,fields:splitDetails.fields});
          continue;
        }
        rs=new ActiveXObject("ADODB.Recordset");rs.CursorLocation=3;rs.Open("SELECT * FROM ["+String(t.Name).replace(/]/g,"]]")+"]",c,0,1);
        fields=[];for(j=0;j<rs.Fields.Count;j++)fields.push({name:String(rs.Fields(j).Name),type:Number(rs.Fields(j).Type)});
        tableFile="table_"+("0000"+(tables.length+1)).slice(-4)+".json";rowsPath=fso.BuildPath(outDir,tableFile);
        var stream=new ActiveXObject("ADODB.Stream");stream.Type=2;stream.Charset="utf-8";stream.Open();stream.WriteText("[");var first=true;
        while(!rs.EOF){row={};for(j=0;j<rs.Fields.Count;j++)row[String(rs.Fields(j).Name)]=jsonValue(rs.Fields(j).Value,Number(rs.Fields(j).Type));if(!first)stream.WriteText(",");stream.WriteText(JSON.stringify(row));first=false;rowCount++;rs.MoveNext();}
        stream.WriteText("]");stream.Position=0;stream.Type=1;stream.Position=3;var bin=new ActiveXObject("ADODB.Stream");bin.Type=1;bin.Open();
        try{stream.CopyTo(bin);bin.SaveToFile(rowsPath,2);}finally{bin.Close();stream.Close();rs.Close();rs=null;}
        tables.push({name:String(t.Name),file:tableFile,fields:fields});
      }catch(te){errors.push(String(t.Name)+": "+errText(te));try{if(rs)rs.Close();}catch(xc){}}
    }
    var manifest={type:"paie-access-json-db",version:1,name:dbName,source:fso.GetFileName(dbFile),created:new Date().toISOString(),tables:tables,detailFiles:detailFiles};
    jsonWriteUtf8(fso.BuildPath(outDir,"manifest.json"),JSON.stringify(manifest,null,2));
    return {name:dbName,dir:outDir,tables:tables.length,rows:rowCount,errors:errors};
  }finally{try{if(cat0)cat0.ActiveConnection=null;}catch(x1){}try{if(c)c.Close();}catch(x2){}}
}
function jsonConvertFolder(){
  var src=jsonBrowseFolder("Choisissez le dossier contenant les bases Access (.mdb / .accdb)");if(!src)return;
  var dest=jsonBrowseFolder("Choisissez le dossier de destination des fichiers JSON");if(!dest)return;
  var files=findDbs(src),i,res=[],ok=0,fail=0,txt;
  if(!files.length){$("jsonOut").innerHTML='<p class="err">Aucune base .mdb ou .accdb trouvee dans ce dossier.</p>';return;}
  $("jsonOut").innerHTML='<p>Conversion en cours... ne fermez pas l application.</p>';
  for(i=0;i<files.length;i++){try{var r=jsonConvertOne(files[i],dest);res.push(r);ok++;}catch(e){res.push({name:fso.GetFileName(files[i]),error:errText(e)});fail++;}$("jsonOut").innerHTML='<p>Progression: '+(i+1)+' / '+files.length+' bases traitees...</p>';}
  txt='<h3>Conversion terminee</h3><p class="ok">'+ok+' base(s) convertie(s), '+fail+' echec(s).</p><table><tr><th>Base</th><th>Tables</th><th>Lignes</th><th>Dossier / resultat</th></tr>';
  for(i=0;i<res.length;i++)txt+='<tr><td>'+esc(res[i].name)+'</td><td>'+(res[i].tables===undefined?"-":res[i].tables)+'</td><td>'+(res[i].rows===undefined?"-":res[i].rows)+'</td><td>'+(res[i].dir?esc(res[i].dir):'<span class="err">'+esc(res[i].error)+'</span>')+(res[i].errors&&res[i].errors.length?'<br><span class="err">Tables ignorees: '+esc(res[i].errors.join(" | "))+'</span>':'')+'</td></tr>';
  txt+='</table><p class="muted">Chaque base produit un dossier avec manifest.json et un fichier JSON independant par table. Les champs binaires sont exportes comme null.</p>';$("jsonOut").innerHTML=txt;
}

/* ---------- generic paged grid ---------- */
function gridHtml(target, sql, page, clickFn) {
  var rs = new ActiveXObject("ADODB.Recordset");
  rs.CursorLocation = 2;
  rs.Open(sql, conn, 1, 1);
  try {
    if (rs.EOF && rs.BOF) return '<p class="muted">Aucun enregistrement.</p>';
    rs.PageSize = PAGE;
    var pc = rs.PageCount, total = rs.RecordCount;
    if (page < 1) page = 1;
    if (pc > 0 && page > pc) page = pc;
    if (pc > 0) rs.AbsolutePage = page;
    var h = [];
    var nav = '<p class="muted">Page ' + page + (pc > 0 ? ' / ' + pc : '') + (total >= 0 ? ' &mdash; ' + total + ' lignes' : '') + ' &nbsp; ';
    if (page > 1) nav += '<a href="#" onclick="nav(\'' + target + '\',' + (page - 1) + ');return false;">&laquo; precedent</a> ';
    if (pc <= 0 || page < pc) nav += '<a href="#" onclick="nav(\'' + target + '\',' + (page + 1) + ');return false;">suivant &raquo;</a>';
    nav += '</p>';
    h.push(nav);
    h.push('<table><tr>');
    var n = rs.Fields.Count, i;
    for (i = 0; i < n; i++) h.push('<th>' + esc(rs.Fields(i).Name) + '</th>');
    h.push('</tr>');
    var cnt = 0;
    while (!rs.EOF && cnt < PAGE) {
      var key = clickFn ? CellText(rs, 0) : "";
      h.push(clickFn ? '<tr class="click" onclick="' + clickFn + '(\'' + enc(key) + '\')">' : '<tr>');
      for (i = 0; i < n; i++) h.push('<td dir="auto">' + esc(CellText(rs, i)) + '</td>');
      h.push('</tr>');
      rs.MoveNext(); cnt++;
    }
    h.push('</table>');
    return h.join("");
  } finally { rs.Close(); }
}
function showGrid(target, sql, page, clickFn) {
  views[target] = { sql: sql, clickFn: clickFn };
  var html;
  try { html = gridHtml(target, sql, page, clickFn); } catch (e) { html = '<p class="err">' + esc(errText(e)) + '</p>'; }
  $(target).innerHTML = html;
}
function nav(target, p) { var v = views[target]; showGrid(target, v.sql, p, v.clickFn); }

function scalar(sql) {
  var rs = conn.Execute(sql);
  var v = CellText(rs, 0);
  rs.Close();
  return v;
}

/* ---------- tabs ---------- */
function showTab(name) {
  var ids = ["slip", "journal", "rappel", "eng", "json", "tables", "emp", "queries", "schema"];
  for (var i = 0; i < ids.length; i++) {
    $("pane_" + ids[i]).className = "pane" + (ids[i] == name ? " on" : "");
    $("tab_" + ids[i]).className = (ids[i] == name ? "on" : "");
  }
  if (name == "eng") { try { engOnShow(); } catch (xe) { alert("Cartes d'engagement : " + errText(xe)); } }
  if (name == "schema" && !schemaBuilt && conn) {
    $("schemaOut").innerHTML = '<span class="muted">Generation en cours...</span>';
    setTimeout(function () { $("schemaOut").innerHTML = "<pre>" + esc(schemaText()) + "</pre>"; schemaBuilt = true; }, 50);
  }
}
var schemaBuilt = false;

/* ---------- Tables tab ---------- */
function buildTableList() {
  var h = [];
  for (var i = 0; i < tableNames.length; i++)
    h.push('<div onclick="openTable(\'' + enc(tableNames[i]) + '\')">' + esc(tableNames[i]) + '</div>');
  $("tl").innerHTML = h.join("");
  $("tg").innerHTML = '<p class="muted">Choisissez une table.</p>';
}
function openTable(e) {
  var t = decodeURIComponent(e);
  var cols = "";
  try {
    var tb = cat.Tables.Item(t), parts = [];
    for (var j = 0; j < tb.Columns.Count; j++) parts.push(tb.Columns.Item(j).Name + " (" + typeName(tb.Columns.Item(j).Type) + ")");
    cols = '<p class="muted">' + esc(parts.join("  |  ")) + '</p>';
  } catch (x) { }
  $("tg").innerHTML = '<h3>' + esc(t) + ' <span class="muted">(' + esc(scalar("SELECT COUNT(*) FROM [" + t + "]")) + ' lignes)</span></h3>' + cols + '<div id="tgrid"></div>';
  showGrid("tgrid", "SELECT * FROM [" + t + "]", 1, null);
}

/* ---------- Employees tab ---------- */
function searchEmp() {
  if (needDb("empList")) return;
  var q = sq($("q").value.replace(/^\s+|\s+$/g, ""));
  var sql = "SELECT Matricule, Nom, Prenom, Nom_Arab, Prenom_Arab, Code_Grade, Code_Service, Date_Entree, Date_Sortie FROM Dossier";
  if (q) sql += " WHERE Matricule LIKE '%" + q + "%' OR Nom LIKE '%" + q + "%' OR Prenom LIKE '%" + q + "%' OR Nom_Arab LIKE '%" + q + "%' OR Prenom_Arab LIKE '%" + q + "%'";
  sql += " ORDER BY Matricule";
  $("empDetail").innerHTML = "";
  showGrid("empList", sql, 1, "openEmp");
}
function openEmp(e) {
  var m = decodeURIComponent(e);
  var h = ['<h3>Dossier ' + esc(m) + '</h3>'];
  try {
    var rs = conn.Execute("SELECT * FROM Dossier WHERE Matricule='" + sq(m) + "'");
    if (!rs.EOF) {
      h.push('<div class="box"><table>');
      for (var i = 0; i < rs.Fields.Count; i++) {
        var v = CellText(rs, i);
        if (v !== "") h.push('<tr><th>' + esc(rs.Fields(i).Name) + '</th><td dir="auto">' + esc(v) + '</td></tr>');
      }
      h.push('</table></div>');
    }
    rs.Close();
  } catch (x) { h.push('<p class="err">' + esc(errText(x)) + '</p>'); }
  h.push('<h3>Bulletins archives</h3><div id="slipList"></div><div id="slipDetail"></div>');
  $("empDetail").innerHTML = h.join("");
  showGrid("slipList",
    "SELECT a.Cle_Archive, a.Code_Periode_Exercice AS Periode, a.Code_Traitement AS Traitement " +
    "FROM Archive a LEFT JOIN Periode_Exercice pe ON pe.Code = a.Code_Periode_Exercice " +
    "WHERE a.Matricule='" + sq(m) + "' ORDER BY pe.Annee DESC, pe.Code_Periode DESC, a.Code_Traitement", 1, "openSlip");
  $("empDetail").scrollIntoView();
}
function openSlip(e) {
  var k = parseInt(decodeURIComponent(e), 10);
  $("slipDetail").innerHTML = '<h3>Bulletin ' + k + '</h3><div id="slipLines"></div><h4>Totaux par nature</h4><div id="slipTot"></div>';
  showGrid("slipLines",
    "SELECT d.Code_Rubrique AS Rubrique, r.Libelle, r.Libelle_Arab, r.Code_Type AS Type, d.Base, d.Nombre, d.Valeur_Complete, d.Valeur " +
    "FROM Archive_Detail d LEFT JOIN Rubrique r ON d.Code_Rubrique = r.Code WHERE d.Cle_Archive=" + k + " ORDER BY r.Ordre", 1, null);
  showGrid("slipTot",
    "SELECT IIf(r.Code_Type=0,'Gains',IIf(r.Code_Type=1,'Retenues','Intermediaires')) AS Nature, SUM(d.Valeur) AS Total " +
    "FROM Archive_Detail d LEFT JOIN Rubrique r ON d.Code_Rubrique = r.Code WHERE d.Cle_Archive=" + k + " GROUP BY r.Code_Type", 1, null);
}

/* ---------- Queries tab ---------- */
function queryText(coll, i) {
  try { return String(coll.Item(i).Command.CommandText); } catch (e) { return "(illisible: " + errText(e) + ")"; }
}
function buildQueryList() {
  var h = ['<p class="muted">Requetes de selection (Vues) et requetes action (Procedures). Seules les vues peuvent etre executees ici.</p><div id="tl2" style="float:left;width:300px;height:75%;overflow:auto;background:#fff;border:1px solid #cfd6e0">'];
  var i;
  for (i = 0; i < cat.Views.Count; i++) h.push('<div style="padding:3px 8px;cursor:pointer;border-bottom:1px solid #eef1f5" onclick="openQuery(\'v\',' + i + ')">' + esc(cat.Views.Item(i).Name) + '</div>');
  for (i = 0; i < cat.Procedures.Count; i++) h.push('<div style="padding:3px 8px;cursor:pointer;border-bottom:1px solid #eef1f5;color:#a05a00" onclick="openQuery(\'p\',' + i + ')">' + esc(cat.Procedures.Item(i).Name) + ' [action]</div>');
  h.push('</div><div id="qd" style="margin-left:312px"></div>');
  $("queriesOut").innerHTML = h.join("");
}
function openQuery(kind, i) {
  var coll = (kind == "v") ? cat.Views : cat.Procedures;
  var name = coll.Item(i).Name;
  var h = '<h3>' + esc(name) + '</h3>';
  if (kind == "v") h += '<button onclick="runView(\'' + enc(name) + '\')">Executer</button> ';
  h += '<pre>' + esc(queryText(coll, i)) + '</pre><div id="qgrid"></div>';
  $("qd").innerHTML = h;
}
function runView(e) { showGrid("qgrid", "SELECT * FROM [" + decodeURIComponent(e) + "]", 1, null); }

/* ---------- Schema ---------- */
function typeName(n) {
  var m = { 2: "SmallInt", 3: "Long", 4: "Single", 5: "Double", 6: "Currency", 7: "Date/Time", 11: "Yes/No", 17: "Byte",
    72: "GUID", 128: "Binary", 131: "Decimal", 201: "Memo", 202: "Text", 203: "Memo", 204: "Binary", 205: "OLE Object" };
  return m[n] || ("Type" + n);
}
function schemaText() {
  var o = [], i, j, k;
  o.push("DATABASE: " + dbPath);
  o.push("==== TABLES ====");
  var rels = [];
  for (i = 0; i < tableNames.length; i++) {
    var name = tableNames[i];
    try {
      var tb = cat.Tables.Item(name), pk = "|";
      for (j = 0; j < tb.Indexes.Count; j++) {
        var ix = tb.Indexes.Item(j);
        if (ix.PrimaryKey) for (k = 0; k < ix.Columns.Count; k++) pk += ix.Columns.Item(k).Name + "|";
      }
      o.push("");
      o.push("TABLE " + name + "   (lignes: " + scalar("SELECT COUNT(*) FROM [" + name + "]") + ")");
      for (j = 0; j < tb.Columns.Count; j++) {
        var c = tb.Columns.Item(j);
        o.push("   - " + c.Name + " : " + typeName(c.Type) + (c.Type == 202 ? "(" + c.DefinedSize + ")" : "") +
          ((c.Attributes & 2) ? "" : " NOT NULL") + (pk.indexOf("|" + c.Name + "|") >= 0 ? " [PK]" : ""));
      }
      for (j = 0; j < tb.Indexes.Count; j++) {
        var ix2 = tb.Indexes.Item(j), cols = [];
        for (k = 0; k < ix2.Columns.Count; k++) cols.push(ix2.Columns.Item(k).Name);
        o.push("   * INDEX " + ix2.Name + " (" + cols.join(", ") + ")" + (ix2.PrimaryKey ? " PRIMARY" : "") + (ix2.Unique ? " UNIQUE" : ""));
      }
      for (j = 0; j < tb.Keys.Count; j++) {
        var key = tb.Keys.Item(j);
        if (key.Type == 2) {
          var pairs = [];
          for (k = 0; k < key.Columns.Count; k++) pairs.push(name + "." + key.Columns.Item(k).Name + " -> " + key.RelatedTable + "." + key.Columns.Item(k).RelatedColumn);
          rels.push(key.Name + ": " + pairs.join(", ") + (key.DeleteRule == 1 ? " [CASCADE DELETE]" : "") + (key.UpdateRule == 1 ? " [CASCADE UPDATE]" : ""));
        }
      }
    } catch (e) { o.push("   (erreur: " + errText(e) + ")"); }
  }
  o.push(""); o.push("==== RELATIONS ====");
  if (rels.length == 0) o.push("(aucune)");
  for (i = 0; i < rels.length; i++) o.push(rels[i]);
  o.push(""); o.push("==== REQUETES (vues) ====");
  for (i = 0; i < cat.Views.Count; i++) { o.push("-- " + cat.Views.Item(i).Name); o.push(queryText(cat.Views, i)); o.push(""); }
  o.push("==== REQUETES (action / procedures) ====");
  for (i = 0; i < cat.Procedures.Count; i++) { o.push("-- " + cat.Procedures.Item(i).Name); o.push(queryText(cat.Procedures, i)); o.push(""); }
  return o.join("\r\n");
}
function exportSchema() {
  if (!conn) return;
  try {
    var f = hostFolder() + "\\schema_export.txt";
    var ts = fso.CreateTextFile(f, true, true);
    ts.Write(schemaText());
    ts.Close();
    alert("Schema enregistre:\n" + f);
  } catch (e) { alert("Erreur: " + errText(e)); }
}

/* ===================== Raw data, in-memory grids, Excel 2003 export ===================== */
var SEP = String.fromCharCode(1);
function trim(s) { return String(s).replace(/^\s+|\s+$/g, ""); }
function lc(s) { return trim(s).toLowerCase(); }
function rt(c) { return c.charAt(0); }
function rv(c) { return c.substring(1); }
function rnum(c) { return (c.charAt(0) == "N") ? parseFloat(c.substring(1)) : 0; }
function r2(x) { return Math.round(x * 100) / 100; }


