var curR = null, rpEmployees = [], rpStage = "initialisation";
function rpPad(n) { return (n < 10 ? "0" : "") + n; }
function rpCatKey(cat, sec) {
  var c = trim(cat), s = trim(sec), m;
  if (/^\d+$/.test(c)) return String(parseInt(c, 10));
  if (/hc|hors|h\.c/i.test(c)) { m = /(\d+)/.exec(c) || /(\d+)/.exec(s); if (m) return "HC" + parseInt(m[1], 10); }
  m = /(\d+)/.exec(c); if (m && !/hc|hors/i.test(c)) return String(parseInt(m[1], 10));
  return "";
}
function rpEchNum(t) { var m = /(\d+)/.exec(String(t)); return m ? parseInt(m[1], 10) : 0; }
function rpIdx(G, key, ech) {
  var g = G[key], e = ech, p = 0;
  if (!g) return null;
  if (e > 12) e = 12;
  if (e > 0) p = g[1][e - 1];
  return { min: g[0], pts: p, total: g[0] + p };
}
function rpParseDate(s) {
  s = trim(s); var m = /^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})$/.exec(s);
  if (m) return { d: parseInt(m[1],10), m: parseInt(m[2],10), y: parseInt(m[3],10) };
  m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
  if (m) return { y: parseInt(m[1],10), m: parseInt(m[2],10), d: parseInt(m[3],10) };
  return null;
}
function rpParsePer(c) {
  c = trim(c); var m = /^(\d{1,2})\/(\d{4})$/.exec(c);
  if (m) return { m: parseInt(m[1],10), y: parseInt(m[2],10) };
  m = /^(\d{4})\/(\d{1,2})$/.exec(c);
  if (m) return { m: parseInt(m[2],10), y: parseInt(m[1],10) };
  return null;
}
function rpFail(msg) { curR = null; $("rpOut").innerHTML = '<p class="err">' + esc(msg) + '</p>'; }
function rpFilterWhere() {
  var matTxt = trim($("rpMats").value), mats = matTxt ? matTxt.split(/[\s,;]+/) : [], i, q=[];
  if (mats.length) { for(i=0;i<mats.length;i++) q.push("'"+sq(mats[i])+"'"); return "dos.Matricule IN ("+q.join(",")+")"; }
  if ($("rpCorps").value) return "g.Code_Corps='"+sq($("rpCorps").value)+"'";
  return "1=1";
}
function rpLoadEmployees() {
  if (needDb("rpOut")) return;
  try {
    var where = rpFilterWhere();
    var q = qr("SELECT dos.Matricule, dos.Nom, dos.Prenom, cl.Categorie_Classe, cl.Section_Classe, ie.Echelon, ie.IEP, g.Code_Corps, c.Libelle, dos.Nom_Arab, dos.Prenom_Arab " +
      "FROM (((Dossier dos LEFT JOIN Grade g ON g.Code = dos.Code_Grade) LEFT JOIN Corps c ON c.Code = g.Code_Corps) LEFT JOIN Classe cl ON cl.Cle = g.Cle_Classe) LEFT JOIN IEP ie ON ie.Cle = dos.Cle_IEP " +
      "WHERE " + where + " ORDER BY dos.Nom, dos.Prenom, dos.Matricule");
    rpEmployees = [];
    var i,r, html = '<p><b>Choisissez les agents et parametrez chaque rappel individuellement.</b> Les dates de fin sont inclusives jusqu’au mois indique.</p>' +
      '<p><button type="button" onclick="rpSetSelection(true)">' + T("Tout selectionner") + '</button> ' +
      '<button type="button" onclick="rpSetSelection(false)">' + T("Tout deselectionner") + '</button> ' +
      '<span id="rpSelectionCount" class="muted"></span></p>' +
      '<div class="box" style="margin:8px 0;background:#f7f9fc"><b>تطبيق موحّد للتواريخ / Application groupée des dates</b><br>' +
      'تاريخ البداية / Date effet: <input id="rpBulkDate" size="10" value="'+esc(trim($("rpDefaultDate").value))+'" placeholder="jj/mm/aaaa"> &nbsp; ' +
      'تاريخ النهاية / Fin: <input id="rpBulkEnd" size="8" value="'+esc(trim($("rpUntil").value))+'" placeholder="MM/AAAA"> &nbsp; ' +
      'تاريخ النفاذ الثاني / Date effet 2: <input id="rpBulkDate2" size="10" placeholder="jj/mm/aaaa"> &nbsp; ' +
      '<button type="button" onclick="rpBulkApplyDates(\'all\')">تطبيق على كامل القائمة</button> ' +
      '<button type="button" onclick="rpBulkApplyDates(\'selected\')">تطبيق على المحددين فقط</button>' +
      '<div class="muted">اترك الحقل فارغاً للحفاظ على قيمته الحالية. Les champs vides ne modifient pas les dates existantes.</div></div>' +
      '<div style="max-height:340px;overflow:auto"><table><tr><th>' + T("Inclure") + '</th><th>' + T("Matricule") + '</th><th>' + T("Nom et prenom") + '</th><th>' + T("Cat.") + '</th><th>' + T("Ancien ech.") + '</th><th>' + T("Nouvel ech.") + '</th><th>' + T("Date effet") + '</th><th>' + T("Fin (MM/AAAA)") + '</th><th>Ech. 2</th><th>Date effet 2</th><th>Bulletin ref.</th></tr>';
    var defDate = trim($("rpDefaultDate").value), defEnd = trim($("rpUntil").value);
    /* archived (normal) payslip periods of the loaded agents: per-agent choice + global choice */
    var perByMat = {}, perAll = {}, loaded = {}, pq, pr, pper, plab, pser, pk;
    for(i=0;i<q.rows.length;i++) loaded["k"+lc(rv(q.rows[i][0]))] = true;
    function addRefPeriod(mv,pv,isRaw){
      if(mv===null||mv===undefined||pv===null||pv===undefined)return;
      if(isRaw){mv=String(mv);pv=String(pv);}else{mv=rv(mv);pv=rv(pv);}
      var pk0="k"+lc(mv),pp=rpParsePer(pv),pl0,ps0;
      if(!loaded[pk0]||!pp||pp.m<1||pp.m>12)return;
      pl0=pp.y+"/"+rpPad(pp.m);ps0=pp.y*12+pp.m;
      if(!perByMat[pk0])perByMat[pk0]={};
      perByMat[pk0][pl0]=ps0;perAll[pl0]=ps0;
    }
    try {
      pq = qr("SELECT a.Matricule, a.Code_Periode_Exercice FROM Archive a WHERE CStr(a.Code_Traitement)='0'");
      for(i=0;i<pq.rows.length;i++){pr=pq.rows[i];addRefPeriod(pr[0],pr[1],false);}
    } catch(eP) {}
    /* Include archived periods from the supplemental Access and JSON reference databases too. */
    var refi,refSrc,refArchive,refRow,refRs,refAi;
    for(refi=0;refi<refDbs.length;refi++){
      refSrc=refDbs[refi];
      if(refSrc.kind==="json"){
        refArchive=refSrc.archive;
        for(refAi=0;refAi<refArchive.length;refAi++){
          refRow=refArchive[refAi];
          if(String(rpJsonGet(refRow,"Code_Traitement"))==="0")addRefPeriod(rpJsonGet(refRow,"Matricule"),rpJsonGet(refRow,"Code_Periode_Exercice"),true);
        }
      }else{
        try{
          refRs=refSrc.conn.Execute("SELECT Matricule,Code_Periode_Exercice FROM Archive WHERE CStr(Code_Traitement)='0'");
          while(!refRs.EOF){addRefPeriod(refRs.Fields(0).Value,refRs.Fields(1).Value,true);refRs.MoveNext();}
          refRs.Close();
        }catch(eRefPeriod){}
      }
    }
    var perOptions = function (map, cap) {
      var arr = [], kk, o2 = '';
      for(kk in map) if(map.hasOwnProperty(kk)) arr.push({lab:kk, ser:map[kk]});
      arr.sort(function(a,b){return b.ser-a.ser;});
      for(kk=0;kk<arr.length&&kk<cap;kk++) o2 += '<option value="'+arr[kk].lab+'">'+arr[kk].lab.substring(5)+'/'+arr[kk].lab.substring(0,4)+'</option>';
      return o2;
    };
    var gl = [["", "Dernier bulletin archive (auto)"]], ga = [], gk2;
    for(gk2 in perAll) if(perAll.hasOwnProperty(gk2)) ga.push({lab:gk2, ser:perAll[gk2]});
    ga.sort(function(a,b){return b.ser-a.ser;});
    for(i=0;i<ga.length&&i<120;i++) gl.push([ga[i].lab, ga[i].lab.substring(5)+"/"+ga[i].lab.substring(0,4)]);
    fillSel("rpBaseGlobal", gl);
    for(i=0;i<q.rows.length;i++) {
      r=q.rows[i]; var nameAr=trim(rv(r[9])+" "+rv(r[10])), nameFr=trim(rv(r[1])+" "+rv(r[2]));
      var emp={mat:rv(r[0]), name:nameAr||nameFr, nameAr:nameAr, nameFr:nameFr, cat:rpCatKey(rv(r[3]),rv(r[4])), sec:rv(r[4]), old:rpEchNum(rv(r[5])), iep:rv(r[6]), corpsCode:rv(r[7]), corpsName:rv(r[8])};
      emp.id=i; rpEmployees.push(emp);
      html += '<tr><td><input type="checkbox" id="rps_'+i+'" checked></td><td>'+esc(emp.mat)+'</td><td dir="'+(nameAr?'rtl':'auto')+'" lang="'+(nameAr?'ar':'')+'">'+esc(emp.name)+'</td><td>'+esc(emp.cat||rv(r[3]))+'</td><td>'+emp.old+'</td>'+
        '<td><input id="rpn_'+i+'" size="3" value="'+Math.min(12,emp.old+1)+'"></td>'+
        '<td><input id="rpd_'+i+'" size="10" value="'+esc(defDate)+'"></td>'+
        '<td><input id="rpe_'+i+'" size="8" value="'+esc(defEnd)+'"></td>'+
        '<td><input id="rpn2_'+i+'" size="3" value="" title="2eme echelon (optionnel)"></td>'+
        '<td><input id="rpd2_'+i+'" size="10" value="" placeholder="jj/mm/aaaa" title="date d effet du 2eme echelon"></td>'+
        '<td><select id="rpb_'+i+'"><option value="">(global / auto)</option>'+perOptions(perByMat["k"+lc(emp.mat)]||{}, 60)+'</select></td></tr>';
    }
    html += '</table></div><p class="muted">'+q.rows.length+' agent(s) charges depuis la base. Vous pouvez modifier chaque ligne avant le calcul.</p>';
    rpLastFilter = {corps:$("rpCorps").value, matricules:trim($("rpMats").value)};
    $("rpEmployees").innerHTML = html;
    rpSetSelection(true);
    $("rpOut").innerHTML = '<p class="ok">Liste chargee. Selectionnez les agents puis calculez.</p>';
  } catch(e) { rpFail("Chargement des agents: "+errText(e)); }
}
function rpSetSelection(on) {
  var i,n=0,el;
  for(i=0;i<rpEmployees.length;i++) {
    el=$("rps_"+i);
    if(el){el.checked=!!on;if(el.checked)n++;}
  }
  if($("rpSelectionCount")) $("rpSelectionCount").innerHTML=n+" / "+rpEmployees.length+" agent(s) selectionne(s)";
}
function rpBulkApplyDates(mode) {
  var d=trim($("rpBulkDate").value), e=trim($("rpBulkEnd").value), d2=trim($("rpBulkDate2").value);
  if(!d&&!e&&!d2){alert("Saisissez au moins une date a appliquer.");return;}
  if(mode==="all"&&!confirm("Appliquer les dates saisies a toute la liste des "+rpEmployees.length+" agents ?"))return;
  var i,applied=0,cb;
  for(i=0;i<rpEmployees.length;i++){
    cb=$("rps_"+i);
    if(mode==="selected"&&(!cb||!cb.checked))continue;
    if(d)$("rpd_"+i).value=d;
    if(e)$("rpe_"+i).value=e;
    if(d2)$("rpd2_"+i).value=d2;
    applied++;
  }
  if(d)$("rpDefaultDate").value=d;
  if(e)rpSetSelVal("rpUntil",e);
  $("rpOut").innerHTML='<p class="ok">Dates appliquees a '+applied+' agent(s). Verifiez les lignes puis cliquez sur Calculer le rappel.</p>';
}
function rpGridStart(key) {
  if(key==="2007") return {y:2008,m:1};
  if(key==="2022") return {y:2022,m:3};
  if(key==="2023") return {y:2023,m:1};
  return {y:2024,m:1};
}
function rpGridAt(y,m) {
  var v=y*12+m, d22=rpParseDate($("rpGridDate2022").value), d23=rpParseDate($("rpGridDate2023").value), d24=rpParseDate($("rpGridDate2024").value);
  if(y<2008) return ""; // no pre-2008 historical grid is embedded yet
  var n22=d22?d22.y*12+d22.m:2022*12+3, n23=d23?d23.y*12+d23.m:2023*12+1, n24=d24?d24.y*12+d24.m:2024*12+1;
  if(v>=n24) return "2024";
  if(v>=n23) return "2023";
  if(v>=n22) return "2022";
  return "2007";
}
function rpRun() {
  if (needDb("rpOut")) return;
  rpStage="validation des dates et des echelons";
  $("rpMsg").innerHTML=""; $("rpOut").innerHTML='<span class="muted">Calcul en cours...</span>';
  setTimeout(function(){try{doRappel();}catch(e){rpFail("Erreur pendant : "+rpStage+"\n"+errText(e));}},30);
}
function doRappel() {
  var selected=[],i,j,k,e,r;
  rpStage="validation des dates et des echelons";
  if(!rpEmployees.length){rpFail("Chargez d'abord les agents depuis la base.");return;}
  for(i=0;i<rpEmployees.length;i++) {
    e=rpEmployees[i]; if(!$('rps_'+i).checked) continue;
    var st=rpParseDate($('rpd_'+i).value), en=rpParsePer($('rpe_'+i).value), ne=parseInt($('rpn_'+i).value,10);
    if(!st||st.m<1||st.m>12||st.d<1||st.d>31){rpFail("Date d'effet invalide pour "+e.mat+" (jj/mm/aaaa).");return;}
    if(!en||en.m<1||en.m>12||isNaN(ne)||ne<0||ne>12){rpFail("Nouvel echelon ou mois de fin invalide pour "+e.mat+".");return;}
    var a0=st.y*12+st.m,a1=en.y*12+en.m;
    if(a1<a0){rpFail("La fin du rappel precede le debut pour "+e.mat+".");return;}
    if(a1-a0>239){rpFail("Periode superieure a 20 ans pour "+e.mat+". Verifiez les dates.");return;}
    if(st.d>new Date(st.y,st.m,0).getDate()){rpFail("Jour invalide dans la date d'effet pour "+e.mat+".");return;}
    e.start=st;e.end=en;e.newEch=ne;e.startN=a0;e.endN=a1;
    e.startDate=new Date(st.y,st.m-1,st.d);e.endDate=new Date(en.y,en.m,0);
    /* optional 2nd echelon: starts at its own date; the 1st echelon stops the day before (no overlap, no double count) */
    e.ne2=null;e.startDate2=null;
    var ne2s=trim($('rpn2_'+i)?$('rpn2_'+i).value:""),d2s=trim($('rpd2_'+i)?$('rpd2_'+i).value:"");
    if(ne2s!==""||d2s!==""){
      var ne2=parseInt(ne2s,10),st2=rpParseDate(d2s);
      if(isNaN(ne2)||ne2<0||ne2>12||!st2||st2.m<1||st2.m>12||st2.d<1||st2.d>31){rpFail("2eme echelon ou sa date d'effet invalide pour "+e.mat+" (les deux champs sont requis).");return;}
      var sd2=new Date(st2.y,st2.m-1,st2.d);
      if(sd2.getTime()<=e.startDate.getTime()){rpFail("La date du 2eme echelon doit etre posterieure a celle du 1er pour "+e.mat+".");return;}
      if(sd2.getTime()>e.endDate.getTime()){rpFail("La date du 2eme echelon depasse la fin du rappel pour "+e.mat+".");return;}
      if(ne2===ne){rpFail("Le 2eme echelon est identique au 1er pour "+e.mat+".");return;}
      e.ne2=ne2;e.startDate2=sd2;
    }
    e.basePref=trim($('rpb_'+i)?$('rpb_'+i).value:"");
    selected.push(e);
  }
  if(!selected.length){rpFail("Aucun agent selectionne.");return;}

  /* The latest actual archived payslip is used ONCE as each employee's salary
     baseline. Historical months are not read or replayed. Each grid-period
     recall is calculated from this baseline and the applicable index ratio. */
  rpStage="preparation des matricules selectionnes";
  var mats=[];for(i=0;i<selected.length;i++)mats.push("'"+sq(selected[i].mat)+"'");
  rpStage="recherche des bulletins de reference (Archive)";
  /* Recherche dans la base principale et toutes les bases Access/JSON supplementaires. */
  var refConns=[{kind:"access",conn:conn}],candByMat={},rdi,rci,matSet={};
  for(i=0;i<selected.length;i++)matSet["k"+lc(selected[i].mat)]=true;
  for(rdi=0;rdi<refDbs.length;rdi++)refConns.push(refDbs[rdi]);
  for(rci=0;rci<refConns.length;rci++){
    var source=refConns[rci],hrs;
    if(source.kind==="json"){
      var ar=source.archive,ai,cmat0,aid0,per0,code0;
      for(ai=0;ai<ar.length;ai++){
        cmat0=rpJsonGet(ar[ai],"Matricule");aid0=rpJsonGet(ar[ai],"Cle_Archive");
        per0=rpJsonGet(ar[ai],"Code_Periode_Exercice");code0=rpJsonGet(ar[ai],"Code_Traitement");
        if(cmat0===null||aid0===null||per0===null||String(code0)!=="0"||!matSet["k"+lc(cmat0)])continue;
        var cpj=rpParsePer(String(per0));
        if(cpj&&cpj.m>=1&&cpj.m<=12){
          var mkj="k"+lc(cmat0),csj=cpj.y*12+cpj.m;
          if(!candByMat[mkj])candByMat[mkj]=[];
          candByMat[mkj].push({serial:csj,gk:rpGridAt(cpj.y,cpj.m),aid:String(aid0),period:cpj.y+"/"+rpPad(cpj.m),dbi:rci});
        }
      }
    }else{
      try{hrs=source.conn.Execute("SELECT Matricule,Cle_Archive,Code_Periode_Exercice FROM Archive WHERE CStr(Code_Traitement)='0' AND CStr(Matricule) IN ("+mats.join(",")+")");}
      catch(exC){continue;}
      while(!hrs.EOF){
        if(hrs.Fields(0).Value!==null&&hrs.Fields(1).Value!==null&&hrs.Fields(2).Value!==null){
          var cmat=String(hrs.Fields(0).Value),cper=rpParsePer(String(hrs.Fields(2).Value));
          if(cper&&cper.m>=1&&cper.m<=12){
            var mkc="k"+lc(cmat),cser=cper.y*12+cper.m;
            if(!candByMat[mkc])candByMat[mkc]=[];
            candByMat[mkc].push({serial:cser,gk:rpGridAt(cper.y,cper.m),aid:String(hrs.Fields(1).Value),period:cper.y+"/"+rpPad(cper.m),dbi:rci});
          }
        }
        hrs.MoveNext();
      }
      hrs.Close();
    }
  }
  rpStage="analyse des bulletins trouves";
  var chosen={},perMap={},prefWarn=[],prefGlobal=trim($('rpBaseGlobal')?$('rpBaseGlobal').value:""),mk0,li,ci,entry,oldEntry;
  for(mk0 in candByMat)if(candByMat.hasOwnProperty(mk0)){
    var list0=candByMat[mk0];
    for(li=0;li<list0.length;li++){
      ci=list0[li];entry={serial:ci.serial,aid:ci.aid,period:ci.period,cle:ci.aid,dbi:ci.dbi};
      if(!perMap[mk0])perMap[mk0]={};
      oldEntry=perMap[mk0][ci.period];
      if(!oldEntry||ci.dbi<oldEntry.dbi||(ci.dbi===oldEntry.dbi&&Number(ci.aid)>Number(oldEntry.aid)))perMap[mk0][ci.period]=entry;
      oldEntry=chosen[mk0];
      if(!oldEntry||ci.serial>oldEntry.serial||(ci.serial===oldEntry.serial&&(ci.dbi<oldEntry.dbi||(ci.dbi===oldEntry.dbi&&Number(ci.aid)>Number(oldEntry.aid)))))chosen[mk0]=entry;
    }
  }
  for(i=0;i<selected.length;i++){
    var mk1="k"+lc(selected[i].mat),pref=selected[i].basePref||prefGlobal;
    if(pref){
      if(perMap[mk1]&&perMap[mk1][pref])chosen[mk1]=perMap[mk1][pref];
      else prefWarn.push(selected[i].mat+" "+selected[i].name+": bulletin "+pref.substring(5)+"/"+pref.substring(0,4)+" introuvable, dernier bulletin utilise.");
    }
  }
  var hasReference=false,baseVals={},seen={},baseValCache={};
  for(i=0;i<selected.length;i++){
    var empKey="k"+lc(selected[i].mat),baseMeta0=chosen[empKey],baseMap={};
    if(!baseMeta0)continue;
    hasReference=true;
    var refSource=refConns[baseMeta0.dbi],cacheKey=baseMeta0.dbi+":"+baseMeta0.aid;
    if(baseValCache[cacheKey])baseMap=baseValCache[cacheKey];
    else try{
      if(refSource.kind==="json"){
        var detailPath=refSource.manifest.detailFiles?refSource.manifest.detailFiles[String(baseMeta0.aid)]:null;
        if(!detailPath)throw new Error("Archive_Detail absent pour le bulletin "+baseMeta0.aid);
        var detailRows=rpJsonReadFile(fso.BuildPath(fso.GetParentFolderName(refSource.manifest.__path),detailPath)),di0,codeRub0,valRub0;
        for(di0=0;di0<detailRows.length;di0++){
          codeRub0=rpJsonGet(detailRows[di0],"Code_Rubrique");valRub0=rpJsonGet(detailRows[di0],"Valeur");
          if(valRub0!==null&&!isNaN(parseFloat(String(valRub0)))){var rk0="k"+lc(String(codeRub0));baseMap[rk0]=(baseMap[rk0]||0)+parseFloat(String(valRub0));}
        }
      }else{
        var rsBase=refSource.conn.Execute("SELECT Code_Rubrique,Valeur FROM Archive_Detail WHERE CStr(Cle_Archive)='"+sq(baseMeta0.aid)+"'");
        while(!rsBase.EOF){
          var vb=rsBase.Fields(1).Value;
          if(vb!==null&&!isNaN(parseFloat(String(vb)))){var rb="k"+lc(String(rsBase.Fields(0).Value));baseMap[rb]=(baseMap[rb]||0)+parseFloat(String(vb));}
          rsBase.MoveNext();
        }
        rsBase.Close();
      }
      baseValCache[cacheKey]=baseMap;
    }catch(exBase){prefWarn.push("Lecture du bulletin de reference "+baseMeta0.aid+" impossible ("+errText(exBase)+").");}
    baseVals[empKey]=baseMap;
    for(var seenKey in baseMap)if(baseMap.hasOwnProperty(seenKey))seen[seenKey]=true;
  }
  if(!hasReference){rpFail("Aucun bulletin archive exploitable pour les agents selectionnes : impossible de definir le salaire reel de reference.");return;}
  rpStage="lecture du catalogue des rubriques";
  /* Only rubriques actually used by the corps of the selected agents are kept. */
  rpStage="lecture des rubriques propres au corps";
  var corpsSeen={},corpsList=[];
  for(i=0;i<selected.length;i++){var cc=selected[i].corpsCode;if(cc&&!corpsSeen["k"+cc]){corpsSeen["k"+cc]=true;corpsList.push("'"+sq(cc)+"'");}}
  if(!corpsList.length){rpFail("Corps introuvable pour les agents selectionnes.");return;}
  var corpRub=qr("SELECT DISTINCT d.Code_Rubrique FROM ((Archive_Detail d INNER JOIN Archive a ON a.Cle_Archive=d.Cle_Archive) INNER JOIN Dossier dos ON dos.Matricule=a.Matricule) INNER JOIN Grade g ON g.Code=dos.Code_Grade WHERE a.Code_Traitement=0 AND g.Code_Corps IN ("+corpsList.join(",")+")");
  var corpRubSet={};
  for(i=0;i<corpRub.rows.length;i++)corpRubSet["k"+lc(rv(corpRub.rows[i][0]))]=true;
  if(!corpRub.rows.length){rpFail("Aucune rubrique archivee trouvee pour le(s) corps selectionne(s).");return;}
  rpStage="lecture du catalogue des rubriques";
  var meta;try{meta=qr("SELECT Code,Libelle,Code_Type,Ordre,Code_Mode_Calcul,Code_Automatique,Code_Bareme,Base,Nombre_Taux,Imposable,Cotisable,Libelle_Arab FROM Rubrique ORDER BY Ordre");}catch(eAr){meta=qr("SELECT Code,Libelle,Code_Type,Ordre,Code_Mode_Calcul,Code_Automatique,Code_Bareme,Base,Nombre_Taux,Imposable,Cotisable FROM Rubrique ORDER BY Ordre");}
  var exclTxt=trim($('rpExcl').value),exclList=exclTxt?exclTxt.split(/[ ,;]+/):[],excl={},forceFixed={},forceCalc={};
  for(i=0;i<exclList.length;i++)excl["k"+lc(exclList[i])]=true;
  var fxTxt=trim($('rpFixed').value),fxList=fxTxt?fxTxt.split(/[ ,;]+/):[],clTxt=trim($('rpCalc').value),clList=clTxt?clTxt.split(/[ ,;]+/):[];
  for(i=0;i<fxList.length;i++)forceFixed["k"+lc(fxList[i])]=true;
  for(i=0;i<clList.length;i++)forceCalc["k"+lc(clList[i])]=true;
  rpStage="classement des rubriques du bulletin de reference";
  rpStage="preparation du journal de rappel";
  var gains=[],rets=[],ints=[],known={};
  for(i=0;i<meta.rows.length;i++) {
    var code=rv(meta.rows[i][0]),key0="k"+lc(code),lib=rv(meta.rows[i][1])||code,ty=parseFloat(rv(meta.rows[i][2]));
    var lr=leadRank({code:code,lib:lib});
    known[key0]=true;if(excl[key0]||(!corpRubSet[key0]&&lr<0)||isAlwaysOut(code,lib))continue;
    var it={key:key0,code:code,lib:lib,mode:rv(meta.rows[i][4]),automatic:rv(meta.rows[i][5]),bareme:rv(meta.rows[i][6]),base:rv(meta.rows[i][7]),taux:rv(meta.rows[i][8]),imposable:(rv(meta.rows[i][9])==="Oui"),cotisable:(rv(meta.rows[i][10])==="Oui"),arab:(meta.rows[i].length>11?trim(rv(meta.rows[i][11])):"")};
    it.calculated=isCalculatedRubrique(it);
    if(isAFRubrique(it))it.calculated=false;               // allocations familiales / M.I.F.R. / salaire unique: fixed amounts
    if(isContagieuxRubrique(it))it.calculated=false;      // I.Cont is always fixed
    if(forceFixed[key0])it.calculated=false;
    if(forceCalc[key0]&&!isContagieuxRubrique(it))it.calculated=true;
    if(ty===0||lr>=0)gains.push(it);else if(ty===1)rets.push(it);else ints.push(it);
  }
  var gLead=[],gRest=[];
  for(i=0;i<gains.length;i++){if(leadRank(gains[i])>=0)gLead.push(gains[i]);else gRest.push(gains[i]);}
  gLead.sort(function(a,b){return leadRank(a)-leadRank(b);});
  gains=gLead.concat(gRest);
  for(k in seen)if(seen.hasOwnProperty(k)&&!known[k]&&!excl[k]&&corpRubSet[k])ints.push({key:k,code:k.substring(1),lib:k.substring(1),calculated:false});
  var useInt=$('rpInt').checked,rubs=gains.concat(rets);if(useInt)rubs=rubs.concat(ints);var nG=gains.length,nR=rets.length;
  function isContagieuxRubrique(it) {
    var code=String(it.code||it.key||"").toLowerCase().replace(/[\s.]+/g,"");
    var lib=String(it.lib||"").toLowerCase();
    return code.indexOf("icont")>=0||/contagieux/.test(lib);
  }
  /* Calculated = driven by a formula / calculation mode / scale in the Rubrique catalogue (scaled by the index ratio).
     Anything else is a fixed amount and stays unchanged. Can be overridden with the "forcer" boxes. */
  function isCalculatedRubrique(it) {
    var txt=trim(String(it.base||"")+" "+String(it.taux||"")),hasFormula=(txt!==""&&txt!=="0");
    return (parseInt(it.mode,10)>0)||(parseInt(it.bareme,10)>0)||hasFormula;
  }
  function nrm(t) { return String(t||"").toLowerCase().replace(/[\u00e9\u00e8\u00ea\u00eb]/g,"e").replace(/[\u00e0\u00e2\u00e4]/g,"a").replace(/['\u2019`]/g,"").replace(/[\s._\-\/]+/g,""); }
  /* every corps starts with Salaire de Base, Indemnite d'Experience, I.P.Sup (shown even when absent from the corps: 0) */
  function leadRank(it) { var l=nrm(it.lib); if(/^salairedebase$/.test(l))return 0; if(/^indemnitedexperience/.test(l))return 1; if(/^ipsup$/.test(l))return 2; return -1; }
  /* RET.O.S and Retenue Absence are removed from the journal altogether */
  function isAlwaysOut(code,lib) { var c=nrm(code),l=nrm(lib); return c==="retos"||l==="retos"||/retenueabsence/.test(l); }
  /* Allocation familiale, M.I.F.R., Salaire unique: fixed amounts shown as ONE column "Total A.F" */
  function isAFRubrique(it) { var c=nrm(it.code),l=nrm(it.lib); return /allocationfamil/.test(l)||/^mifr/.test(l)||c==="mifr"||/salaireunique/.test(l); }
  function isIrgRubrique(it) { var c=nrm(it.code),l=nrm(it.lib); return /impotsurlerevenu/.test(l)||c==="irg"||/^irg/.test(l); }
  /* IRG base = taxable gains excluding I.ZONE, IND.LOG and family-allowance rubriques, minus social-security contribution. */
  function isZoneOrLog(it) { var l=nrm(it.lib),c=nrm(it.code); return /^izone/.test(l)||/^izone/.test(c)||/^indlog/.test(l)||/^indlog/.test(c)||/^indemnitelogement/.test(l); }
  function isHousingRubrique(it) { var l=nrm(it.lib),c=nrm(it.code); return /^indlog/.test(l)||/^indlog/.test(c)||/^indemnitelogement/.test(l)||/^indemnitelogement/.test(c)||/^logement/.test(l)||/^logement/.test(c); }
  function isCotSocRubrique(it) { return /cotisationsoci/.test(nrm(it.lib)); }
  /* IRG 2022: faithful JScript port of CalculerIRG2022 (VBA).
     Taxable gross is truncated to the lower 10 DA; progressive brackets,
     40% relief (minimum 1,000 DA, maximum 1,500 DA), the 30k-35k
     proportional correction, zero floor and 2-decimal VBA-style rounding. */
  function irgRoundVba2(value) {
    var scaled=value*100, lower=Math.floor(scaled), fraction=scaled-lower;
    if(fraction>0.500000001) lower++;
    else if(Math.abs(fraction-0.5)<=0.00000001 && (lower%2)!==0) lower++;
    return lower/100;
  }
  function calculerIRG2022(brutImposable) {
    var mo=Math.floor(Number(brutImposable)/10)*10;
    var irgBrut,abat,irg;
    if(mo<=20000)return 0;
    if(mo<=40000)irgBrut=(mo-20000)*0.23;
    else if(mo<=80000)irgBrut=4600+(mo-40000)*0.27;
    else if(mo<=160000)irgBrut=15400+(mo-80000)*0.30;
    else if(mo<=320000)irgBrut=39400+(mo-160000)*0.33;
    else irgBrut=92200+(mo-320000)*0.35;
    abat=irgBrut*0.40;
    if(abat<1000)abat=1000;
    if(abat>1500)abat=1500;
    irg=irgBrut-abat;
    if(mo>30000 && mo<=35000)irg=irg*((mo-30000)/5000);
    if(irg<0)irg=0;
    return irgRoundVba2(irg);
  }
  function isAdminsCorps(emp) {
    var n=String(emp.corpsName||"").toLowerCase();
    return /admin/.test(n);
  }
  if(!rubs.length){rpFail("Aucune rubrique salariale exploitable dans les derniers bulletins archives.");return;}

  /* All I.Cont rubriques (Sec2, Sec1/3, Sec3/3) are merged into ONE column:
     the cell shows their sum, i.e. the employee's actual contagieux amount. */
  var contIdx=[],dispMap=[],contInserted=false,afIdx=[],afInserted=false,irgIdx=-1,cotIdx=-1,anyImp=false;
  for(i=0;i<rubs.length;i++){
    if(i<nG&&rubs[i].imposable)anyImp=true;
    if(irgIdx<0&&isIrgRubrique(rubs[i]))irgIdx=i;
    if(cotIdx<0&&isCotSocRubrique(rubs[i]))cotIdx=i;
  }
  for(i=0;i<rubs.length;i++){
    if(isContagieuxRubrique(rubs[i])){
      contIdx.push(i);
      if(!contInserted){dispMap.push({type:"cont"});contInserted=true;}
    } else if(isAFRubrique(rubs[i])&&i<nG){
      afIdx.push(i);
      if(!afInserted){dispMap.push({type:"af"});afInserted=true;}
    } else {
      dispMap.push({type:"rub",idx:i});
    }
  }
  var rubKinds=[];
  for(i=0;i<rubs.length;i++)rubKinds.push(i>=nG?"ret":(leadRank(rubs[i])>=0?"lead":(isAFRubrique(rubs[i])?"af":"gain")));
  var cols=["Matricule","Nom et prenom","Nature","Grille","Periode couverte","Jours rappel (base 30j)","Bulletin salaire de reference"];
  for(i=0;i<dispMap.length;i++)cols.push(dispMap[i].type==="cont"?"I.Cont (Sec2 + Sec1/3 + Sec3/3)":(dispMap[i].type==="af"?"Total A.F":rubs[dispMap[i].idx].lib));
  cols.push("TOTAL GAINS HORS A.F","TOTAL GAINS HORS A.F ET LOGEMENT","TOTAL RETENUES","NET RAPPEL");
  function infoRow(mat,nm,label,text,per,basePeriod) {
    var row=["S"+mat,"S"+nm,"S"+label,"S"+text,"S"+per,"E","S"+(basePeriod||"")],jj;
    for(jj=0;jj<dispMap.length+4;jj++)row.push("E");
    row.info=text;return row;
  }
  var PTV=45;   /* official point value (DA) */
  function idxTxt(cat,ech,ix) {
    return "\u0627\u0644\u0635\u0646\u0641 "+cat+" - \u0627\u0644\u062f\u0631\u062c\u0629 "+ech+" : \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0627\u0633\u062a\u062f\u0644\u0627\u0644\u064a \u0627\u0644\u0623\u062f\u0646\u0649 "+ix.min+" + \u0646\u0642\u0627\u0637 \u0627\u0644\u062f\u0631\u062c\u0629 "+ix.pts+" = "+ix.total+"  (\u00d7 "+PTV+" \u062f\u062c = "+fmtNum(r2(ix.total*PTV))+" \u062f\u062c)";
  }
  function lineRow(mat,nm,label,grid,per,days,basePeriod,arr) {
    var row=["S"+mat,"S"+nm,"S"+label,"S"+grid,"S"+per,days===null?"E":"I"+days,"S"+(basePeriod||"")],sg=0,sgNoAF=0,sgNoAFNoHousing=0,sr=0,jj,v,ci;
    for(jj=0;jj<rubs.length;jj++){v=arr[jj]||0;if(jj<nG){sg+=v;if(!isAFRubrique(rubs[jj])){sgNoAF+=v;if(!isHousingRubrique(rubs[jj]))sgNoAFNoHousing+=v;}}else if(jj<nG+nR)sr+=v;}
    for(jj=0;jj<dispMap.length;jj++){
      if(dispMap[jj].type==="cont"){v=0;for(ci=0;ci<contIdx.length;ci++)v+=arr[contIdx[ci]]||0;}
      else if(dispMap[jj].type==="af"){v=0;for(ci=0;ci<afIdx.length;ci++)v+=arr[afIdx[ci]]||0;}
      else v=arr[dispMap[jj].idx]||0;
      row.push("N"+r2(v));
    }
    row.push("N"+r2(sgNoAF));row.push("N"+r2(sgNoAFNoHousing));row.push("N"+r2(sr));row.push("N"+r2(sg-sr));row.raw=arr.slice(0);return row;
  }
  function gridStartDate(gridKey) {
    if(gridKey==="2007")return new Date(2008,0,1);
    var d=rpParseDate($('rpGridDate'+gridKey).value);
    if(!d)d=gridKey==="2022"?{y:2022,m:3,d:1}:(gridKey==="2023"?{y:2023,m:1,d:1}:{y:2024,m:1,d:1});
    return new Date(d.y,d.m-1,d.d);
  }
  function dateFmt(d) {return rpPad(d.getDate())+"/"+rpPad(d.getMonth()+1)+"/"+d.getFullYear();}
  /* accounting calendar: every month has 30 days; the last day of a month (28/29 Feb, 31) counts as day 30 */
  function acctDay(dt) { var ld=new Date(dt.getFullYear(),dt.getMonth()+1,0).getDate(); return (dt.getDate()===ld)?30:Math.min(30,dt.getDate()); }
  function days30(fromD,toD) {
    var total=0,y=fromD.getFullYear(),m=fromD.getMonth(),lastY=toD.getFullYear(),lastM=toD.getMonth();
    while(y<lastY||(y===lastY&&m<=lastM)) {
      var first=(y===fromD.getFullYear()&&m===fromD.getMonth())?acctDay(fromD):1;
      var last=(y===lastY&&m===lastM)?acctDay(toD):30;
      var whole=(first===1&&last===30);
      var count=whole?30:(last-first+1);if(count>0)total+=count;
      m++;if(m>11){m=0;y++;}
    }
    return total;
  }
  rpStage="calcul des periodes et des grilles historiques";
  var gridOrder=["2007","2022","2023","2024"],gridStarts=[];
  for(i=0;i<gridOrder.length;i++)gridStarts.push(gridStartDate(gridOrder[i]));
  for(i=1;i<gridStarts.length;i++)if(gridStarts[i].getTime()<=gridStarts[i-1].getTime()){rpFail("Les dates d’application des grilles doivent etre strictement croissantes.");return;}
  rpStage="calcul des rappels par agent et par periode";
  var rows=[],recap=[],warns=prefWarn.slice(0),gsum=[],empTotals=[];for(j=0;j<rubs.length;j++)gsum.push(0);
  /* ---- bulletins de reference multi-bases : un bulletin ne sert que pour les
     periodes de SA propre grille (un bulletin 2022 ne corrige pas une periode 2023) ---- */
  function rpReadBaseVals(aid,dbi){
    var ck=dbi+":"+aid;if(baseValCache[ck])return baseValCache[ck];
    var m={};
    try{
      var source=refConns[dbi];
      if(source.kind==="json"){
        var detailFile=source.manifest.detailFiles?source.manifest.detailFiles[String(aid)]:null;
        if(!detailFile)throw new Error("Archive_Detail absent pour le bulletin "+aid);
        var ds=rpJsonReadFile(fso.BuildPath(fso.GetParentFolderName(source.manifest.__path),detailFile)),di,dc,dv;
        for(di=0;di<ds.length;di++){
          dc=rpJsonGet(ds[di],"Code_Rubrique");dv=rpJsonGet(ds[di],"Valeur");
          if(dv!==null&&!isNaN(parseFloat(String(dv)))){var kj="k"+lc(String(dc));m[kj]=(m[kj]||0)+parseFloat(String(dv));}
        }
      }else{
        var rs2=source.conn.Execute("SELECT Code_Rubrique,Valeur FROM Archive_Detail WHERE CStr(Cle_Archive)='"+sq(aid)+"'");
        while(!rs2.EOF){
          var v2=rs2.Fields(1).Value;
          if(v2!==null&&!isNaN(parseFloat(String(v2)))){var k2="k"+lc(String(rs2.Fields(0).Value));m[k2]=(m[k2]||0)+parseFloat(String(v2));}
          rs2.MoveNext();
        }
        rs2.Close();
      }
    }catch(exD){warns.push("Lecture du bulletin "+aid+" impossible ("+errText(exD)+").");}
    baseValCache[ck]=m;return m;
  }
  function rpChooseRef(mat,gk,pEnd){
    var list=candByMat["k"+lc(mat)];
    if(!list||!list.length)return null;
    var serEnd=pEnd.getFullYear()*12+pEnd.getMonth()+1,best=null,q2;
    for(q2=0;q2<list.length;q2++){var c=list[q2];if(c.gk!==gk||c.serial>serEnd)continue;if(!best||c.serial>best.serial)best=c;}
    if(best)return best;
    for(q2=0;q2<list.length;q2++){var c2=list[q2];if(c2.serial>serEnd)continue;if(!best||c2.serial>best.serial)best=c2;}
    if(best)warns.push(mat+": aucun bulletin de la grille "+gk+" avant "+dateFmt(pEnd)+"; bulletin "+best.period+" utilise a la place.");
    return best;
  }
  for(i=0;i<selected.length;i++) {
    e=selected[i];var key=e.cat,oe=e.old,ne=e.newEch,base=baseVals["k"+lc(e.mat)]||{},baseMeta=chosen["k"+lc(e.mat)],tot=[];
    for(j=0;j<rubs.length;j++)tot.push(0);
    if(!key||!GRIDS["2007"][key]){warns.push(e.mat+" "+e.name+": categorie absente des grilles historiques ("+key+").");continue;}
    if(ne===oe){warns.push(e.mat+" "+e.name+": echelon inchange, ignore.");continue;}
    if(!baseMeta&&!candByMat["k"+lc(e.mat)]){warns.push(e.mat+" "+e.name+": aucun bulletin de reference trouve (toutes bases confondues); rappel non calcule.");continue;}
    /* I.Cont (indemnite de contagieux): fixed allowance, never indexed by the
       echelon ratio (old = new, recall = 0). The applicable category is read
       from THIS employee's own reference bulletin: only the contagieux rubric
       actually present there is paid, the other categories stay at 0.
       Amount = statutory 2,500 DA for Admin corps, otherwise the employee's
       own archived amount. */
    var contKeys=[],cq,ck,cav;
    for(cq=0;cq<rubs.length;cq++)if(isContagieuxRubrique(rubs[cq]))contKeys.push(rubs[cq].key);
    var contPayKey=null,contActual=0,contSeen=0;
    for(ck=0;ck<contKeys.length;ck++){cav=r2(base[contKeys[ck]]||0);if(cav!==0){contSeen++;if(!contPayKey){contPayKey=contKeys[ck];contActual=cav;}}}
    if(contSeen>1)warns.push(e.mat+" "+e.name+": "+contSeen+" rubriques I.Cont presentes dans le bulletin de reference; seule la 1re est retenue.");
    var contAmount=contPayKey?(isAdminsCorps(e)?2500:contActual):0;
    var employeeRows=0,gridsUsed=[],segs=[],sgi,neFirst=ne;
    if(e.ne2!==null){
      segs.push({s:e.startDate,t:new Date(e.startDate2.getFullYear(),e.startDate2.getMonth(),e.startDate2.getDate()-1),n:neFirst});
      segs.push({s:e.startDate2,t:e.endDate,n:e.ne2});
    } else segs.push({s:e.startDate,t:e.endDate,n:neFirst});
    for(sgi=0;sgi<segs.length;sgi++)
    for(j=0;j<gridOrder.length;j++) {
      ne=segs[sgi].n;
      var pStart=new Date(Math.max(segs[sgi].s.getTime(),gridStarts[j].getTime()));
      var pEnd=new Date(segs[sgi].t.getTime());
      if(j<gridOrder.length-1) {var nextStart=gridStarts[j+1];var dayBefore=new Date(nextStart.getFullYear(),nextStart.getMonth(),nextStart.getDate()-1);if(dayBefore.getTime()<pEnd.getTime())pEnd=dayBefore;}
      if(pStart.getTime()>pEnd.getTime())continue;
      var gk=gridOrder[j],G=GRIDS[gk],oldIdx=rpIdx(G,key,oe),newIdx=rpIdx(G,key,ne);
      if(!oldIdx||!newIdx||oldIdx.total===0){warns.push(e.mat+": indice impossible pour "+gk+", categorie "+key+".");continue;}
      /* Salaire de reference de LA MEME grille que la periode : un bulletin d une
         autre grille (2022 pour une periode 2023 par ex.) est ecarte automatiquement. */
      var ref=rpChooseRef(e.mat,gk,pEnd);
      if(!ref){warns.push(e.mat+" "+e.name+": aucun bulletin de reference pour la grille "+gk+" ("+dateFmt(pStart)+" - "+dateFmt(pEnd)+"); periode ignoree.");continue;}
      var baseP=rpReadBaseVals(ref.aid,ref.dbi),refPeriod=ref.period;
      var days=days30(pStart,pEnd),oldSalary=[],newSalary=[],periodRecall=[],periodText=dateFmt(pStart)+" - "+dateFmt(pEnd);
      var ratio=newIdx.total/oldIdx.total;
      /* Regles (la promotion d echelon ne touche QUE l IEP) :
         - Salaire de Base = indice MINIMUM x 45 : INCHANGE, rappel toujours 0 ;
         - IEP = points d echelon x 45 : toute la variation sort d ici ;
         - indemnites calculees = leur POURCENTAGE de (base + IEP), taux lu sur le
           bulletin de reference de la meme grille : nouveau = taux x indice total x 45. */
      var baseMin=r2(oldIdx.min*PTV),iepOld=r2(oldIdx.pts*PTV),iepNew=r2(newIdx.pts*PTV),oldTot=r2(oldIdx.total*PTV),newTot=r2(newIdx.total*PTV);
      for(var q=0;q<rubs.length;q++) {
        var actual=baseP[rubs[q].key]||0,oldAmount,newAmount,amount,lr=leadRank(rubs[q]);
        if(q===irgIdx) {
          oldAmount=0;newAmount=0;amount=0;                       // filled below with the IRG 2022 formula
        } else if(isContagieuxRubrique(rubs[q])) {
          /* Fixed allowance: identical before/after (recall = 0), never scaled
             by the index ratio. Only the category present in the employee's own
             reference bulletin is paid; every other I.Cont category stays 0. */
          var fixedAmount=(rubs[q].key===contPayKey)?contAmount:0;
          oldAmount=r2(fixedAmount);newAmount=r2(fixedAmount);amount=0;
        } else if(lr===0) {
          /* Salaire de Base = indice minimum x 45 : l echelon ne le modifie PAS -> rappel = 0 */
          oldAmount=baseMin;newAmount=baseMin;amount=0;
        } else if(lr===1) {
          /* IEP = points d echelon x 45 : toute la variation vient d ici */
          oldAmount=iepOld;newAmount=iepNew;amount=r2((iepNew-iepOld)*days/30);
        } else if(rubs[q].calculated) {
          /* indemnite = son pourcentage de (base + IEP); taux lu sur le bulletin de
             reference de la MEME grille, montant recalcule sur le nouvel indice total */
          var pct=(oldTot>0)?(actual/oldTot):0;
          oldAmount=r2(actual);newAmount=r2(pct*newTot);amount=r2((newAmount-oldAmount)*days/30);
        } else {
          /* ordinary fixed rubrique: unchanged by the echelon */
          oldAmount=r2(actual);newAmount=r2(actual);amount=0;
        }
        oldSalary.push(oldAmount);newSalary.push(newAmount);periodRecall.push(amount);
        tot[q]+=amount;gsum[q]+=amount;
      }
      if(irgIdx>=0) {
        /* taxable base = imposable gains - cotisation sociale; IRG 2022 normal on the monthly base, for old and new salary */
        var oBase=0,nBase=0,qq,oIrg,nIrg,aIrg;
        for(qq=0;qq<nG;qq++)if(!isZoneOrLog(rubs[qq])&&!isAFRubrique(rubs[qq])){oBase+=oldSalary[qq];nBase+=newSalary[qq];}
        if(cotIdx>=0){oBase-=oldSalary[cotIdx];nBase-=newSalary[cotIdx];}
        oIrg=calculerIRG2022(oBase);nIrg=calculerIRG2022(nBase);aIrg=r2((nIrg-oIrg)*days/30);
        oldSalary[irgIdx]=r2(oIrg);newSalary[irgIdx]=r2(nIrg);periodRecall[irgIdx]=aIrg;
        tot[irgIdx]+=aIrg;gsum[irgIdx]+=aIrg;
      }
      var rOld=lineRow(e.mat,e.name,"ANCIEN SALAIRE",gk,periodText,null,refPeriod,oldSalary);rOld.ixc=["S"+key,"I"+oe,"I"+oldIdx.min,"I"+oldIdx.pts,"I"+oldIdx.total,"E"];rows.push(rOld);
      var rNew=lineRow(e.mat,e.name,"NOUVEAU SALAIRE",gk,periodText,null,refPeriod,newSalary);rNew.ixc=["S"+key,"I"+ne,"I"+newIdx.min,"I"+newIdx.pts,"I"+newIdx.total,"E"];rows.push(rNew);
      var rRap=lineRow(e.mat,e.name,"RAPPEL",gk,periodText,days,refPeriod,periodRecall);rRap.ixc=["E","E","E","E","E","N"+(Math.round(ratio*1000000)/1000000)];rows.push(rRap);
      employeeRows++;gridsUsed.push(gk);
    }
    if(!employeeRows){warns.push(e.mat+" "+e.name+": aucune periode de grille applicable.");continue;}
    empTotals.push({mat:e.mat,name:e.name,tot:tot.slice(0)});
    rows.push(lineRow(e.mat,e.name,"TOTAL EMPLOYE","","TOTAL EMPLOYE",null,baseMeta.period,tot));
    var tg=0,tr=0;for(j=0;j<rubs.length;j++){if(j<nG)tg+=tot[j];else if(j<nG+nR)tr+=tot[j];}
    recap.push(["S"+e.mat,"S"+e.name,"S"+key,"I"+oe,(e.ne2!==null?"S"+neFirst+" / "+e.ne2:"I"+neFirst),"S"+$('rpd_'+e.id).value+(e.ne2!==null?" / "+$('rpd2_'+e.id).value:""),"S"+$('rpe_'+e.id).value,"S"+baseMeta.period,"S"+gridsUsed.join(", "),"N"+r2(tg),"N"+r2(tr),"N"+r2(tg-tr)]);
  }
  if(!rows.length){rpFail("Aucun rappel calcule. Verifiez les bulletins de reference, les categories et les dates.");return;}
  rpStage="construction du journal et du recapitulatif";
  var foot=lineRow("TOTAL GENERAL","","TOTAL GENERAL","","TOTAL GENERAL",null,"",gsum);
  var rcols=["Matricule","Nom Prenom","Cat.","Ech. ancien","Ech. nouveau","Date effet","Fin rappel","Bulletin base","Grilles appliquees","Rappel gains","Rappel retenues","Rappel net"];
  var compactRows=[];
  for(i=0;i<rows.length;i++) {
    var nature=rv(rows[i][2]);
    if(nature==="RAPPEL"||nature==="TOTAL EMPLOYE")compactRows.push(rows[i]);
  }
  curR={empTotals:empTotals,rubKinds:rubKinds,cols:cols,rows:rows,detailRows:rows,compactRows:compactRows,foot:foot,rcols:rcols,recap:recap,rubs:rubs,warns:warns.slice(0),contIdx:contIdx.slice(0),date:"individuelle par agent",until:"individuel par agent"};
    rpRenderOut();
}
function rpToggleClass() { var d=$("rpClass"); if(d) d.style.display=(d.style.display==="none")?"block":"none"; }
function rpSetView() {
  if(!curR)return;
  curR.rows=$("rpShowSalary")&&$("rpShowSalary").checked?curR.detailRows:curR.compactRows;
  memTable("rpDetail",curR.cols,curR.rows,1,100,curR.foot);
}
var RP_E1 = "\u0627\u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0640\u0640\u0629 \u0627\u0644\u062c\u0640\u0632\u0627\u0626\u0640\u0631\u064a\u0640\u0640\u0629 \u0627\u0644\u062f\u064a\u0645\u0642\u0631\u0627\u0637\u064a\u0640\u0640\u0629 \u0627\u0644\u0634\u0639\u0628\u064a\u0640\u0640\u0640\u0640\u0629", RP_E2 = "\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u0635\u062d\u0640\u0629 ";
function rpNrm(t) { return String(t||"").toLowerCase().replace(/[\u00e9\u00e8\u00ea\u00eb]/g,"e").replace(/[\u00e0\u00e2\u00e4]/g,"a").replace(/['\u2019`]/g,"").replace(/[\s._\-\/]+/g,""); }
/* Page layout: employee blocks are never split; every page ends with a TOTAL PAGE row (sum of the employee totals on that page).
   groups: [{rows:[cell rows], tot:[typed total row], h:height}], o: {capH, topH, hdrH, totH, footH, pageTotal(list,no,count), foot} */
function rpPaged(groups, o) {
  var pages = [], cur = [], used = o.topH + o.hdrH, i, k, p, g, need, rows = [], breaks = [];
  for (i = 0; i < groups.length; i++) {
    g = groups[i]; need = g.h + o.totH + ((i === groups.length - 1) ? o.footH : 0);
    if (cur.length && used + need > o.capH) { pages.push(cur); cur = []; used = o.hdrH; }
    cur.push(g); used += g.h;
  }
  if (cur.length) pages.push(cur);
  for (p = 0; p < pages.length; p++) {
    if (p > 0) breaks.push(rows.length);
    for (i = 0; i < pages[p].length; i++) for (k = 0; k < pages[p][i].rows.length; k++) rows.push(pages[p][i].rows[k]);
    rows.push(o.pageTotal(pages[p], p + 1, pages.length));
  }
  if (o.foot) rows.push(o.foot);
  return { rows: rows, breaks: breaks, pages: pages.length };
}
function rpBuildSheets() {
  var RTLX=(LANG==="ar");
  var d=curR,out=[],i,j,k,row,c,bold;if(!d){$("rpMsg").innerHTML='<span class="err">Calculez d’abord le rappel.</span>';return null;}
  var keep=[0,1,2,4,5,-1,-2,-3,-4,-5,-6],IXK=["Categorie","Echelon","Indice min","Points echelon","Indice total","Coefficient"];for(j=7;j<d.cols.length;j++)keep.push(j); // omit Grille and Bulletin de reference from Excel
  var nc=keep.length;
  function hr(h,cells){cells.h=h;return cells;}
  function span(text,style,n,startCol){var cells=[X("S",text,style,null,startCol>1?startCol:undefined)],q;for(q=1;q<n;q++)cells.push(X("E","",style));return cells;}
  function entete(n,rows){
    var b1=Math.min(8,n),b2=Math.min(7,n);
    rows.push(hr(27.75,span(RP_E1,"e1",n,1)));
    rows.push(hr(27.75,span(RP_E2,"e1",n,1)));
    rows.push(hr(23.25,span(ENTETE1,"e2",b1,RTLX?1:n-b1+1)));
    rows.push(hr(23.25,span(ENTETE2,"e2",b2,RTLX?1:n-b2+1)));
  }
  var TOPH=27.75*2+23.25*2+26.25+23.25+15,HDRH=51,ROWH=15,TOTH=18,FOOTH=18,PH=740;
  function scaleFor(w){var t=0,q;for(q=0;q<w.length;q++)t+=w[q];return Math.max(30,Math.min(100,Math.floor(1154/(t*1.15)*100)));}
  /* period covered */
  var mn=null,mx=null,mm,pa,pb;
  for(i=0;i<d.rows.length;i++){
    mm=/^(\d\d)\/(\d\d)\/(\d{4}) - (\d\d)\/(\d\d)\/(\d{4})$/.exec(rv(d.rows[i][4]));
    if(mm){pa=mm[3]+mm[2]+mm[1];pb=mm[6]+mm[5]+mm[4];if(mn===null||pa<mn)mn=pa;if(mx===null||pb>mx)mx=pb;}
  }
  function ymd(v){return v.substr(0,4)+"/"+v.substr(4,2)+"/"+v.substr(6,2);}
  var periodTxt=(mn!==null)?("\u0627\u0644\u0641\u062a\u0631\u0629 \u0645\u0646 "+ymd(mn)+" \u0627\u0644\u0649 "+ymd(mx)):"";
  /* corps of the exported agents */
  var corpsTxt="",mats={},codes=[],seenC={},ee;
  for(i=0;i<d.recap.length;i++)mats["k"+rv(d.recap[i][0])]=true;
  for(i=0;i<rpEmployees.length;i++){ee=rpEmployees[i];if(mats["k"+ee.mat]&&ee.corpsCode&&!seenC["k"+ee.corpsCode]){seenC["k"+ee.corpsCode]=true;codes.push("'"+sq(ee.corpsCode)+"'");}}
  try{
    if(codes.length){
      var cq=qr("SELECT Libelle_Arab, Libelle FROM Corps WHERE Code IN ("+codes.join(",")+")"),names=[];
      for(i=0;i<cq.rows.length;i++){var nm=trim(rv(cq.rows[i][0]))||trim(rv(cq.rows[i][1]));if(nm)names.push(nm);}
      corpsTxt=names.join(" \u0648 ");
    }
  }catch(ec){}
  var yearTxt=" \u0644\u0633\u0646\u0629 "+(new Date()).getFullYear();
  var title=trim($("rpTitle")?$("rpTitle").value:"");
  if(!title)title="\u0628\u064a\u0627\u0646 \u062a\u0643\u0645\u064a\u0644\u064a \u0644\u0644\u062a\u0631\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u062f\u0631\u062c\u0627\u062a \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u0631\u0633\u0645\u064a\u0646"+(corpsTxt?(" "+corpsTxt):"")+yearTxt;
  var titleRend="\u0628\u064a\u0627\u0646 \u062a\u0643\u0645\u064a\u0644\u064a \u0644\u0645\u0646\u062d\u0629 \u0627\u0644\u0645\u0631\u062f\u0648\u062f\u064a\u0629 \u0627\u0644\u0646\u0627\u062c\u0645 \u0639\u0646 \u0627\u0644\u062a\u0631\u0642\u064a\u0629 \u0641\u064a \u0627\u0644\u062f\u0631\u062c\u0627\u062a"+(corpsTxt?(" "+corpsTxt):"")+yearTxt;
  function headBlock(n,ttl,rows,corner,periodOverride){
    entete(n,rows);
    if(corner)rows.push(hr(26.25,span(ttl,"e7",n,1)));
    else if(RTLX)rows.push(hr(26.25,span(ttl,"e3",n,1)));
    else rows.push(hr(26.25,[X("S",ttl,"e3",null,Math.max(1,n-7))]));
    var shownPeriod=(periodOverride!==undefined)?periodOverride:periodTxt;
    if(shownPeriod)rows.push(hr(23.25,span(shownPeriod,"e4",n,1)));else rows.push(hr(23.25,[]));
    if(corner)rows.push(hr(21,RTLX?[X("S",corner,"e6",null,n)]:[X("S",corner,"e6")]));else rows.push(hr(15,[]));
  }
  var arabMap={};
  if(LANG==="ar")for(i=0;i<d.rubs.length;i++)arabMap["k"+d.rubs[i].lib]=d.rubs[i].arab?d.rubs[i].arab:rubArabic(d.rubs[i].code,d.rubs[i].lib,d.rubKinds[i]==="ret");
  function hdrT(l){return arabMap["k"+l]?arabMap["k"+l]:T(l);}
  function sumTot(list,tcol){var s0=0,q;for(q=0;q<list.length;q++){var cc=list[q].tot[tcol];if(cc&&rt(cc)==="N")s0+=parseFloat(rv(cc));}return r2(s0);}

  /* ---------- journal sheet ---------- */
  var w=[58,115,100,112,62];for(j=5;j<nc;j++)w.push(62);
  var groups=[],gRows=[],gTot=null;
  for(i=0;i<d.rows.length;i++){
    bold=(rv(d.rows[i][4])==="TOTAL EMPLOYE");row=[];
    if(d.rows[i].info){for(j=0;j<5;j++)row.push(xr(d.rows[i][keep[j]]));row.push(X("S",d.rows[i].info,"cxa",nc-6));row.h=ROWH;gRows.push(row);continue;}
    for(j=0;j<nc;j++){c=keep[j]>=0?d.rows[i][keep[j]]:((d.rows[i].ixc||[])[-keep[j]-1]||"E");row.push(xr(c,bold?(rt(c)==="N"?"bn":"bf"):(keep[j]===-6&&rt(c)==="N"?"x6":undefined)));}
    row.h=ROWH;gRows.push(row);
    if(bold){groups.push({rows:gRows,tot:d.rows[i],h:gRows.length*ROWH});gRows=[];}
  }
  if(gRows.length)groups.push({rows:gRows,tot:d.rows[d.rows.length-1],h:gRows.length*ROWH});
  var sc1=scaleFor(w);
  function jPageTotal(list,no,cnt){
    var r=[],q,kj;
    for(q=0;q<nc;q++){kj=keep[q];
      if(kj===0)r.push(X("S",T("TOTAL PAGE"),"bf"));
      else if(kj===2)r.push(X("S",no+" / "+cnt,"bf"));
      else if(kj<7)r.push(X("E","","bf"));
      else r.push(X("N",""+sumTot(list,kj),"bn"));
    }
    r.h=TOTH;return r;
  }
  var footRow=[];for(j=0;j<nc;j++)footRow.push(keep[j]<0?X("E","","bf"):xr(d.foot[keep[j]],rt(d.foot[keep[j]])==="N"?"bn":"bf"));footRow.h=FOOTH;
  var pg=rpPaged(groups,{capH:PH/(sc1/100),topH:TOPH,hdrH:HDRH,totH:TOTH,footH:FOOTH,pageTotal:jPageTotal,foot:footRow});
  headBlock(nc,title,out);
  row=[];for(i=0;i<nc;i++)row.push(X("S",keep[i]<0?T(IXK[-keep[i]-1]):hdrT(d.cols[keep[i]]),"h"));row.h=HDRH;out.push(row);
  var headRow=out.length,off=out.length;
  for(i=0;i<pg.rows.length;i++)out.push(pg.rows[i]);
  var br1=[];for(i=0;i<pg.breaks.length;i++)br1.push(off+pg.breaks[i]);

  /* ---------- rendement sheet: brut = rate x note/40 x (Base + IEP); C.S 9%; fixed IRG 10% on (brut - C.S) ---------- */
  var ib=-1,ie=-1;
  for(j=7;j<d.cols.length;j++){var nl=rpNrm(d.cols[j]);if(nl==="salairedebase"&&ib<0)ib=j;if(/^indemnitedexperience/.test(nl)&&ie<0)ie=j;}
  var rateIn=trim($("rpRendRate")?$("rpRendRate").value:"").replace(",","."),noteIn=trim($("rpRendNote")?$("rpRendNote").value:"").replace(",",".");
  var rateFix=(rateIn!==""&&!isNaN(parseFloat(rateIn)))?parseFloat(rateIn):null,note=(noteIn!==""&&!isNaN(parseFloat(noteIn)))?parseFloat(noteIn):40;
  if(note<0)note=0;if(note>40)note=40;
  var corpsOf={};for(i=0;i<rpEmployees.length;i++)corpsOf["k"+rpEmployees[i].mat]=rpEmployees[i].corpsName||"";
  function rateFor(mat){
