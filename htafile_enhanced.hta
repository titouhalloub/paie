  }
  function cellN(v,st){return X("N",""+r2(v),st);}
  var rw=[58,135,100,112,50,95,55,45,55,95,85,85,95],rnc=rw.length,rg=[],curRows=[],acc=[0,0,0,0,0];
  var rcols=["Matricule","Nom et prenom","Nature","Periode couverte","Jours rappel (base 30j)","Salaire principal (Base + IEP)","Taux max %","Note /40","Taux effectif %","Prime de rendement","Retenue C.S 9%","IRG 10%","Net a payer"];
  function pv(r){var s1=0;if(ib>=0)s1+=parseFloat(rv(r[ib]))||0;if(ie>=0)s1+=parseFloat(rv(r[ie]))||0;return s1;}
  function amounts(brut){var cs=r2(brut*0.09),irg=r2((brut-cs)*0.10);return {cs:cs,irg:irg,net:r2(brut-cs-irg)};}
  function rendTot(l1,l2,v,st){
    var r=[X("S",l1,"bf"),X("E","","bf"),X("S",l2,"bf"),X("E","","bf"),X("E","","bf"),cellN(v[0],"bn"),X("E","","bf"),X("E","","bf"),X("E","","bf"),cellN(v[1],"bn"),cellN(v[2],"bn"),cellN(v[3],"bn"),cellN(v[4],"bn")];
    r.h=ROWH;return r;
  }
  for(i=0;i<d.detailRows.length;i++){
    var dr=d.detailRows[i],nat=rv(dr[2]),mat=rv(dr[0]),eff=rateFor(mat)*note/40;
    if(nat==="TOTAL EMPLOYE"){
      row=rendTot(rv(dr[0]),T("TOTAL EMPLOYE"),acc);
      row[1]=X("S",rv(dr[1]),"bf");curRows.push(row);
      var tr=[];tr[5]="N"+r2(acc[0]);tr[9]="N"+r2(acc[1]);tr[10]="N"+r2(acc[2]);tr[11]="N"+r2(acc[3]);tr[12]="N"+r2(acc[4]);
      rg.push({rows:curRows,tot:tr,h:curRows.length*ROWH});curRows=[];acc=[0,0,0,0,0];continue;
    }
    if(nat!=="ANCIEN SALAIRE"&&nat!=="NOUVEAU SALAIRE"&&nat!=="RAPPEL")continue;
    var princ=pv(dr),prime=r2(princ*eff/100),am=amounts(prime);
    if(nat==="RAPPEL"){acc[0]+=princ;acc[1]+=prime;acc[2]+=am.cs;acc[3]+=am.irg;acc[4]+=am.net;}
    row=[xr(dr[0]),xr(dr[1]),xr(dr[2]),xr(dr[4]),xr(dr[5]),cellN(princ,"n"),cellN(rateFor(mat),"n"),cellN(note,"n"),cellN(eff,"n"),cellN(prime,"n"),cellN(am.cs,"n"),cellN(am.irg,"n"),cellN(am.net,"n")];
    row.h=ROWH;curRows.push(row);
  }
  function rtot(list,col){var s0=0,q;for(q=0;q<list.length;q++){var cc=list[q].tot[col];if(cc)s0+=parseFloat(rv(cc));}return r2(s0);}
  function rSums(list){return [rtot(list,5),rtot(list,9),rtot(list,10),rtot(list,11),rtot(list,12)];}
  function rPageTotal(list,no,cnt){var r=rendTot(T("TOTAL PAGE"),no+" / "+cnt,rSums(list));r.h=TOTH;return r;}
  var rfoot=rendTot(T("TOTAL GENERAL"),T("TOTAL GENERAL"),rSums(rg));rfoot.h=FOOTH;
  var sc2=scaleFor(rw),pr=rpPaged(rg,{capH:PH/(sc2/100),topH:TOPH,hdrH:HDRH,totH:TOTH,footH:FOOTH,pageTotal:rPageTotal,foot:rfoot});
  var rout=[];headBlock(rnc,titleRend,rout);
  row=[];for(i=0;i<rnc;i++)row.push(X("S",T(rcols[i]),"h"));row.h=HDRH;rout.push(row);
  var rHead=rout.length,roff=rout.length;
  for(i=0;i<pr.rows.length;i++)rout.push(pr.rows[i]);
  var br2=[];for(i=0;i<pr.breaks.length;i++)br2.push(roff+pr.breaks[i]);

  /* ---------- recap sheet ---------- */
  var rkeep=[0,1,2,3,4,5,6,9,10,11],r2s=[];
  entete(rkeep.length,r2s);
  r2s.push(hr(21,[X("S",T("Recapitulatif par agent"),"e5")]));r2s.push(hr(10,[]));
  row=[];for(i=0;i<rkeep.length;i++)row.push(X("S",T(d.rcols[rkeep[i]]),"h"));row.h=30;r2s.push(row);
  var rcHead=r2s.length;
  for(i=0;i<d.recap.length;i++){row=[];for(j=0;j<rkeep.length;j++)row.push(xr(d.recap[i][rkeep[j]]));r2s.push(row);}
  /* file name from the contents */
  var fcodes=[],fseen={};
  for(i=0;i<rpEmployees.length;i++){ee=rpEmployees[i];if(mats["k"+ee.mat]&&ee.corpsCode&&!fseen["k"+ee.corpsCode]){fseen["k"+ee.corpsCode]=true;fcodes.push(ee.corpsCode);}}
  var fbase="Rappel_echelon_"+(fcodes.length?fcodes.join("-"):"corps")+(mn!==null?("_"+mn+"-"+mx):"")+"_"+d.recap.length+"agents";
  var recapW=[58,115,42,48,48,68,62,78,78,78];
  /* ---------- feuilles 2 a 5 (financial control): per agent, rappel amounts by family of rubriques ---------- */
  var etMap={};for(i=0;i<(d.empTotals||[]).length;i++)etMap["k"+d.empTotals[i].mat]=d.empTotals[i];
  function isContR(it){var c=rpNrm(it.code),l=String(it.lib||"").toLowerCase();return c.indexOf("icont")>=0||/contagieux/.test(l);}
  function defsFor(kind,mergeCont){
    var o2=[],contDef=null,q;
    for(q=0;q<d.rubs.length;q++){
      if(d.rubKinds[q]!==kind)continue;
      if(mergeCont&&isContR(d.rubs[q])){if(!contDef){contDef={label:"I.Cont (Sec2 + Sec1/3 + Sec3/3)",idx:[]};o2.push(contDef);}contDef.idx.push(q);}
      else o2.push({label:d.rubs[q].lib,idx:[q]});
    }
    return o2;
  }
  function defVals(defs,mat){
    var et=etMap["k"+mat],v=[],q,z,t0;
    for(q=0;q<defs.length;q++){t0=0;if(et)for(z=0;z<defs[q].idx.length;z++)t0+=et.tot[defs[q].idx[z]]||0;v.push(r2(t0));}
    return v;
  }
  /* feuilles 2-5: same rows as the journal (ANCIEN / NOUVEAU / RAPPEL per period + TOTAL EMPLOYE), restricted to one family of rubriques */
  var srcRows=(d.detailRows&&d.detailRows.length)?d.detailRows:(d.rows||[]);
  var currentYear=(new Date()).getFullYear(),previousYear=currentYear-1;
  function annualDays30(a,b){
    function ad(x){var last=new Date(x.getFullYear(),x.getMonth()+1,0).getDate();return x.getDate()===last?30:Math.min(30,x.getDate());}
    var total=0,y=a.getFullYear(),m=a.getMonth(),ly=b.getFullYear(),lm=b.getMonth();
    while(y<ly||(y===ly&&m<=lm)){var first=(y===a.getFullYear()&&m===a.getMonth())?ad(a):1,last=(y===ly&&m===lm)?ad(b):30;total+=Math.max(0,last-first+1);m++;if(m>11){m=0;y++;}}
    return total;
  }
  function annualRows(year,fromRappelStart){
    var out=[],totals=[],i,j,group=[],totalTemplate=null;
    function annualDateFmt(d){return rpPad(d.getDate())+"/"+rpPad(d.getMonth()+1)+"/"+d.getFullYear();}
    function parseRange(row){
      var m=/^(\d{2})\/(\d{2})\/(\d{4}) - (\d{2})\/(\d{2})\/(\d{4})$/.exec(rv(row[4]));
      if(!m)return null;
      return {a:new Date(+m[3],+m[2]-1,+m[1]),b:new Date(+m[6],+m[5]-1,+m[4])};
    }
    function closeEmp(){
      var rappelStart=null,mat="",sumRaw=[],sumDisp=[],has=false,rows=[],k,src,kind,rg,a,b,originalDays,partDays,factor,cp,jj,tr;
      for(k=0;k<group.length;k++){
        src=group[k];if(rv(src[2])!=="RAPPEL")continue;
        rg=parseRange(src);if(rg&&(!rappelStart||rg.a<rappelStart))rappelStart=rg.a;
      }
      if(fromRappelStart&&!rappelStart){group=[];totalTemplate=null;return;}
      var periodStart=fromRappelStart?rappelStart:new Date(year,0,1);
      var periodEnd=new Date(year,11,31);
      for(k=0;k<group.length;k++){
        src=group[k];kind=rv(src[2]);
        if(kind!=="ANCIEN SALAIRE"&&kind!=="NOUVEAU SALAIRE"&&kind!=="RAPPEL")continue;
        rg=parseRange(src);if(!rg)continue;
        a=rg.a>periodStart?rg.a:periodStart;b=rg.b<periodEnd?rg.b:periodEnd;
        if(a>b)continue;
        originalDays=annualDays30(rg.a,rg.b);partDays=annualDays30(a,b);factor=originalDays>0?partDays/originalDays:0;
        cp=src.slice(0);cp.raw=(src.raw||[]).slice(0);
        cp[4]=annualDateFmt(a)+" - "+annualDateFmt(b);cp[5]="I"+partDays;cp.ixc=(src.ixc||[]).slice(0);
        if(kind==="RAPPEL"){
          for(jj=0;jj<cp.raw.length;jj++)cp.raw[jj]=r2(cp.raw[jj]*factor);
          for(jj=7;jj<cp.length;jj++)if(rt(cp[jj])==="N")cp[jj]="N"+r2((parseFloat(rv(cp[jj]))||0)*factor);
          if(!has){mat=rv(src[0]);for(jj=0;jj<cp.raw.length;jj++)sumRaw[jj]=0;for(jj=7;jj<cp.length;jj++)sumDisp[jj]=0;has=true;}
          for(jj=0;jj<cp.raw.length;jj++)sumRaw[jj]=r2((sumRaw[jj]||0)+cp.raw[jj]);
          for(jj=7;jj<cp.length;jj++)sumDisp[jj]=r2((sumDisp[jj]||0)+(parseFloat(rv(cp[jj]))||0));
        }
        rows.push(cp);
      }
      if(has&&totalTemplate){
        tr=totalTemplate.slice(0);tr.raw=sumRaw.slice(0);tr.ixc=(group.length&&group[0].ixc)?group[0].ixc.slice(0):[];
        for(jj=7;jj<tr.length;jj++)tr[jj]="N"+r2(sumDisp[jj]||0);
        rows.push(tr);totals.push({mat:mat,name:rv(tr[1]),tot:sumRaw.slice(0)});
        for(k=0;k<rows.length;k++)out.push(rows[k]);
      }
      group=[];totalTemplate=null;
    }
    for(i=0;i<srcRows.length;i++){
      var src=srcRows[i],kind=rv(src[2]);
      if(src.info)continue;
      if(kind==="TOTAL EMPLOYE"){totalTemplate=src;closeEmp();continue;}
      if(kind==="ANCIEN SALAIRE"||kind==="NOUVEAU SALAIRE"||kind==="RAPPEL")group.push(src);
    }
    closeEmp();
    return {rows:out,empTotals:totals};
  }
  function annualPeriod(year,fromRappelStart){return fromRappelStart?"الفترة من تاريخ بداية الاستدراك الفعلي لكل موظف إلى 31/12/"+year:"الفترة من 01/01/"+year+" إلى 31/12/"+year;}
  function famSheet(sheetName,corner,defs,source,periodLabel){
    var useRows=source?source.rows:srcRows;
    var n=11+defs.length+1,ww=[58,115,100,112,62,62,62,62,62,62,62],q,z,gl=[],cur=[],sums=[],t0,v,rw0,cells,tt;
    for(q=0;q<defs.length;q++)ww.push(88);ww.push(95);
    for(q=0;q<defs.length+1;q++)sums.push(0);
    function vals(raw){var vs=[],q2,z2,s;for(q2=0;q2<defs.length;q2++){s=0;for(z2=0;z2<defs[q2].idx.length;z2++)s+=(raw[defs[q2].idx[z2]]||0);vs.push(r2(s));}return vs;}
    for(i=0;i<useRows.length;i++){
      rw0=useRows[i];
      if(rw0.info){cells=[];for(q=0;q<5;q++)cells.push(xr(rw0[[0,1,2,4,5][q]]));cells.push(X("S",rw0.info,"cxa",defs.length));cells.h=ROWH;cur.push(cells);continue;}
      var isTot=(rv(rw0[4])==="TOTAL EMPLOYE"),vs=vals(rw0.raw||[]),tot0=0;
      for(q=0;q<vs.length;q++)tot0+=vs[q];tot0=r2(tot0);
      cells=[];
      var cidx=[0,1,2,4,5];
      for(q=0;q<5;q++)cells.push(xr(rw0[cidx[q]],isTot?"bf":undefined));
      for(q=0;q<6;q++){var xc=(rw0.ixc||[])[q]||"E";cells.push(xr(xc,isTot?"bf":(q===5&&rt(xc)==="N"?"x6":undefined)));}
      for(q=0;q<vs.length;q++)cells.push(cellN(vs[q],isTot?"bn":"n"));
      cells.push(cellN(tot0,"bn"));cells.h=ROWH;cur.push(cells);
      if(isTot){
        tt=[];for(q=0;q<vs.length;q++){tt[11+q]="N"+vs[q];sums[q]+=vs[q];}tt[11+vs.length]="N"+tot0;sums[vs.length]+=tot0;
        gl.push({rows:cur,tot:tt,h:cur.length*ROWH});cur=[];
      }
    }
    if(cur.length)gl.push({rows:cur,tot:[],h:cur.length*ROWH});
    function sumRow(l1,l2,vs3){var r=[X("S",l1,"bf"),X("E","","bf"),X("S",l2,"bf"),X("E","","bf"),X("E","","bf"),X("E","","bf"),X("E","","bf"),X("E","","bf"),X("E","","bf"),X("E","","bf"),X("E","","bf")],z3;for(z3=0;z3<vs3.length;z3++)r.push(cellN(vs3[z3],"bn"));r.h=ROWH;return r;}
    function pageSums(list){var vs4=[],z4,y,s0;for(z4=0;z4<defs.length+1;z4++){s0=0;for(y=0;y<list.length;y++){var c0=list[y].tot[11+z4];if(c0)s0+=parseFloat(rv(c0));}vs4.push(r2(s0));}return vs4;}
    var tg=[];for(z=0;z<sums.length;z++)tg.push(r2(sums[z]));
    var fr=sumRow(T("TOTAL GENERAL"),T("TOTAL GENERAL"),tg);fr.h=FOOTH;
    var sc=scaleFor(ww),pgx=rpPaged(gl,{capH:PH/(sc/100),topH:TOPH,hdrH:HDRH,totH:TOTH,footH:FOOTH,
        pageTotal:function(list,no,cnt){var r=sumRow(T("TOTAL PAGE"),no+" / "+cnt,pageSums(list));r.h=TOTH;return r;},foot:fr});
    var o4=[];headBlock(n,title,o4,corner,periodLabel);
    var row2=[X("S",T("Matricule"),"h"),X("S",T("Nom et prenom"),"h"),X("S",T("Nature"),"h"),X("S",T("Periode couverte"),"h"),X("S",T("Jours rappel (base 30j)"),"h"),X("S",T("Categorie"),"h"),X("S",T("Echelon"),"h"),X("S",T("Indice min"),"h"),X("S",T("Points echelon"),"h"),X("S",T("Indice total"),"h"),X("S",T("Coefficient"),"h")];
    for(q=0;q<defs.length;q++)row2.push(X("S",hdrT(defs[q].label),"h"));row2.push(X("S",T("Total"),"h"));row2.h=HDRH;o4.push(row2);
    var hr2=o4.length,off2=o4.length,bk=[];
    for(q=0;q<pgx.rows.length;q++)o4.push(pgx.rows[q]);
    for(q=0;q<pgx.breaks.length;q++)bk.push(off2+pgx.breaks[q]);
    return {rtl:true,name:T(sheetName),w:ww,rows:o4,land:true,top:"0.35",footer:true,printRow:hr2,plan:{scale:sc,breaks:bk}};
  }
  var d2=defsFor("lead",false),d3=defsFor("gain",true),d4=defsFor("af",false);
  function allIdx(defs){var o5=[],q,z;for(q=0;q<defs.length;q++)for(z=0;z<defs[q].idx.length;z++)o5.push(defs[q].idx[z]);return o5;}
  function paperNo(nn){return "\u0627\u0644\u0648\u0631\u0642\u0629 \u0631\u0642\u0645 "+nn;}
  var prevData=annualRows(previousYear,true),currData=annualRows(currentYear,false);
  var allDefs=[{label:"Total F2",idx:allIdx(d2)},{label:"Total F3",idx:allIdx(d3)},{label:"Total F4",idx:allIdx(d4)}];
  var s2=famSheet("Feuille 2",paperNo(2),d2,prevData,annualPeriod(previousYear,true));
  var s3=famSheet("Feuille 3",paperNo(3),d3,prevData,annualPeriod(previousYear,true));
  var s4=famSheet("Feuille 4",paperNo(4),d4,prevData,annualPeriod(previousYear,true));
  var s5=famSheet("Feuille 5",paperNo(5),allDefs,prevData,annualPeriod(previousYear,true));
  /* Feuille 6 = full كشف الاستدراك for the current year, with every salary rubrique. */
  function annualJournalSheet(source,year){
    var p6keep=[0,1,2,4,5,-4,-3,-2,-1],p6w=[58,115,100,112,62,82,82,58,58],p6nc,q,z,rr,bb,sc,pgj,jbreaks=[],ki,tv,jcur=[],jgroups=[],jtot={};
    for(z=7;z<d.cols.length;z++){p6keep.push(z);p6w.push(62);}
    p6nc=p6keep.length;
    for(q=0;q<source.rows.length;q++){
      rr=source.rows[q];bb=(rv(rr[4])==="TOTAL EMPLOYE");var cells=[];
      for(z=0;z<p6nc;z++){
        var pk=p6keep[z],original=pk>=0?rr[pk]:((rr.ixc||[])[-pk-1]||"E");
        cells.push(xr(original,bb?(rt(original)==="N"?"bn":"bf"):undefined));
      }
      cells.h=ROWH;jcur.push(cells);
      if(bb){jgroups.push({rows:jcur,tot:rr,h:jcur.length*ROWH});jcur=[];}
    }
    if(jcur.length)jgroups.push({rows:jcur,tot:jcur[jcur.length-1],h:jcur.length*ROWH});
    for(z=0;z<p6nc;z++){
      ki=p6keep[z];var sv=0;
      if(ki>=7){for(q=0;q<jgroups.length;q++){tv=jgroups[q].tot[ki];if(tv&&rt(tv)==="N")sv+=parseFloat(rv(tv))||0;}jtot[ki]="N"+r2(sv);}
      else jtot[ki]=ki<0?"E":(d.foot[ki]||"E");
    }
    function annualPageTotal(list,no,cnt){
      var ar=[],q2,k2;
      for(q2=0;q2<p6nc;q2++){k2=p6keep[q2];
        if(k2===0)ar.push(X("S",T("TOTAL PAGE"),"bf"));
        else if(k2===2)ar.push(X("S",no+" / "+cnt,"bf"));
        else if(k2<7)ar.push(X("E","","bf"));
        else ar.push(X("N",""+sumTot(list,k2),"bn"));
      }
      ar.h=TOTH;return ar;
    }
    var annualFoot=[];
    for(z=0;z<p6nc;z++){ki=p6keep[z];annualFoot.push(ki<0?X("E","","bf"):xr(jtot[ki]||"E",rt(jtot[ki]||"E")==="N"?"bn":"bf"));}
    annualFoot.h=FOOTH;sc=scaleFor(p6w);
    pgj=rpPaged(jgroups,{capH:PH/(sc/100),topH:TOPH,hdrH:HDRH,totH:TOTH,footH:FOOTH,pageTotal:annualPageTotal,foot:annualFoot});
    var jo=[];headBlock(p6nc,title,jo,null,annualPeriod(year,false));
    var p6Labels=["الصنف","الدرجة","الرقم الاستدلالي للصنف","الرقم الاستدلالي للدرجة"];
    var jh=[];for(z=0;z<p6nc;z++){ki=p6keep[z];jh.push(X("S",ki<0?p6Labels[-ki-1]:hdrT(d.cols[ki]),"h"));}jh.h=HDRH;jo.push(jh);
    var jhead=jo.length,joff=jo.length;
    for(q=0;q<pgj.rows.length;q++)jo.push(pgj.rows[q]);
    for(q=0;q<pgj.breaks.length;q++)jbreaks.push(joff+pgj.breaks[q]);
    return {rtl:true,name:T("Feuille 6"),w:p6w,rows:jo,land:true,top:"0.35",footer:true,printRow:jhead,plan:{scale:sc,breaks:jbreaks}};
  }
  var s6=annualJournalSheet(currData,currentYear);
  var sheets=[{rtl:true,name:T("Journal rappel"),w:w,rows:out,land:true,top:"0.35",footer:true,printRow:headRow,plan:{scale:sc1,breaks:br1}},
              s2,s3,s4,s5,s6,
              {rtl:true,name:T("Rendement"),w:rw,rows:rout,land:true,top:"0.35",footer:true,printRow:rHead,plan:{scale:sc2,breaks:br2}},
              {rtl:true,name:T("Recap agents"),w:recapW,rows:r2s,land:true,top:"0.35",footer:true,printRow:rcHead,plan:{scale:scaleFor(recapW),breaks:[]}}];
  return {sheets:sheets,fbase:fbase,info:"A3: journal "+pg.pages+" page(s) (echelle "+sc1+"%), rendement "+pr.pages+" page(s). Chaque page se termine par son TOTAL PAGE; aucun agent n’est coupe entre deux pages."};
}
function rpReadLayoutSettings(){
  var f=parseFloat(trim($("rpFontSize")?$("rpFontSize").value:"10").replace(",",".")),
      l=parseFloat(trim($("rpLineSpacing")?$("rpLineSpacing").value:"1").replace(",",".")),
      c=parseFloat(trim($("rpColSpacing")?$("rpColSpacing").value:"1").replace(",","."));
  if(isNaN(f)||f<6||f>18)f=10;
  if(isNaN(l)||l<0.5||l>2)l=1;
  if(isNaN(c)||c<0.5||c>2)c=1;
  RP_FONT_SIZE=f;
  return {font:f,line:l,col:c};
}
function rpApplyLayoutSettings(sheets){
  var v=rpReadLayoutSettings(),factor=Math.max(v.font/10,v.col),i,j,sh,row;
  for(i=0;i<sheets.length;i++){
    sh=sheets[i];
    for(j=0;j<sh.w.length;j++)sh.w[j]=r2(sh.w[j]*v.col);
    for(j=0;j<sh.rows.length;j++){row=sh.rows[j];if(row.h)row.h=r2(row.h*v.line);}
    if(sh.plan)sh.plan.scale=Math.max(20,Math.min(100,Math.round(sh.plan.scale/factor)));
  }
}
function rpExport() {
  var oldLang=LANG;LANG="ar";
  try{
    var b=rpBuildSheets();if(!b)return;
    rpApplyLayoutSettings(b.sheets);
    var si,fi,fr;
    for(si=0;si<b.sheets.length;si++){
      b.sheets[si].rows.push([]);
      fr=rpSignoffRows(b.sheets[si].w.length);
      for(fi=0;fi<fr.length;fi++)b.sheets[si].rows.push(fr[fi]);
    }
    exportXls(b.sheets,b.fbase,"rpMsg");
    $("rpMsg").innerHTML+='<br><span class="muted">'+b.info+'</span>';
  }finally{LANG=oldLang;}
}
/* ===================== Bases de reference supplementaires ===================== */
var refDbs=[],refDbPaths=[];
function rpJsonReadFile(path){
  var st=new ActiveXObject("ADODB.Stream"),txt;st.Type=2;st.Charset="utf-8";st.Open();
  try{st.LoadFromFile(path);txt=st.ReadText();}finally{st.Close();}
  return JSON.parse(String(txt).replace(/^\uFEFF/,""));
}
function rpJsonTable(manifest,tableName){
  var i,t;
  for(i=0;i<manifest.tables.length;i++){t=manifest.tables[i];if(String(t.name).toLowerCase()===String(tableName).toLowerCase())return rpJsonReadFile(fso.BuildPath(fso.GetParentFolderName(manifest.__path),t.file));}
  throw new Error("Table "+tableName+" absente du manifeste JSON.");
}
function rpJsonGet(row,name){
  var k;if(row[name]!==undefined)return row[name];
  for(k in row)if(row.hasOwnProperty(k)&&String(k).toLowerCase()===String(name).toLowerCase())return row[k];
  return null;
}
function rpAddRefDbPath(v){
  var ext=String(v).substring(String(v).lastIndexOf(".")+1).toLowerCase(),item,p,c,m;
  if(ext==="json"){
    m=rpJsonReadFile(v);
    if(!m||m.type!=="paie-access-json-db"||m.version!==1||!m.tables||!m.detailFiles)throw new Error("Fichier JSON non reconnu. Choisissez le manifeste exporte par cet onglet.");
    var hasArchive=false,hasArchiveDetail=false,ti;
    for(ti=0;ti<m.tables.length;ti++){if(String(m.tables[ti].name).toLowerCase()==="archive")hasArchive=true;if(String(m.tables[ti].name).toLowerCase()==="archive_detail")hasArchiveDetail=true;}
    if(!hasArchive||!hasArchiveDetail)throw new Error("Cette base JSON ne contient pas les tables Archive et Archive_Detail requises pour les calculs.");
    m.__path=v;item={kind:"json",manifest:m,label:fso.GetFileName(v),archive:rpJsonTable(m,"Archive")};
  }else{p=localCopy(v);c=openConn(p);item={kind:"access",conn:c,label:fso.GetFileName(v)};}
  refDbs.push(item);refDbPaths.push(v);
  $("rpRefList").innerHTML+=(refDbs.length)+": "+esc(item.label)+" ("+(item.kind==="json"?"JSON":"Access")+") &nbsp; ";
  $("rpRefCount").innerHTML=refDbs.length+" base(s) ajoutee(s).";
}
function rpAddRefDb(){
  var v=$("rpRefFile").value;if(!v)return;
  try{rpAddRefDbPath(v);$("rpRefFile").value="";}catch(e){alert("Impossible de charger cette base de reference: "+errText(e));}
}
function rpResetRefDbs(){
  for(var i=0;i<refDbs.length;i++){try{if(refDbs[i].kind==="access")refDbs[i].conn.Close();}catch(x){}}
  refDbs=[];refDbPaths=[];$("rpRefList").innerHTML="";$("rpRefCount").innerHTML="0 base(s) ajoutee(s).";
}

/* ===================== Projets de rappel : fichiers JSON uniquement =====================
   Un projet = un fichier .json (filtres, agents coches, echelons, dates, parametres). Aucune base Access,
   aucun outil externe : seulement Scripting.FileSystemObject et ADODB.Stream deja utilises par l'application. */
var PROJ_DIR="projets",PROJ_TYPE="rappel-projet",rpCurrentProject="",rpLastFilter=null;
function projSafeName(no){return String(no).replace(/[^A-Za-z0-9._-]/g,function(c){return "~"+("000"+c.charCodeAt(0).toString(16)).slice(-4);});}
function projDirs(create){
  var c=[hostFolder()+"\\"+PROJ_DIR,sh.ExpandEnvironmentStrings("%TEMP%")+"\\paie_projets"],out=[],i;
  for(i=0;i<c.length;i++){
    try{if(!fso.FolderExists(c[i])){if(!create)continue;fso.CreateFolder(c[i]);}out.push(c[i]);}catch(e){}
  }
  return out;
}
function projTime(f){try{return new Date(String(fso.GetFile(f).DateLastModified)).getTime()||0;}catch(e){return 0;}}
function projPathFor(no){
  var dirs=projDirs(false),i,f,t,best="",bt=-1;
  for(i=0;i<dirs.length;i++){
    f=dirs[i]+"\\"+projSafeName(no)+".json";
    if(fso.FileExists(f)){t=projTime(f);if(t>bt){bt=t;best=f;}}
  }
  return best;
}
function projReadFile(f){
  var st=new ActiveXObject("ADODB.Stream"),txt;
  st.Type=2;st.Charset="utf-8";st.Open();
  try{st.LoadFromFile(f);txt=st.ReadText();}finally{st.Close();}
  return JSON.parse(String(txt).replace(/^\uFEFF/,""));
}
function projWrite(no,st){
  var ag=st.agents,lines=[],i,text,dirs=projDirs(true),k,f,tmp,s1,s2,last=null;
  for(i=0;i<ag.length;i++)lines.push(JSON.stringify(ag[i]));
  st.agents="@@";
  text=JSON.stringify(st,null,1).replace('"@@"',function(){return "[\n"+lines.join(",\n")+"\n]";})+"\n";
  st.agents=ag;
  for(k=0;k<dirs.length;k++){
    f=dirs[k]+"\\"+projSafeName(no)+".json";tmp=f+".tmp";s1=null;s2=null;
    try{
      s1=new ActiveXObject("ADODB.Stream");
      s1.Type=2;s1.Charset="utf-8";s1.Open();s1.WriteText(text);
      s1.Position=0;s1.Type=1;s1.Position=3;               // skip the UTF-8 BOM: plain, clean JSON file
      s2=new ActiveXObject("ADODB.Stream");s2.Type=1;s2.Open();
      s1.CopyTo(s2);s2.SaveToFile(tmp,2);
      s2.Close();s2=null;s1.Close();s1=null;
      if(fso.FileExists(f))fso.DeleteFile(f,true);
      fso.MoveFile(tmp,f);                                  // write to .tmp then rename: no half-written project
      return f;
    }catch(e){
      last=e;
      try{if(s2)s2.Close();}catch(x1){}try{if(s1)s1.Close();}catch(x2){}
      try{if(fso.FileExists(tmp))fso.DeleteFile(tmp,true);}catch(x3){}
    }
  }
  throw last||new Error("Aucun dossier accessible en ecriture");
}
function projList(){
  var dirs=projDirs(false),res={},i,en,f,d,key,t,arr=[];
  for(i=0;i<dirs.length;i++){
    try{
      en=new Enumerator(fso.GetFolder(dirs[i]).Files);
      for(;!en.atEnd();en.moveNext()){
        f=en.item();
        if(!/\.json$/i.test(String(f.Name)))continue;
        try{d=projReadFile(f.Path);}catch(e1){continue;}
        if(!d||d.type!==PROJ_TYPE||!d.no)continue;
        t=projTime(f.Path);key="k"+d.no;
        if(!res[key]||t>res[key].ts)res[key]={no:String(d.no),titre:d.titre||"",ts:t,file:f.Path};
      }
    }catch(e2){}
  }
  for(key in res)if(res.hasOwnProperty(key))arr.push(res[key]);
  arr.sort(function(x,y){return y.ts-x.ts;});
  return arr;
}
function rpSetSelVal(id,v){
  var s=$(id),i;if(!s)return false;
  v=String(v==null?"":v);
  for(i=0;i<s.options.length;i++)if(String(s.options[i].value)===v){s.selectedIndex=i;return true;}
  return false;
}
function rpRefreshProjList(sel){
  var s=$("rpProjSel");if(!s)return;
  var arr=[],i,o,d;
  try{arr=projList();}catch(e){}
  s.options.length=0;
  o=document.createElement("option");o.value="";
  o.text=arr.length?"(choisir un projet existant : "+arr.length+")":"(aucun projet enregistre)";
  s.options.add(o);
  for(i=0;i<arr.length;i++){
    d=new Date(arr[i].ts);
    o=document.createElement("option");o.value=arr[i].no;
    o.text=arr[i].no+(arr[i].titre?"  -  "+arr[i].titre:"")+"   ["+rpPad(d.getDate())+"/"+rpPad(d.getMonth()+1)+"/"+d.getFullYear()+" "+rpPad(d.getHours())+":"+rpPad(d.getMinutes())+"]";
    s.options.add(o);
  }
  if(sel)rpSetSelVal("rpProjSel",sel);
}
function rpPickProject(){
  var v=$("rpProjSel").value;
  if(!v)return;
  $("rpProjNo").value=v;
  rpOpenProject(v);
}
function rpUpdateSelCount(){
  var i,n=0,el;
  for(i=0;i<rpEmployees.length;i++){el=$("rps_"+i);if(el&&el.checked)n++;}
  if($("rpSelectionCount"))$("rpSelectionCount").innerHTML=n+" / "+rpEmployees.length+" agent(s) selectionne(s)";
}
function rpCollectState(no){
  var ag=[],i,e,g=function(id){var el=$(id);return el?el.value:"";};
  for(i=0;i<rpEmployees.length;i++){
    e=rpEmployees[i];
    ag.push({mat:e.mat,nom:e.name,inclure:!!($("rps_"+i)&&$("rps_"+i).checked),nouvelEch:g("rpn_"+i),dateEffet:g("rpd_"+i),fin:g("rpe_"+i),ech2:g("rpn2_"+i),date2:g("rpd2_"+i),bulletinRef:g("rpb_"+i)});
  }
  return {
    type:PROJ_TYPE,version:2,no:no,titre:trim(g("rpTitle")),date:new Date().toISOString(),
    baseDonnees:dbPath,basesReference:refDbPaths.slice(0),
    filtres:{corps:g("rpCorps"),matricules:g("rpMats"),dateDefaut:g("rpDefaultDate"),finDefaut:g("rpUntil"),bulletinGlobal:g("rpBaseGlobal")},
    filtresListe:rpLastFilter||{corps:g("rpCorps"),matricules:g("rpMats")},
    grilles:{g2022:g("rpGridDate2022"),g2023:g("rpGridDate2023"),g2024:g("rpGridDate2024")},
    calcul:{exclure:g("rpExcl"),fixes:g("rpFixed"),calculees:g("rpCalc"),intermediaires:!!($("rpInt")&&$("rpInt").checked),rendTaux:g("rpRendRate"),rendNote:g("rpRendNote"),titreEtat:g("rpTitle")},
    calcule:!!curR,
    agents:ag
  };
}
/* puts a saved project back into every field of the Rappel tab; returns {ok, warns, calc} */
function rpApplyState(st){
  var w=[],i,j,a,idx,f=st.filtres||{},lf=st.filtresListe||{corps:f.corps,matricules:f.matricules},g=st.grilles||{},c=st.calcul||{};
  function setVal(id,v){if(v!==undefined&&v!==null&&$(id))$(id).value=v;}
  curR=null;
  if(st.baseDonnees&&dbPath&&String(st.baseDonnees).toLowerCase()!==String(dbPath).toLowerCase())
    w.push("Projet cree avec la base "+st.baseDonnees+" ; base actuellement chargee : "+dbPath+".");
  rpResetRefDbs();
  var refs=st.basesReference||[];
  for(i=0;i<refs.length;i++){
    try{if(!fso.FileExists(refs[i]))throw new Error("fichier introuvable");rpAddRefDbPath(refs[i]);}
    catch(e){w.push("Base de reference non rechargee : "+refs[i]+" ("+errText(e)+")");}
  }
  /* 1. rebuild the agent list with the same filter it was loaded with */
  if(!rpSetSelVal("rpCorps",lf.corps||""))w.push("Corps du projet introuvable dans la base actuelle ("+lf.corps+").");
  setVal("rpMats",lf.matricules||"");
  setVal("rpDefaultDate",f.dateDefaut||"");
  if(f.finDefaut&&!rpSetSelVal("rpUntil",f.finDefaut))w.push("Mois de fin par defaut introuvable : "+f.finDefaut+".");
  rpLoadEmployees();
  if(!rpEmployees.length)return {ok:false,warns:w,msg:"Aucun agent n'a pu etre charge avec les filtres du projet."};
  if(f.bulletinGlobal&&!rpSetSelVal("rpBaseGlobal",f.bulletinGlobal))w.push("Bulletin de reference global introuvable : "+f.bulletinGlobal+".");
  /* 2. per-agent values */
  var byMat={},seen={},missing=[],badRef=0,added=0,ags=st.agents||[];
  for(i=0;i<rpEmployees.length;i++)byMat["k"+rpEmployees[i].mat]=i;
  for(j=0;j<ags.length;j++){
    a=ags[j];idx=byMat["k"+a.mat];
    if(idx===undefined){missing.push(a.mat);continue;}
    seen[idx]=true;
    $("rps_"+idx).checked=!!a.inclure;
    setVal("rpn_"+idx,a.nouvelEch);setVal("rpd_"+idx,a.dateEffet);setVal("rpe_"+idx,a.fin);
    setVal("rpn2_"+idx,a.ech2);setVal("rpd2_"+idx,a.date2);
    if(a.bulletinRef&&!rpSetSelVal("rpb_"+idx,a.bulletinRef))badRef++;
  }
  for(i=0;i<rpEmployees.length;i++)if(!seen[i]){$("rps_"+i).checked=false;added++;}
  if(missing.length)w.push(missing.length+" agent(s) du projet absent(s) de la base : "+missing.slice(0,8).join(", ")+(missing.length>8?"...":""));
  if(added)w.push(added+" agent(s) de la base ne figuraient pas dans le projet : decoches.");
  if(badRef)w.push(badRef+" bulletin(s) de reference individuel(s) introuvable(s) : remis en (global / auto).");
  /* 3. fields as they were on screen when the project was saved */
  rpSetSelVal("rpCorps",f.corps||"");setVal("rpMats",f.matricules||"");
  setVal("rpGridDate2022",g.g2022);setVal("rpGridDate2023",g.g2023);setVal("rpGridDate2024",g.g2024);
  setVal("rpExcl",c.exclure);setVal("rpFixed",c.fixes);setVal("rpCalc",c.calculees);
  if($("rpInt"))$("rpInt").checked=!!c.intermediaires;
  setVal("rpRendRate",c.rendTaux);setVal("rpRendNote",c.rendNote);setVal("rpTitle",c.titreEtat);
  rpLastFilter={corps:lf.corps||"",matricules:lf.matricules||""};
  rpUpdateSelCount();
  return {ok:true,warns:w,calc:!!st.calcule};
}
function rpOpenProject(no){
  no=trim(no===undefined?$("rpProjNo").value:no);
  var msg=$("rpProjMsg");
  if(!no){alert("Choisissez un projet dans la liste ou saisissez son numero.");return;}
  if(!conn){alert("Chargez d'abord la base principale (.mdb), puis ouvrez le projet.");rpSetSelVal("rpProjSel",rpCurrentProject);return;}
  var f=projPathFor(no),st;
  if(!f){alert("Projet introuvable : "+no);rpRefreshProjList();return;}
  try{st=projReadFile(f);}catch(e){alert("Fichier de projet illisible :\n"+f+"\n"+errText(e));return;}
  if(!st||st.type!==PROJ_TYPE||!st.agents){alert("Ce fichier n'est pas un projet de rappel valide :\n"+f);return;}
  if(rpEmployees.length&&!confirm("Remplacer les donnees affichees par celles du projet "+no+" ?")){rpSetSelVal("rpProjSel",rpCurrentProject);return;}
  $("rpProjNo").value=no;
  msg.innerHTML='<span class="muted">Chargement du projet...</span>';
  var r;
  try{r=rpApplyState(st);}catch(e2){msg.innerHTML='<span class="err">Ouverture impossible : '+esc(errText(e2))+'</span>';return;}
  if(!r.ok){msg.innerHTML='<span class="err">'+esc(r.msg)+'</span>'+(r.warns.length?'<br><span class="muted">'+esc(r.warns.join(" | "))+'</span>':'');return;}
  rpCurrentProject=no;rpSetSelVal("rpProjSel",no);
  msg.innerHTML='<span class="ok">Projet '+esc(no)+' charge ('+st.agents.length+' agent(s)).</span>'+(r.calc?' <span class="muted">Recalcul en cours...</span>':' <span class="muted">Vous pouvez continuer.</span>')+
    (r.warns.length?'<br><span class="err">A verifier : '+esc(r.warns.join(" | "))+'</span>':'');
  if(r.calc)rpRun();                                        // the project was saved with results on screen: rebuild them
}
function rpSaveProject(){
  var no=trim($("rpProjNo").value),msg=$("rpProjMsg");
  if(!no){alert("Entrez un numero de projet.");return;}
  if(!rpEmployees.length){alert("Chargez d'abord les agents (etape 1) : il n'y a rien a enregistrer.");return;}
  try{
    if(projPathFor(no)&&no!==rpCurrentProject&&!confirm("Le projet "+no+" existe deja. Le remplacer ?"))return;
    var f=projWrite(no,rpCollectState(no));
    rpCurrentProject=no;
    rpRefreshProjList(no);
    msg.innerHTML='<span class="ok">Projet '+esc(no)+' enregistre : '+esc(f)+'</span>';
  }catch(e){msg.innerHTML='<span class="err">Enregistrement impossible : '+esc(errText(e))+'</span>';}
}
function rpDeleteProject(){
  var no=trim($("rpProjNo").value),dirs,i,f;
  if(!no){alert("Choisissez le projet a supprimer.");return;}
  if(!projPathFor(no)){alert("Projet introuvable : "+no);return;}
  if(!confirm("Supprimer definitivement le projet "+no+" ?"))return;
  try{
    dirs=projDirs(false);
    for(i=0;i<dirs.length;i++){f=dirs[i]+"\\"+projSafeName(no)+".json";if(fso.FileExists(f))fso.DeleteFile(f,true);}
    if(rpCurrentProject===no)rpCurrentProject="";
    $("rpProjNo").value="";
    rpRefreshProjList();
    $("rpProjMsg").innerHTML='<span class="ok">Projet '+esc(no)+' supprime.</span>';
  }catch(e){$("rpProjMsg").innerHTML='<span class="err">Suppression impossible : '+esc(errText(e))+'</span>';}
}
/* ---------- printable version (HTML, opens in the default browser: A3 landscape, one agent never split, page totals) ---------- */
function rpSignoffData() {
  var net=0,i,v,dt=new Date();
  if(curR&&curR.recap)for(i=0;i<curR.recap.length;i++){v=parseFloat(rv(curR.recap[i][11]));if(!isNaN(v))net+=v;}
  return {net:net,words:engNumAr(net),date:rpPad(dt.getDate())+" / "+rpPad(dt.getMonth()+1)+" / "+dt.getFullYear()};
}
function rpSignoffRows(colCount) {
  var d=rpSignoffData(),lines=[
    "يوقف الجدول على : "+d.words,
    "مسعد في:",
    "المدير:"
  ],rows=[],i,c;
  for(i=0;i<lines.length;i++){
    c=X("S",lines[i],"e6",Math.max(0,colCount-1),1);
    rows.push([c]);
  }
  return rows;
}
function rpPrintSignoffHtml() {
  var d=rpSignoffData();
  return '<div class="signoff">' +
    '<div>يوقف الجدول على : '+esc(d.words)+'</div>' +
    '<div>مسعد في:</div>' +
    '<div>المدير:</div>' +
    '</div>';
}
function sheetsToHtml(sheets) {
  var o=['<!DOCTYPE html><html'+(LANG==="ar"?' dir="rtl"':'')+'><head><meta charset="utf-8"><title>Rappel d’echelon</title><style>@page{size:A3 landscape;margin:8mm}body{font-family:Arial,sans-serif;margin:0}.bar{padding:8px 12px;background:#dfe6f0;font-size:13px}table{border-collapse:collapse;table-layout:fixed}td{font-size:8pt;padding:1px 3px;white-space:nowrap;overflow:hidden;border:1px solid #000;vertical-align:middle}td.nb{border:0}.s_h{background:#dce6f1;font-weight:bold;text-align:center;white-space:normal}.s_bf,.s_bn,.s_b{background:#eef3fa;font-weight:bold}.num{text-align:right}.s_e1{font-size:20pt;font-weight:bold;text-align:center}.s_e2,.s_e4{font-size:13pt;font-weight:bold;text-align:center}.s_e3{font-size:14pt;font-weight:bold;text-align:right}.s_e5,.s_t{font-size:13pt;font-weight:bold}.s_e6{font-size:14pt;font-weight:bold;text-align:left}.s_e7{font-size:15pt;font-weight:bold;text-align:center}.s_cxa{background:#f7f7f2}.pg{page-break-after:always;padding:4px}.signoff{margin:14px 4px 2px;padding:0;font-size:12pt;direction:ltr;text-align:left;border:0}.signoff div{margin:5px 0;text-align:left;border:0}@media print{.bar{display:none}}</style></head><body><div class="bar"><button onclick="window.print()" style="font-size:14px;padding:4px 14px">Imprimer</button> &nbsp; Choisissez le format A3 et l’orientation paysage dans la fenetre d’impression (ou &laquo; Enregistrer en PDF &raquo;).</div>'];
  var si,pi,ri,ci;
  function trHtml(row,isHead){
    var h=['<tr'+(row.h?' style="height:'+row.h+'pt"':'')+'>'],k=0,col=1,cell,st,sp,cls,txt,nb;
    while(k<row.length){
      cell=row[k];st=cell.s||"";sp=1;nb=/^(e[1-7]|t)$/.test(st);
      if(cell.ix&&cell.ix>col&&st!=="e3"){h.push('<td class="nb" colspan="'+(cell.ix-col)+'"></td>');col=cell.ix;}
      if((/^e[1247]$/.test(st)||(st==="e3"&&!cell.ix))&&cell.t!=="E"){while(row[k+sp]&&row[k+sp].t==="E"&&row[k+sp].s===st)sp++;}
      else if(st==="e3"&&cell.ix){sp=cell.ix;}
      if(cell.m)sp=cell.m+1;
      cls="s_"+(st||"cx")+((cell.t==="N"||cell.t==="I")?" num":"")+(nb?" nb":"");
      if(cell.t==="E")txt="";else if(cell.t==="N")txt=esc(fmtNum(parseFloat(cell.v)));else if(cell.t==="I")txt=esc(cell.v);else txt=esc(cell.v);
      h.push('<td class="'+cls+'"'+(sp>1?' colspan="'+sp+'"':'')+' dir="auto" style="font-size:'+RP_FONT_SIZE+'pt">'+txt+'</td>');
      col+=sp;k+=sp;
    }
    h.push('</tr>');return h.join("");
  }
  for(si=0;si<sheets.length;si++){
    var sh2=sheets[si],rows=sh2.rows,hi=sh2.printRow-1,bounds=[sh2.printRow],tw=0,cols=[];
    for(ci=0;ci<sh2.plan.breaks.length;ci++)bounds.push(sh2.plan.breaks[ci]);
    bounds.push(rows.length);
    for(ci=0;ci<sh2.w.length;ci++){tw+=sh2.w[ci];cols.push('<col style="width:'+sh2.w[ci]+'pt">');}
    for(pi=0;pi<bounds.length-1;pi++){
      var t=['<div class="pg"><div style="zoom:'+(sh2.plan.scale/100)+'"><table'+(LANG==="ar"?' dir="rtl"':'')+' style="width:'+tw+'pt">'+cols.join("")];
      if(pi===0)for(ri=0;ri<hi;ri++)t.push(trHtml(rows[ri]));
      t.push(trHtml(rows[hi],true));
      for(ri=bounds[pi];ri<bounds[pi+1];ri++)t.push(trHtml(rows[ri]));
      t.push('</table></div>');
      if(pi===bounds.length-2)t.push(rpPrintSignoffHtml());
      t.push('</div>');o.push(t.join(""));
    }
  }
  o.push('</body></html>');return o.join("");
}
function rpPrint() {
  var oldLang=LANG;LANG="ar";
  try{rpPrintInner();}finally{LANG=oldLang;}
}
function rpPrintInner() {
  var b=rpBuildSheets();if(!b)return;
  rpApplyLayoutSettings(b.sheets);
  try{
    var dt=new Date(),stamp=dt.getFullYear()+rpPad(dt.getMonth()+1)+rpPad(dt.getDate())+"-"+rpPad(dt.getHours())+rpPad(dt.getMinutes())+rpPad(dt.getSeconds());
    var path=saveFile(String(b.fbase).replace(/[\\/:*?"<>|\s]+/g,"_")+"_impression_"+stamp+".html",sheetsToHtml(b.sheets));
    $("rpMsg").innerHTML='<span class="ok">Version imprimable creee: '+esc(path)+'</span> <span class="muted">(ouverte dans le navigateur; cliquez Imprimer, format A3 paysage)</span>';
    try{sh.Run('"'+path+'"',1,false);}catch(x){}
  }catch(e){$("rpMsg").innerHTML='<span class="err">Impression impossible: '+esc(errText(e))+'</span>';}
}

/* ===================== Cartes d'engagement : registre JSON par annee financiere =====================
   Aucune base Access, aucun outil externe: Scripting.FileSystemObject + ADODB.Stream seulement.
   - config_engagements.json  : entete des cartes, catalogue des articles, correspondance Rubrique->article, libelles des corps
   - registre_AAAA.json       : toutes les operations de l'annee, dans l'ordre (E, F, G, K stockes a chaque operation) */
var ENG_DIR="engagements",ENG_T_REG="registre-engagements",ENG_T_CFG="config-engagements";
var ENG_CAT=[[1,1,1,"الراتب الرئيسي للنشاط للموظفين المرسمين والمتربصين والمتعاونين","مرتبات نشاط المستخدمين المرسمين والمتربصين"],[1,1,3,"الراتب الرئيسي للنشاط للموظفين المرسمين والمتربصين والمتعاونين","الزيادة الإستدلالية لشاغلي المناصب العليا"],[1,2,1,"التعويضات والمنح المختلفة","التعويض عن المناوبة"],[1,2,2,"التعويضات والمنح المختلفة","تعويض عن خطر العدوى"],[1,2,3,"التعويضات والمنح المختلفة","تعويض التوثيق"],[1,2,7,"التعويضات والمنح المختلفة","تعويض التأهـيل"],[1,2,8,"التعويضات والمنح المختلفة","تعويض التأطير"],[1,2,9,"التعويضات والمنح المختلفة","علاوة المردودية"],[1,2,10,"التعويضات والمنح المختلفة","تعويض خدمات دعم نشاطات الصحة"],[1,2,11,"التعويضات والمنح المختلفة","تعويض الخدمات الإدارية المشتركة"],[1,2,12,"التعويضات والمنح المختلفة","تعويض الخدمات التقنية المشتركة"],[1,2,13,"التعويضات والمنح المختلفة","تعويض الضرر"],[1,2,14,"التعويضات والمنح المختلفة","التعويض الجزافي عن الخدمة"],[1,2,19,"التعويضات والمنح المختلفة","التعويض الجزافي عن الحضور والمشاركة في اشغال لجان الصفقات"],[1,2,20,"التعويضات والمنح المختلفة","تعويض دعم نشاطات الصحة"],[1,2,23,"التعويضات والمنح المختلفة","علاوة تحسين الأداء"],[1,2,24,"التعويضات والمنح المختلفة","علاوة تحسين الخدمات الطبية"],[1,2,25,"التعويضات والمنح المختلفة","علاوة تحسين الخدمات"],[1,2,26,"التعويضات والمنح المختلفة","تعويض المتابعة والدعم النفسيين"],[1,2,27,"التعويضات والمنح المختلفة","تعويض الإلزام الشبه طبي"],[1,2,28,"التعويضات والمنح المختلفة","تعويض دعم نشاطات الشبه طبية"],[1,2,29,"التعويضات والمنح المختلفة","تعويض التقنية"],[1,2,30,"التعويضات والمنح المختلفة","تعويض الإلزام لعلاجات التوليد والصحة الإنجابية"],[1,2,31,"التعويضات والمنح المختلفة","تعويض دعم الصحة الأم والطفل"],[1,2,32,"التعويضات والمنح المختلفة","تعويض الإلزام في العلاج المتخصص"],[1,2,34,"التعويضات والمنح المختلفة","تعويض الإلزام في نشاطات التخدير والانعاش"],[1,2,35,"التعويضات والمنح المختلفة","تعويض دعم نشاطات التخذير والانعاش"],[1,2,36,"التعويضات والمنح المختلفة","تعويض عن المسؤولية الشخصية"],[1,2,38,"التعويضات والمنح المختلفة","تنازل عن النشاط التكميلي"],[1,2,39,"التعويضات والمنح المختلفة","منحة جزافية تعويضية"],[1,2,40,"التعويضات والمنح المختلفة","تعويض تسيير المصالح الصحة"],[1,2,41,"التعويضات والمنح المختلفة","تعويض دعم نشاطات الإدارة"],[1,2,42,"التعويضات والمنح المختلفة","تعويض الخدمة الإلزامية النوعية"],[1,2,47,"التعويضات والمنح المختلفة","تعويض المنطقة"],[1,2,48,"التعويضات والمنح المختلفة","التعويض النوعي عن المنصب"],[1,2,50,"التعويضات والمنح المختلفة","تعويض شهري عن السكن"],[1,2,58,"التعويضات والمنح المختلفة","علاوة استثنائية لفائدة المستخدمين في الهياكل والمؤسسات التابعة لقطاع الصحة المجندين في إطار الوقاية من انتشار وباء كورونا ( كوفيد 19 ) ومكافحته"],[1,4,1,"رواتب المستخدمين المتعاقدين","مرتبات المستخدمين المتعاقدين بالتوقيت الكلي"],[1,4,3,"رواتب المستخدمين المتعاقدين","التعويضات والمنح المختلفة الممنوحة للمستخدمين المتعاقدين بالتوقيت الكلي"],[1,4,5,"رواتب المستخدمين المتعاقدين","علاوة استثنائية لفائدة المستخدمين في الهياكل في الهياكل والمؤسسات التابعة لقطاع الصحة المجندين في إطار الوقاية من انتشار وباء كورونا ( كوفيد 19 ) ومكافحته"],[1,5,1,"التكاليف الإجتماعية للموظفين المرسمين والمتربصين والمتعاونين","خدمات ذات طابع عائلي"],[1,5,2,"التكاليف الإجتماعية للموظفين المرسمين والمتربصين والمتعاونين","الضمان الإجتماعي(النظام العام) 23.75 %"],[1,5,3,"التكاليف الإجتماعية للموظفين المرسمين والمتربصين والمتعاونين","التأمين على البطالـــة ( 01 % )"],[1,5,4,"التكاليف الإجتماعية للموظفين المرسمين والمتربصين والمتعاونين","التقاعـد المسبق ( 0.25 % )"],[1,7,1,"التكاليف الإجتماعية للمستخدمين المتعاقدين","خدمات ذات طابع عائلي"],[1,7,2,"التكاليف الإجتماعية للمستخدمين المتعاقدين","الضمان الإجتماعي(النظام العام) 23.75 %"],[1,7,3,"التكاليف الإجتماعية للمستخدمين المتعاقدين","التأمين على البطالة 01 %"],[1,7,4,"التكاليف الإجتماعية للمستخدمين المتعاقدين","التقاعد المسبق 0.25 %"],[1,8,1,"معاش الخدمة والأضرار الجسدية و ريوع حوادث العمل","معاش الخدمة"],[1,8,2,"معاش الخدمة والأضرار الجسدية و ريوع حوادث العمل","معاش الأضرار الجسدية"],[1,8,3,"معاش الخدمة والأضرار الجسدية و ريوع حوادث العمل","ريوع حوادث العمل"],[1,9,1,"الخدمات الإجتماعية","المساهمات في لجان الخدمات الإجتماعية 02 %"],[1,9,2,"الخدمات الإجتماعية","النسبة المخصصة لتموين السكن الإجتماعي ( 0.5 % )"],[1,9,3,"الخدمات الإجتماعية","النسبة المخصصة للتقاعد المسبق ( 0.5 % )"]];
var ENG_TYPES={ouverture:"Ouverture de credit",depense:"Depense (engagement)",economie:"Economie",transfert_plus:"Transfert (+)",transfert_moins:"Transfert (-)"};
var ENG_OPP={depense:"economie",economie:"depense",transfert_plus:"transfert_moins",transfert_moins:"transfert_plus"};
var ENG_TITRES={"1":"العنوان الأول : نفقات المستخدمين","2":"العنوان الثاني : نفقات تسيير المصالح","4":"العنوان الرابع : نفقات التحويل"};
var engCfg=null,engCfgRO=false,engReg=null,engDrafts=[],engInit=false,engMapRows=[],engMapCorps=[],engProjCtx=null,engDosId=0;
var ENG_SRC_TYPES={rappel_echelon:{lab:"Rappel d'echelon (promotion)",ar:"فارق ناتج عن الترقية في الدرجة",ok:true},categories:{lab:"Mise a l'echelle des categories (a venir)",ar:"فارق ناتج عن تعديل سلم الأصناف",ok:false},recrutement:{lab:"Recrutement (a venir)",ar:"التوظيف",ok:false},rubrique_partielle:{lab:"Rappel partiel de rubrique (a venir)",ar:"فارق جزئي لمنحة",ok:false}};

/* ---------- formatting helpers ---------- */
function engFmt(n){
  var s=(Math.round(n*100)/100).toFixed(2),neg=s.charAt(0)==="-",p;
  if(neg)s=s.substring(1);
  p=s.split(".");
  return (neg?"-":"")+p[0].replace(/\B(?=(\d{3})+(?!\d))/g," ")+","+p[1];
}
function engNum(s){var x=parseFloat(String(s).replace(/[\s\u00a0]/g,"").replace(",","."));return isNaN(x)?0:x;}
function engIso(d){return d.getFullYear()+"-"+rpPad(d.getMonth()+1)+"-"+rpPad(d.getDate());}
function engDisp(iso){var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(iso||"");return m?m[3]+"/"+m[2]+"/"+m[1]:"";}
function engParseDateInput(s){var d=rpParseDate(s);if(!d||d.m<1||d.m>12||d.d<1||d.d>31)return "";return d.y+"-"+rpPad(d.m)+"-"+rpPad(d.d);}

/* ---------- amount in Arabic words ("أقفل هذا البيان عند المبلغ") ---------- */
function engUnitsAr(n){
  var U=["","واحد","اثنان","ثلاثة","أربعة","خمسة","ستة","سبعة","ثمانية","تسعة","عشرة","أحد عشر","اثنا عشر","ثلاثة عشر","أربعة عشر","خمسة عشر","ستة عشر","سبعة عشر","ثمانية عشر","تسعة عشر"];
  var T=["","","عشرون","ثلاثون","أربعون","خمسون","ستون","سبعون","ثمانون","تسعون"];
  var H=["","مائة","مائتان","ثلاثمائة","أربعمائة","خمسمائة","ستمائة","سبعمائة","ثمانمائة","تسعمائة"];
  var h=Math.floor(n/100),r=n%100,o=[],t,u;
  if(h)o.push(H[h]);
  if(r){if(r<20)o.push(U[r]);else{t=Math.floor(r/10);u=r%10;o.push(u?U[u]+" و"+T[t]:T[t]);}}
  return o.join(" و");
}
function engIntAr(n){
  if(n===0)return "صفر";
  var sc=[[1000000000,"مليار","ملياران","مليارات","مليارا"],[1000000,"مليون","مليونان","ملايين","مليونا"],[1000,"ألف","ألفان","آلاف","ألفا"]];
  var parts=[],i,s,q,r;
  for(i=0;i<3;i++){
    s=sc[i];q=Math.floor(n/s[0]);
    if(q>0){
      n-=q*s[0];r=q%100;
      if(q===1)parts.push(s[1]);
      else if(q===2)parts.push(s[2]);
      else if(r===0)parts.push(engUnitsAr(q)+" "+s[1]);
      else if(r>=3&&r<=10)parts.push(engUnitsAr(q)+" "+s[3]);
      else parts.push(engUnitsAr(q)+" "+s[4]);
    }
  }
  if(n>0)parts.push(engUnitsAr(n));
  return parts.join(" و");
}
function engNumAr(n){
  n=Math.round(n*100)/100;
  var neg=n<0,di,ce,out;
  if(neg)n=-n;
  di=Math.floor(n+0.00001);ce=Math.round((n-di)*100);
  out=engIntAr(di)+" دينار جزائري";
  if(ce>0)out+=" و"+engIntAr(ce)+" سنتيم";
  return (neg?"سالب ":"")+out;
}

/* ---------- file storage (plain JSON, atomic write, .bak of the previous version) ---------- */
function engDirs(create){
  var c=[hostFolder()+"\\"+ENG_DIR,sh.ExpandEnvironmentStrings("%TEMP%")+"\\paie_engagements"],out=[],i;
  for(i=0;i<c.length;i++){
    try{if(!fso.FolderExists(c[i])){if(!create)continue;fso.CreateFolder(c[i]);}out.push(c[i]);}catch(e){}
  }
  return out;
}
function engFileFind(fname){
  var dirs=engDirs(false),i,f,t,best="",bt=-1;
  for(i=0;i<dirs.length;i++){
    f=dirs[i]+"\\"+fname;
    if(fso.FileExists(f)){t=projTime(f);if(t>bt){bt=t;best=f;}}
  }
  return best;
}
function engWriteJson(fname,obj,listKey){
  var lst=obj[listKey],lines=[],i,text,ex,dirs,order=[],k,f,tmp,s1,s2,last=null,j,dup;
  for(i=0;i<lst.length;i++)lines.push(JSON.stringify(lst[i]));
  obj[listKey]="@@";
  try{text=JSON.stringify(obj,null,1);}finally{obj[listKey]=lst;}
  text=text.replace('"@@"',function(){return "[\n"+lines.join(",\n")+"\n]";})+"\n";
  ex=engFileFind(fname);dirs=engDirs(true);
  if(ex)order.push(ex.substring(0,ex.lastIndexOf("\\")));
  for(j=0;j<dirs.length;j++){dup=false;for(i=0;i<order.length;i++)if(order[i]===dirs[j])dup=true;if(!dup)order.push(dirs[j]);}
  for(k=0;k<order.length;k++){
    f=order[k]+"\\"+fname;tmp=f+".tmp";s1=null;s2=null;
    try{
      s1=new ActiveXObject("ADODB.Stream");
      s1.Type=2;s1.Charset="utf-8";s1.Open();s1.WriteText(text);
      s1.Position=0;s1.Type=1;s1.Position=3;                 // drop the BOM
      s2=new ActiveXObject("ADODB.Stream");s2.Type=1;s2.Open();
      s1.CopyTo(s2);s2.SaveToFile(tmp,2);
      s2.Close();s2=null;s1.Close();s1=null;
      if(fso.FileExists(f)){try{fso.CopyFile(f,f+".bak",true);}catch(xb){}fso.DeleteFile(f,true);}
      fso.MoveFile(tmp,f);
      return f;
    }catch(e){
      last=e;
      try{if(s2)s2.Close();}catch(x1){}try{if(s1)s1.Close();}catch(x2){}
      try{if(fso.FileExists(tmp))fso.DeleteFile(tmp,true);}catch(x3){}
    }
  }
  throw last||new Error("Aucun dossier accessible en ecriture");
}

/* ---------- configuration (shared by all years) ---------- */
function engDefaultCfg(){
  var a=[],i,c;
  for(i=0;i<ENG_CAT.length;i++){c=ENG_CAT[i];a.push({t:c[0],b:c[1],m:c[2],bt:c[3],mt:c[4]});}
  return {type:ENG_T_CFG,version:1,
    entete:{l1:"الجمهورية الجزائرية الديمقراطية الشعبية",l2:"وزارة الصحــة",l3:"مديرية الصحـــة والسكــان لولايـــة الجلفـــة",l4:"المؤسسة العمومية الاستشفائية بمسعد"},
    articles:a,rubriques:{},corps:{}};
}
function engLoadCfg(){
  var f=engFileFind("config_engagements.json"),c=null;
  engCfgRO=false;
  if(f){
    try{c=projReadFile(f);}catch(e){alert("Configuration illisible :\n"+f+"\n"+errText(e)+"\n\nElle ne sera pas ecrasee (corrigez ou supprimez le fichier).");engCfgRO=true;c=null;}
    if(c&&(c.type!==ENG_T_CFG||!c.articles)){alert("Fichier de configuration invalide :\n"+f);engCfgRO=true;c=null;}
  }
  if(!c){
    c=engDefaultCfg();
    if(!engCfgRO){try{engWriteJson("config_engagements.json",c,"articles");}catch(e2){}}
  }
  if(!c.rubriques)c.rubriques={};
  if(!c.corps)c.corps={};
  if(!c.entete)c.entete=engDefaultCfg().entete;
  engCfg=c;
}
function engSaveCfg(){
  if(engCfgRO)throw new Error("Configuration en lecture seule (fichier illisible).");
  engWriteJson("config_engagements.json",engCfg,"articles");
}
function engArtKey(a){return a.t+"."+a.b+"."+a.m;}
function engArt(k){var i;for(i=0;i<engCfg.articles.length;i++)if(engArtKey(engCfg.articles[i])===k)return engCfg.articles[i];return null;}
function engArtLabel(k){var a=engArt(k);return k+(a?" - "+a.mt:"");}
function engArtsSorted(){
  var a=engCfg.articles.slice(0);
  a.sort(function(x,y){return (x.t-y.t)||(x.b-y.b)||(x.m-y.m);});
  return a;
}

/* ---------- ledger rules ---------- */
/* state AFTER an operation: transfers move the licence E, expenses/economies move the cumulative F; K is the balance shown on the card */
function engAfterOf(op){
  var E=op.E,F=op.F;
  if(op.type==="transfert_plus")E=r2(E+op.I);else if(op.type==="transfert_moins")E=r2(E-op.I);
  if(op.type==="depense")F=r2(F+op.I);else if(op.type==="economie")F=r2(F-op.I);
  return {E:E,F:F,K:op.K,num:op.num};
}
function engStateOf(art,ops){
  var i,last=null;
  for(i=0;i<ops.length;i++)if(ops[i].art===art)last=ops[i];
  return last?engAfterOf(last):null;
}
/* values printed on the card: E, F, G = state before; K = G -/+ I */
function engCalc(st,type,I){
  I=r2(I);
  if(!(I>0))return {err:"Montant nul ou negatif."};
  if(type==="ouverture"){
    if(st)return {err:"Credit deja ouvert pour cette matiere."};
    return {E:I,F:0,G:0,K:I,I:I};
  }
  if(!st)return {err:"Aucun credit ouvert pour cette matiere (emettre d'abord la carte d'ouverture)."};
  var G=st.K,K=(type==="depense"||type==="transfert_moins")?r2(G-I):r2(G+I);
  return {E:st.E,F:st.F,G:G,K:K,I:I};
}
function engHasActive(projet,art){
  var i,o,k,hit;
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];
    if(o.art!==art||o.type!=="depense"||o.statut!=="emise"||o.annulee_par)continue;
    hit=(o.projet===projet);
    if(!hit&&o.projets)for(k=0;k<o.projets.length;k++)if(o.projets[k]===projet)hit=true;
    if(hit)return true;
  }
  return false;
}
function engDraftDup(d){
  var L=d.projets||(d.projet?[d.projet]:[]),i;
  for(i=0;i<L.length;i++)if(engHasActive(L[i],d.art))return true;
  return false;
}
/* simulate the selected drafts one after the other (several cards on the same article chain correctly) */
function engSimulate(){
  var map={},res=[],i,d,st,c,k;
  for(i=0;i<engDrafts.length;i++){
    d=engDrafts[i];
    if(!d.sel){res.push(null);continue;}
    k="k"+d.art;
    if(!map.hasOwnProperty(k))map[k]=engStateOf(d.art,engReg.ops);
    st=map[k];
    c=engCalc(st,d.type,d.I);
    if(!c.err){
      c.num=(st?st.num:0)+1;
      map[k]=engAfterOf({type:d.type,E:c.E,F:c.F,I:c.I,K:c.K,num:c.num});
    }
    res.push(c);
  }
  return res;
}

/* ---------- Rubrique -> article suggestion (Arabic label matching) ---------- */
function engArNorm(s){
  return String(s||"").replace(/[\u064B-\u0652\u0640]/g,"").replace(/[إأآ]/g,"ا").replace(/ى/g,"ي").replace(/ة/g,"ه")
    .replace(/[^\u0621-\u064A0-9a-zA-Z ]/g," ").replace(/\s+/g," ").replace(/^ | $/g,"");
}
function engTokens(s){
  var a=engArNorm(s).split(" "),o=[],i,w;
  for(i=0;i<a.length;i++){w=a[i].replace(/^ال/,"");if(w.length>1)o.push(w);}
  return o;
}
function engScore(a,b){
  var A=engTokens(a),B=engTokens(b),i,j,n=0;
  if(!A.length||!B.length)return 0;
  for(i=0;i<A.length;i++)for(j=0;j<B.length;j++)if(A[i]===B[j]){n++;break;}
  return 2*n/(A.length+B.length);
}
function engGuessArticle(rub,kind,arab){
  var best="",bs=0,tie=false,i,s,a;
  if(kind==="lead"){
    var fr=function(x){return String(x||"").toLowerCase().replace(/[àâä]/g,"a").replace(/[éèêë]/g,"e").replace(/[îï]/g,"i").replace(/[ôö]/g,"o").replace(/[ùûü]/g,"u").replace(/ç/g,"c").replace(/[^a-z]/g,"");},l1=fr(rub.lib),l2=fr(rub.code);
    if(/^salairedebase/.test(l1)||/^salairedebase/.test(l2)||/^indemnitedexperience/.test(l1)||/^indemniteexperience/.test(l1)||l1==="iep"||l2==="iep")return "1.1.1";
    return "";
  }
  for(i=0;i<engCfg.articles.length;i++){
    a=engCfg.articles[i];s=engScore(arab,a.mt);
    if(s>bs+0.0001){bs=s;best=engArtKey(a);tie=false;}else if(Math.abs(s-bs)<0.0001&&s>0)tie=true;
  }
  return (bs>=0.6&&!tie)?best:"";
}

/* ---------- card HTML (one A4 page per card, same layout as the Excel form) ---------- */
function engCardHtml(op,printDate){
  var a=engArt(op.art)||{t:1,b:0,m:0,bt:"",mt:""},h=engCfg.entete,o=[],i,l,tk,total=0,anyM=false,pad=function(n){return (n<10?"0":"")+n;};
  var typeLab=(op.type==="transfert_plus")?"تحويل ( + )":(op.type==="transfert_moins")?"تحويل ( - )":"";
  o.push('<div class="pg">');
  o.push('<div class="c b" style="font-size:14pt">'+esc(h.l1)+'</div>');
  o.push('<table class="nb"><tr><td class="b">'+esc(String(h.l2).replace(/^\s+/,""))+'</td><td></td></tr><tr><td class="b">'+esc(h.l3)+'</td><td class="l b">السنة المالية: '+engReg.annee+'</td></tr><tr><td class="b">'+esc(h.l4)+'</td><td></td></tr></table>');
  o.push('<p class="c b" style="font-size:14pt;margin:10px 0">رقم بطاقة الالتزام: '+op.num+' &nbsp;&nbsp;&nbsp;&nbsp; التاريخ : '+(printDate?engDisp(op.date):'.............')+'</p>');
  if(op.dossier)o.push('<p class="b" style="margin:2px 0">ملف الالتزام رقم: '+esc(op.dossier)+(op.dossierTitre?' - '+esc(op.dossierTitre):'')+'</p>');
  o.push('<div>رمز البرنامج : &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; / <br>رمز النشــاط : &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; / <br>رمز النشاط الفرعي (عند الاقتضاء) : &nbsp;&nbsp;&nbsp; / <br>رمز البرنامج الفرعي : &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; /</div>');
  o.push('<p class="b" style="margin:8px 0 2px">العنوان : <span style="font-weight:normal;font-size:10pt">(يجب إبراز العنوان المعني / اختيار خانة العنوان المعني)</span></p>');
  o.push('<table class="nb" style="margin-bottom:8px">');
  var ks=[1,2,4];
  for(i=0;i<ks.length;i++){
    tk=ks[i];
    o.push('<tr><td class="bx">'+(a.t===tk?'X':'&nbsp;')+'</td><td>'+esc(ENG_TITRES[String(tk)])+'</td><td class="b">'+(i===0?'الباب '+pad(a.b)+': '+esc(a.bt):(i===2?'المادة '+pad(a.m)+': '+esc(a.mt):''))+'</td></tr>');
  }
  o.push('</table>');
  o.push('<table class="t c"><tr class="b"><td>الباب</td><td>المادة</td><td>رخصة الإلتزام<br>المفتوحة / المعدلة</td><td>مجموع الإلتزامات السابقة</td><td>الرصيد الأولي</td><td>الالتزام المقترح</td><td>الرصيد المتبقي</td></tr>');
  o.push('<tr><td>'+a.b+'</td><td>'+a.m+'</td><td class="num">'+engFmt(op.E)+'</td><td class="num">'+engFmt(op.F)+'</td><td class="num">'+engFmt(op.G)+'</td><td class="num b">'+engFmt(op.I)+'</td><td class="num">'+engFmt(op.K)+'</td></tr></table>');
  o.push('<p style="margin:8px 0"><b>أقفل هذا البيان عند المبلغ:</b> '+esc(engNumAr(op.I))+'</p>');
  o.push('<p class="b" style="margin:6px 0">موضوع الالتزام : &nbsp;&nbsp; <span class="bx2">'+(op.type==="economie"?'&nbsp;':'X')+'</span> نفقـــــــة &nbsp;&nbsp;&nbsp; <span class="bx2">'+(op.type==="economie"?'X':'&nbsp;')+'</span> إقتصاد'+(typeLab?' &nbsp;&nbsp;&nbsp; '+typeLab:'')+'</p>');
  o.push('<div class="objet">'+esc(op.objet||"").replace(/\n/g,'<br>'));
  if(op.allocations&&op.allocations.length){
    o.push('<table class="t" style="margin-top:8px"><tr class="b"><td>المشروع</td><td>السلك</td><td class="num">المبلغ</td></tr>');
    for(i=0;i<op.allocations.length;i++){
      l=op.allocations[i];anyM=true;total+=Number(l.amount)||0;
      o.push('<tr><td>'+esc((l.projectNo||"")+(l.projectTitle?' - '+l.projectTitle:''))+'</td><td>'+esc(l.corpsLabel||"")+'</td><td class="num">'+engFmt(Number(l.amount)||0)+'</td></tr>');
    }
    o.push('<tr class="b"><td colspan="2">المجموع</td><td class="num">'+engFmt(r2(total))+'</td></tr></table>');
  }else if(op.lignes&&op.lignes.length){
    o.push('<table class="t" style="margin-top:8px">');
    for(i=0;i<op.lignes.length;i++){
      l=op.lignes[i];
      if(l.m!==null&&l.m!==undefined&&l.m!==""){anyM=true;total+=l.m;o.push('<tr><td>'+esc(l.l)+'</td><td class="num">'+engFmt(l.m)+'</td></tr>');}
      else o.push('<tr><td colspan="2">'+esc(l.l)+'</td></tr>');
    }
    if(anyM)o.push('<tr class="b"><td>المجموع</td><td class="num">'+engFmt(r2(total))+'</td></tr>');
    o.push('</table>');
  }
  o.push('</div>');
  o.push('<table class="t sig" style="margin-top:10px"><tr><td class="b c">إطار مخصص للمراقب الميزانياتي</td><td class="b c">إطار مخصص للآمر بالصرف</td></tr>');
  o.push('<tr><td style="height:30mm;vertical-align:top">رقم التأشيرة :<br><br>تاريخ التأشيرة :<br><br>إمضاء &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; الختم</td><td style="vertical-align:top">إمضاء &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ختم</td></tr></table>');
  o.push('</div>');
  return o.join("");
}
function engPageHtml(ops,printDate){
  var o=['<!DOCTYPE html><html dir="rtl"><head><meta charset="utf-8"><title>بطاقات الالتزام</title><style>@page{size:A4 portrait;margin:8mm}body{margin:0;font-family:Arial,"Traditional Arabic",sans-serif;font-size:12pt}.bar{padding:8px 12px;background:#dfe6f0;font-size:13px}.pg{page-break-after:always;padding:6px 10px}.pg:last-child{page-break-after:auto}.c{text-align:center}.b{font-weight:bold}.l{text-align:left}table{border-collapse:collapse;width:100%}table.t td{border:1px solid #000;padding:4px 6px;font-size:11pt}table.nb td{border:0;padding:1px 4px}td.bx,span.bx2{display:inline-block;width:22px;height:18px;border:1px solid #000;text-align:center;font-weight:bold}td.bx{display:table-cell;width:26px}.num{text-align:left;direction:ltr;white-space:nowrap}.objet{border:1px solid #000;padding:8px;min-height:55mm;font-size:12pt}@media print{.bar{display:none}}</style></head><body><div class="bar"><button onclick="window.print()" style="font-size:14px;padding:4px 14px">Imprimer</button> &nbsp; A4 portrait - '+ops.length+' carte(s)</div>'],i;
  for(i=0;i<ops.length;i++)o.push(engCardHtml(ops[i],printDate));
  o.push('</body></html>');
  return o.join("");
}

/* ===================== Cartes d'engagement : interface ===================== */
function engMsg(h){var e=$("engMsg");if(e)e.innerHTML=h;}
function engOk(t){engMsg('<span class="ok">'+esc(t)+'</span>');}
function engErr(t){engMsg('<span class="err">'+esc(t)+'</span>');}
function engSub(name){
  var ids=["dos","credits","cards","reg","state"],i;
  for(i=0;i<ids.length;i++){
    $("eng_"+ids[i]).className="engsub"+(ids[i]===name?" on":"");
    $("engb_"+ids[i]).className=(ids[i]===name?"on":"");
  }
  if(name==="dos")engRenderDos();
  if(name==="reg")engRenderReg();
  if(name==="state")engRenderState();
}
function engOnShow(){
  if(engInit)return;
  engInit=true;
  try{engLoadCfg();}catch(e){alert("Configuration des cartes impossible : "+errText(e));}
  var t=new Date();
  $("engDate").value=rpPad(t.getDate())+"/"+rpPad(t.getMonth()+1)+"/"+t.getFullYear();
  var ys=engYears();
  if(ys.length){engRefreshYears(ys[0]);engOpenYear(ys[0]);}
  else{$("engYear").value=Math.max(2027,t.getFullYear());engRefreshYears();}
  engSub("dos");
}
function engYears(){
  var dirs=engDirs(false),i,en,m,seen={},out=[],y;
  for(i=0;i<dirs.length;i++){
    try{
      en=new Enumerator(fso.GetFolder(dirs[i]).Files);
      for(;!en.atEnd();en.moveNext()){
        m=/^registre_(\d{4})\.json$/i.exec(String(en.item().Name));
        if(m&&!seen["k"+m[1]]){seen["k"+m[1]]=true;out.push(parseInt(m[1],10));}
      }
    }catch(e){}
  }
  out.sort(function(a,b){return b-a;});
  return out;
}
function engRefreshYears(sel){
  var s=$("engYearSel"),ys=engYears(),i,o;
  s.options.length=0;
  o=document.createElement("option");o.value="";o.text=ys.length?"(annees existantes : "+ys.length+")":"(aucun registre)";s.options.add(o);
  for(i=0;i<ys.length;i++){o=document.createElement("option");o.value=ys[i];o.text="Annee financiere "+ys[i];s.options.add(o);}
  if(sel)rpSetSelVal("engYearSel",sel);
}
function engPickYear(){var v=$("engYearSel").value;if(v){$("engYear").value=v;engOpenYear(v);}}
function engOpenYear(y){
  y=parseInt(y,10);
  if(!engCfg){try{engLoadCfg();}catch(e0){}}
  if(isNaN(y)||y<2000||y>2100){alert("Annee financiere invalide.");return;}
  if(engDrafts.length&&!confirm("Les cartes en preparation seront abandonnees. Continuer ?"))return;
  var fn="registre_"+y+".json",f=engFileFind(fn),r=null;
  if(f){
    try{r=projReadFile(f);}catch(e){alert("Registre illisible :\n"+f+"\n"+errText(e));return;}
    if(!r||r.type!==ENG_T_REG||!r.ops){alert("Ce fichier n'est pas un registre d'engagements valide :\n"+f);return;}
  }else{
    if(!confirm("Aucun registre pour l'annee "+y+". Le creer ?"))return;
    r={type:ENG_T_REG,version:1,annee:y,cree:new Date().toISOString(),modifie:"",decision:{no:"",date:""},seq:0,dossiers:[],dseq:0,ops:[]};
    try{engWriteJson(fn,r,"ops");}catch(e2){alert("Creation impossible : "+errText(e2));return;}
  }
  if(!r.decision)r.decision={no:"",date:""};
  if(!r.seq)r.seq=r.ops.length;
  if(!r.dossiers)r.dossiers=[];if(!r.dseq)r.dseq=r.dossiers.length;
  engReg=r;engDrafts=[];engDosId=0;
  $("engYear").value=y;engRefreshYears(y);
  engRenderAll();
  engOk("Registre "+y+" ouvert : "+r.ops.length+" operation(s).");
}
function engSaveReg(){engReg.modifie=new Date().toISOString();engWriteJson("registre_"+engReg.annee+".json",engReg,"ops");}
function engFillManual(){
  var s=$("engmArt"),a=engArtsSorted(),i,o,v=s.value,t=$("engmType");
  s.options.length=0;o=document.createElement("option");o.value="";o.text="-- matiere --";s.options.add(o);
  for(i=0;i<a.length;i++){o=document.createElement("option");o.value=engArtKey(a[i]);o.text=engArtKey(a[i])+" - "+a[i].mt;s.options.add(o);}
  rpSetSelVal("engmArt",v);
  if(!t.options.length){var k;for(k in ENG_TYPES)if(ENG_TYPES.hasOwnProperty(k)&&k!=="ouverture"){o=document.createElement("option");o.value=k;o.text=ENG_TYPES[k];t.options.add(o);}}
}
function engRenderAll(){engRenderDos();engFillFilter();engFillManual();engRenderCredits();engRenderDrafts();engRenderReg();engRenderState();}
function engNeedReg(){if(!engReg){alert("Ouvrez ou creez d'abord une annee financiere.");return false;}return true;}


/* ===================== Dossiers (projets) d'engagement ===================== */
function engDosById(id){var i;if(!engReg)return null;for(i=0;i<engReg.dossiers.length;i++)if(engReg.dossiers[i].id===id)return engReg.dossiers[i];return null;}
function engDosCur(){return engDosById(engDosId);}
function engDosOps(d){var i,n=0;for(i=0;i<engReg.ops.length;i++)if(engReg.ops[i].dossier===d.no)n++;return n;}
function engDosFill(d){
  $("engdNo").value=d?d.no:"";$("engdTitre").value=d?d.titre:"";$("engdObjet").value=d?d.objet:"";$("engdStat").value=d?d.statut:"ouvert";
}
function engDosSave(){
  if(!engNeedReg())return;
  var no=trim($("engdNo").value),ti=trim($("engdTitre").value),ob=trim($("engdObjet").value),st=$("engdStat").value,d=engDosCur(),i,o;
  if(!no){alert("Saisissez le numero du dossier d'engagement.");return;}
  for(i=0;i<engReg.dossiers.length;i++)if(engReg.dossiers[i].no===no&&engReg.dossiers[i].id!==engDosId){alert("Ce numero existe deja pour l'annee "+engReg.annee+".");return;}
  var bak=JSON.stringify(engReg.dossiers),seq0=engReg.dseq,id0=engDosId;
  if(d){
    if(d.no!==no&&engDosOps(d)>0){alert("Des cartes ont deja ete emises sous le numero "+d.no+" : le numero ne peut plus changer (titre et objet restent modifiables).");return;}
    d.no=no;d.titre=ti;d.objet=ob;d.statut=st;d.modifie=new Date().toISOString();
  }else{
    d={id:++engReg.dseq,no:no,titre:ti,objet:ob,statut:st,cree:new Date().toISOString(),sources:[]};
    engReg.dossiers.push(d);engDosId=d.id;
  }
  try{engSaveReg();}catch(e){engReg.dossiers=JSON.parse(bak);engReg.dseq=seq0;engDosId=id0;alert("Enregistrement impossible : "+errText(e));return;}
  engRenderDos();engOk("Dossier "+no+" enregistre.");
}
function engDosNew(){engDosId=0;engDosFill(null);engRenderDos();}
function engDosPick(){engDosId=parseInt($("engDosSel").value,10)||0;engRenderDos();}
function engDosDelete(){
  var d=engDosCur();if(!d){alert("Choisissez un dossier.");return;}
  if(engDosOps(d)>0){alert("Suppression impossible : "+engDosOps(d)+" carte(s) emise(s) sous ce dossier (elles restent au registre).");return;}
  if(!confirm("Supprimer le dossier "+d.no+" et la liste de ses projets importes ?"))return;
  var bak=JSON.stringify(engReg.dossiers),i;
  for(i=0;i<engReg.dossiers.length;i++)if(engReg.dossiers[i].id===d.id){engReg.dossiers.splice(i,1);break;}
  try{engSaveReg();}catch(e){engReg.dossiers=JSON.parse(bak);alert("Enregistrement impossible : "+errText(e));return;}
  engDosId=0;engDrafts=[];engRenderAll();engOk("Dossier supprime.");
}
function engDosRemoveSource(i){
  var d=engDosCur();if(!d)return;var s=d.sources[i];
  if(!s)return;
  if(s.cartes>0){alert("Des cartes ont ete emises a partir de ce projet : retrait impossible (annulez d'abord les cartes).");return;}
  if(!confirm("Retirer le projet "+s.no+" de ce dossier ?"))return;
  var bak=JSON.stringify(d.sources);d.sources.splice(i,1);
  try{engSaveReg();}catch(e){d.sources=JSON.parse(bak);alert("Enregistrement impossible : "+errText(e));return;}
  engRenderDos();
}
function engDosSourceStats(d,s){
  var i,o,k,n=0,net=0,hit,amt;
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];
    if(o.dossier!==d.no||(o.type!=="depense"&&o.type!=="economie"))continue;
    hit=false;amt=o.I;
    if(o.allocations&&o.allocations.length){
      amt=0;for(k=0;k<o.allocations.length;k++)if(String(o.allocations[k].projectNo)===String(s.no)){hit=true;amt=r2(amt+(Number(o.allocations[k].amount)||0));}
    }else if(o.projets){
      for(k=0;k<o.projets.length;k++)if(String(o.projets[k])===String(s.no))hit=true;
      if(hit&&o.parts)for(k=0;k<o.parts.length;k++)if(String(o.parts[k].p)===String(s.no))amt=o.parts[k].m;
    }else if(String(o.projet)===String(s.no))hit=true;
    if(hit){n++;net=r2(net+(o.type==="depense"?amt:-amt));}
  }
  return {n:n,net:net};
}
function engRenderDos(){
  var sel=$("engDosSel"),el=$("engDosInfo"),h=[],i,d,o,t,st,k,cnt;
  if(!sel)return;
  sel.options.length=0;
  o=document.createElement("option");o.value="0";o.text=engReg?"-- nouveau dossier --":"(ouvrez une annee)";sel.options.add(o);
  if(!engReg){el.innerHTML="";engDosFill(null);return;}
  for(i=0;i<engReg.dossiers.length;i++){d=engReg.dossiers[i];o=document.createElement("option");o.value=d.id;o.text=d.no+" - "+d.titre+(d.statut==="clos"?" [clos]":"");sel.options.add(o);}
  if(!engDosCur())engDosId=0;
  rpSetSelVal("engDosSel",String(engDosId));
  d=engDosCur();engDosFill(d);
  if($("engCardsDos"))$("engCardsDos").innerHTML=d?"Dossier actif : <b>"+esc(d.no)+"</b> "+esc(d.titre):"<span class=\"err\">Aucun dossier actif (onglet 0)</span>";
  /* source type list */
  t=$("engdSrcType");
  if(!t.options.length){for(k in ENG_SRC_TYPES)if(ENG_SRC_TYPES.hasOwnProperty(k)){o=document.createElement("option");o.value=k;o.text=ENG_SRC_TYPES[k].lab;if(!ENG_SRC_TYPES[k].ok)o.disabled=true;t.options.add(o);}}
  h.push('<table><tr><th>N&deg;</th><th>Titre</th><th>Statut</th><th>Projets importes</th><th>Cartes</th><th>Engage net</th></tr>');
  for(i=0;i<engReg.dossiers.length;i++){
    o=engReg.dossiers[i];cnt=0;st=0;
    for(k=0;k<o.sources.length;k++){var q=engDosSourceStats(o,o.sources[k]);cnt+=q.n;st=r2(st+q.net);}
    h.push('<tr'+(o.id===engDosId?' style="background:#fff3c4"':'')+'><td>'+esc(o.no)+'</td><td dir="auto">'+esc(o.titre)+'</td><td>'+esc(o.statut)+'</td><td>'+o.sources.length+'</td><td>'+cnt+'</td><td style="text-align:right">'+engFmt(st)+'</td></tr>');
  }
  h.push('</table>');
  if(d){
    h.push('<h4>Dossier '+esc(d.no)+' : projets importes</h4>');
    if(!d.sources.length)h.push('<p class="muted">Aucun projet importe : cochez des projets enregistres ci-dessus puis "Ajouter les projets coches".</p>');
    else{
      h.push('<p><button onclick="engDosPrepare()"><b>Preparer les cartes des projets coches</b></button> <span class="muted">(les montants sont totalises par matiere, mais chaque ligne conserve son projet et son corps)</span></p>');
      h.push('<table><tr><th>A engager</th><th>Type</th><th>Projet</th><th>Titre</th><th>Importe le</th><th>Montant calcule</th><th>Cartes</th><th>Engage net</th><th></th></tr>');
      for(i=0;i<d.sources.length;i++){
        o=d.sources[i];st=engDosSourceStats(d,o);o.cartes=st.n;
        h.push('<tr><td><input type="checkbox" id="engdS_'+i+'" '+(o.snap?'checked':'disabled')+'></td><td>'+esc((ENG_SRC_TYPES[o.type]||{lab:o.type}).lab)+'</td><td>'+esc(o.no)+'</td><td dir="auto">'+esc(o.titre)+'</td><td>'+esc(String(o.importe||"").substring(0,10))+'</td><td style="text-align:right">'+(o.snap?engFmt(o.snap.montant):'<span class="err">a reimporter</span>')+'</td><td>'+st.n+'</td><td style="text-align:right">'+engFmt(st.net)+'</td><td><button onclick="engDosRemoveSource('+i+')">Retirer</button></td></tr>');
      }
      h.push('</table>');
    }
  }
  el.innerHTML=h.join("");
  engRenderProjAvail();
}
var engProjAvail=[];
function engRenderProjAvail(){
  var el=$("engdProjList"),h=[],i,a,d=engDosCur(),inD,k,t;
  if(!el)return;
  try{engProjAvail=projList();}catch(e){engProjAvail=[];}
  if(!engProjAvail.length){el.innerHTML='<span class="muted">Aucun projet enregistre (onglet Rappel echelon, section 2b : "Enregistrer le projet").</span>';return;}
  h.push('<table><tr><th></th><th>Projet</th><th>Titre</th><th>Deja dans le dossier</th></tr>');
  for(i=0;i<engProjAvail.length;i++){
    a=engProjAvail[i];inD=false;if(d)for(k=0;k<d.sources.length;k++)if(d.sources[k].no===a.no)inD=true;
    h.push('<tr><td><input type="checkbox" id="engdP_'+i+'"></td><td>'+esc(a.no)+'</td><td dir="auto">'+esc(a.titre)+'</td><td>'+(inD?'<span class="ok">oui</span>':'')+'</td></tr>');
  }
  h.push('</table>');
  el.innerHTML=h.join("");
}
/* adds the project currently on screen (Rappel tab) to the dossier */
function engDosImport(){
  if(!engNeedReg())return;
  var d=engDosCur();
  if(!d){alert("Enregistrez ou choisissez d'abord un dossier d'engagement.");return;}
  if(d.statut==="clos"){alert("Ce dossier est clos.");return;}
  var type=$("engdSrcType").value,no=trim($("rpProjNo").value)||rpCurrentProject;
  if(!ENG_SRC_TYPES[type]||!ENG_SRC_TYPES[type].ok){alert("Ce type de projet n'est pas encore disponible.");return;}
  if(!curR){alert("Aucun resultat affiche : calculez le rappel dans l'onglet Rappel echelon, ou cochez des projets enregistres.");return;}
  if(!no){alert("Donnez un numero au projet en cours (section 2b, Enregistrer le projet).");return;}
  var bak=JSON.stringify(d.sources),snap=engSnapCur();snap.titre=trim($("rpTitle").value);
  engDosRegisterSource(d,type,no,snap.titre,snap);
  try{engSaveReg();}catch(e){d.sources=JSON.parse(bak);alert("Enregistrement impossible : "+errText(e));return;}
  engRenderDos();engOk("Projet "+no+" ajoute au dossier "+d.no+".");
}
function engDosRegisterSource(d,type,no,titre,snap){
  var i;
  for(i=0;i<d.sources.length;i++)if(d.sources[i].type===type&&d.sources[i].no===no){
    d.sources[i].titre=titre||d.sources[i].titre;
    if(snap)d.sources[i].snap=snap;
    return d.sources[i];
  }
  d.sources.push({type:type,no:no,titre:titre||"",importe:new Date().toISOString(),cartes:0,snap:snap||null});
  return d.sources[d.sources.length-1];
}
/* snapshot of the result currently held in curR: per rubrique x corps amounts (persisted in the dossier) */
function engSnapCur(){
  var d=curR,j,i,tot,rub,key,empBy={},cells={},ord=[],rubs=[],corps=[],seenC={},emp,code,v,ck,p=engPeriod();
  for(i=0;i<rpEmployees.length;i++)empBy["k"+String(rpEmployees[i].mat)]=rpEmployees[i];
  for(j=0;j<d.rubs.length;j++){
    if(d.rubKinds[j]==="ret")continue;
    tot=0;for(i=0;i<d.empTotals.length;i++)tot+=Number(d.empTotals[i].tot[j])||0;
    tot=r2(tot);if(Math.abs(tot)<0.005)continue;
    rub=d.rubs[j];key=lc(String(rub.code||rub.lib));
    rubs.push({key:key,code:rub.code||"",lib:rub.lib||"",arab:rub.arab?rub.arab:rubArabic(rub.code,rub.lib,false),kind:d.rubKinds[j],total:tot});
    for(i=0;i<d.empTotals.length;i++){
      v=Number(d.empTotals[i].tot[j])||0;if(Math.abs(v)<0.005)continue;
      emp=empBy["k"+String(d.empTotals[i].mat)];
      if(!emp)throw new Error("Allocation impossible pour la rubrique "+(rub.code||rub.lib)+": agent "+d.empTotals[i].mat+" absent de la liste source.");
      code=String(emp.corpsCode===undefined||emp.corpsCode===null?"":emp.corpsCode);
      if(!code)throw new Error("Allocation impossible pour la rubrique "+(rub.code||rub.lib)+": corps source manquant pour l'agent "+d.empTotals[i].mat+". Aucun montant ne sera redistribue.");
      if(!seenC["k"+code]){seenC["k"+code]=true;corps.push({code:code,name:emp.corpsName||""});}
      ck=key+"|"+code;
      if(!cells.hasOwnProperty(ck)){cells[ck]={k:key,c:code,m:0};ord.push(ck);}
      cells[ck].m=r2(cells[ck].m+v);
    }
  }
  var cl=[];for(i=0;i<ord.length;i++)cl.push(cells[ord[i]]);
  var snap={rubs:rubs,corps:corps,cells:cl,d1:p.d1,d2:p.d2,montant:r2(rubs.length?(function(){var t=0,q;for(q=0;q<rubs.length;q++)t+=rubs[q].total;return t;})():0)};
  var check=engValidateSnapshot(snap);
  if(!check.ok)throw new Error(check.msg);
  return snap;
}
/* A project snapshot is usable only when every rubric total reconciles to its own
   project x corps cells. Missing source allocations are never guessed or spread. */
function engValidateSnapshot(snap){
  var i,j,r,sum,found,cell,delta;
  if(!snap||!snap.rubs||!snap.cells)return {ok:false,msg:"Snapshot incomplet : rubriques ou allocations par corps absentes."};
  for(i=0;i<snap.rubs.length;i++){
    r=snap.rubs[i];sum=0;found=0;
    for(j=0;j<snap.cells.length;j++){
      cell=snap.cells[j];
      if(String(cell.k)===String(r.key)){sum+=Number(cell.m)||0;found++;}
    }
    delta=r2((Number(r.total)||0)-sum);
    if(!found||Math.abs(delta)>=0.01)
      return {ok:false,msg:"Montants non reconcilies pour la rubrique "+(r.code||r.lib)+": total source "+engFmt(r.total)+", somme des corps "+engFmt(sum)+". Le projet ne peut pas etre prepare tant que les donnees source ne fournissent pas la ventilation exacte."};
  }
  return {ok:true,msg:""};
}
/* loads a saved project into the Rappel tab, computes it and returns its snapshot */
function engLoadProjSnap(no){
  var f=projPathFor(no),st,r,snap;
  if(!f)throw new Error("Projet introuvable : "+no);
  st=projReadFile(f);
  if(!st||st.type!==PROJ_TYPE||!st.agents)throw new Error("Fichier de projet invalide : "+no);
  r=rpApplyState(st);
  if(!r.ok)throw new Error(r.msg||"ouverture impossible");
  $("rpProjNo").value=no;rpCurrentProject=no;
  curR=null;doRappel();
  if(!curR)throw new Error("calcul impossible (voir l'onglet Rappel echelon)");
  snap=engSnapCur();snap.titre=trim($("rpTitle").value)||st.titre||"";
  return snap;
}
function engDosAddProjects(){
  if(!engNeedReg())return;
  var d=engDosCur();
  if(!d){alert("Enregistrez ou choisissez d'abord un dossier d'engagement.");return;}
  if(d.statut==="clos"){alert("Ce dossier est clos.");return;}
  if(!conn){alert("Chargez d'abord la base principale (.mdb) : chaque projet est recalcule.");return;}
  var type=$("engdSrcType").value;
  if(!ENG_SRC_TYPES[type]||!ENG_SRC_TYPES[type].ok){alert("Ce type de projet n'est pas encore disponible.");return;}
  var list=[],i,el;
  for(i=0;i<engProjAvail.length;i++){el=$("engdP_"+i);if(el&&el.checked)list.push(engProjAvail[i]);}
  if(!list.length){alert("Cochez au moins un projet enregistre.");return;}
  if(!confirm("Calculer et ajouter "+list.length+" projet(s) au dossier "+d.no+" ?\n(L'onglet Rappel echelon affichera le dernier projet calcule.)"))return;
  var bak=JSON.stringify(d.sources),ok=[],bad=[],snap,ex,k,src;
  for(i=0;i<list.length;i++){
    ex=null;for(k=0;k<d.sources.length;k++)if(d.sources[k].type===type&&d.sources[k].no===list[i].no)ex=d.sources[k];
    if(ex&&engDosSourceStats(d,ex).n>0){bad.push(list[i].no+" (cartes deja emises : non recalcule)");continue;}
    try{snap=engLoadProjSnap(list[i].no);engDosRegisterSource(d,type,list[i].no,snap.titre||list[i].titre,snap);ok.push(list[i].no);}
    catch(e){bad.push(list[i].no+" ("+errText(e)+")");}
  }
  try{engSaveReg();}catch(e2){d.sources=JSON.parse(bak);alert("Enregistrement impossible : "+errText(e2));engRenderDos();return;}
  engRenderDos();
  engMsg((ok.length?'<span class="ok">'+ok.length+' projet(s) ajoute(s) : '+esc(ok.join(", "))+'.</span>':'')+(bad.length?' <span class="err">Non ajoutes : '+esc(bad.join(" | "))+'</span>':''));
}
/* ---------- 1. credits ---------- */
var engCreditArts=[];
function engRenderCredits(){
  var el=$("engCreditTable"),h=[],i,a,k,st,ops,op0;
  if(!engReg){el.innerHTML='<p class="muted">Ouvrez une annee financiere.</p>';return;}
  $("engDecNo").value=engReg.decision.no||"";$("engDecDate").value=engReg.decision.date||"";
  var en=engCfg.entete;$("engH1").value=en.l1;$("engH2").value=en.l2;$("engH3").value=en.l3;$("engH4").value=en.l4;
  engCreditArts=engArtsSorted();
  h.push('<table><tr><th>Article</th><th>Libelle de la matiere</th><th>Credit (rukhsat el iltizam)</th><th>Etat</th></tr>');
  for(i=0;i<engCreditArts.length;i++){
    a=engCreditArts[i];k=engArtKey(a);st=engStateOf(k,engReg.ops);
    h.push('<tr><td>'+esc(k)+'</td><td dir="rtl" style="text-align:right">'+esc(a.mt)+'</td>');
    if(st){
      op0=null;ops=engReg.ops;for(var q=0;q<ops.length;q++)if(ops[q].art===k&&ops[q].type==="ouverture"){op0=ops[q];break;}
      h.push('<td style="text-align:right">'+engFmt(op0?op0.I:st.E)+'</td><td class="ok">ouvert (carte N&deg;1'+(op0?', '+esc(engDisp(op0.date)):'')+')</td>');
    }else h.push('<td><input id="engc_'+i+'" size="16" style="text-align:right"></td><td class="muted">non ouvert</td>');
    h.push('</tr>');
  }
  h.push('</table>');
  el.innerHTML=h.join("");
}
function engSaveDecision(){
  if(!engNeedReg())return;
  engReg.decision.no=trim($("engDecNo").value);engReg.decision.date=trim($("engDecDate").value);
  try{engSaveReg();engOk("Decision de notification enregistree.");}catch(e){engErr("Enregistrement impossible : "+errText(e));}
}
function engSaveEntete(){
  try{
    engCfg.entete={l1:trim($("engH1").value),l2:trim($("engH2").value),l3:trim($("engH3").value),l4:trim($("engH4").value)};
    engSaveCfg();engOk("Entete des cartes enregistree.");
  }catch(e){engErr("Enregistrement impossible : "+errText(e));}
}
function engImportPaste(){
  var lines=String($("engPaste").value).split(/\r?\n/),i,m,n=0,bad=[],idx,j;
  for(i=0;i<lines.length;i++){
    if(!trim(lines[i]))continue;
    m=/^\s*(\d+\.\d+\.\d+)\s*[;\t: ]+\s*([\d\s.,]+)\s*$/.exec(lines[i]);
    if(!m){bad.push(lines[i]);continue;}
    idx=-1;for(j=0;j<engCreditArts.length;j++)if(engArtKey(engCreditArts[j])===m[1])idx=j;
    if(idx<0||!$("engc_"+idx)){bad.push(lines[i]+" (article inconnu ou deja ouvert)");continue;}
    $("engc_"+idx).value=m[2].replace(/\s/g,"");n++;
  }
  engMsg('<span class="ok">'+n+' credit(s) importe(s) dans le tableau.</span>'+(bad.length?' <span class="err">Ignorees : '+esc(bad.join(" | "))+'</span>':''));
}
function engOpenObj(){
  var y=engReg.annee,d=engReg.decision;
  return "الأخذ بالحساب\nالتكفل بالإعتمادات المالية المفتوحة لسنة "+y+" .\nمقرر رقم : "+(d.no||"..........")+" مؤرخ في: "+(d.date||"..........")+"\nيتضمن تبليغ إعانة الدولة لسنة "+y+"\nلـ: "+engCfg.entete.l4;
}
function engEmitOpenings(doPrint){
  if(!engNeedReg())return;
  var i,v,k,list=[],dateIso=engParseDateInput($("engDate").value);
  if(!dateIso){alert("Date de l'operation invalide (jj/mm/aaaa).");return;}
  for(i=0;i<engCreditArts.length;i++){
    k=engArtKey(engCreditArts[i]);
    if(engStateOf(k,engReg.ops)||!$("engc_"+i))continue;
    v=engNum($("engc_"+i).value);
    if(v>0)list.push({art:k,I:r2(v)});
  }
  if(!list.length){alert("Saisissez au moins un credit (matiere non ouverte).");return;}
  if(!engReg.decision.no&&!confirm("Numero/date de la decision de notification non renseignes. Continuer ?"))return;
  if(!confirm("Emettre "+list.length+" carte(s) d'ouverture de credit ?"))return;
  var n0=engReg.ops.length,seq0=engReg.seq,out=[],op,c,obj=engOpenObj();
  try{
    for(i=0;i<list.length;i++){
      c=engCalc(null,"ouverture",list[i].I);
      op={id:++engReg.seq,art:list[i].art,num:1,type:"ouverture",date:dateIso,I:c.I,E:c.E,F:c.F,G:c.G,K:c.K,projet:"",titreProjet:"",objet:obj,lignes:[],statut:"emise",ts:new Date().toISOString()};
      engReg.ops.push(op);out.push(op);
    }
    engSaveReg();
  }catch(e){engReg.ops.length=n0;engReg.seq=seq0;alert("Enregistrement impossible : "+errText(e));return;}
  engRenderAll();engOk(out.length+" carte(s) d'ouverture emise(s).");
  if(doPrint)engOpenHtml(out);
}
function engAddArticle(){
  var t=parseInt($("engaT").value,10),b=parseInt($("engaB").value,10),m=parseInt($("engaM").value,10),bt=trim($("engaBt").value),mt=trim($("engaMt").value),a,k,i;
  if(isNaN(b)||isNaN(m)||!bt||!mt){alert("Renseignez le numero et le texte du Bab et de la Mada.");return;}
  k=t+"."+b+"."+m;a=engArt(k);
  if(a){a.bt=bt;a.mt=mt;}else engCfg.articles.push({t:t,b:b,m:m,bt:bt,mt:mt});
  try{engSaveCfg();engRenderAll();engOk("Article "+k+(a?" modifie.":" ajoute."));}catch(e){engErr("Enregistrement impossible : "+errText(e));}
}

/* ---------- 2. cards to issue (from a project, or manual) ---------- */
function engPeriod(){
  var rc=curR.recap,i,s,pp,k1=null,k2=null,d1="",d2="",pd,y,m,ld;
  for(i=0;i<rc.length;i++){
    pd=rpParseDate(rv(rc[i][5]).split(" / ")[0]);
    if(pd){s=pd.y*10000+pd.m*100+pd.d;if(k1===null||s<k1){k1=s;d1=pd.y+"/"+rpPad(pd.m)+"/"+rpPad(pd.d);}}
    pp=rpParsePer(rv(rc[i][6]));
    if(pp){s=pp.y*12+pp.m;if(k2===null||s>k2){k2=s;ld=new Date(pp.y,pp.m,0).getDate();d2=pp.y+"/"+rpPad(pp.m)+"/"+rpPad(ld);}}
  }
  return {d1:d1,d2:d2};
}
function engPrepareFromProject(){engSub("dos");}
function engDosPrepare(){
  if(!engNeedReg())return;
  var dos=engDosCur(),i,j,k,src,rows={},ord=[],srcs=[],cr=[],seenC={},sn,r,rub,saved,sel,key,c;
  if(!dos){alert("Choisissez d'abord un dossier d'engagement.");return;}
  if(dos.statut==="clos"){alert("Ce dossier est clos.");return;}
  for(i=0;i<dos.sources.length;i++){
    if($("engdS_"+i)&&$("engdS_"+i).checked&&dos.sources[i].snap)srcs.push(dos.sources[i]);
  }
  if(!srcs.length){alert("Cochez au moins un projet a engager dans la liste du dossier.");return;}
  for(i=0;i<srcs.length;i++){
    sn=srcs[i].snap;
    var snapCheck=engValidateSnapshot(sn);
    if(!snapCheck.ok){alert("Projet "+srcs[i].no+" : "+snapCheck.msg);return;}
    for(j=0;j<sn.rubs.length;j++){
      r=sn.rubs[j];
      if(!rows.hasOwnProperty("k"+r.key)){rows["k"+r.key]={key:r.key,lib:r.lib,code:r.code,arab:r.arab,kind:r.kind,total:0,sel:"",guessed:false};ord.push("k"+r.key);}
      rows["k"+r.key].total=r2(rows["k"+r.key].total+r.total);
    }
    for(k=0;k<sn.corps.length;k++){
      c=sn.corps[k];
      if(seenC["k"+c.code])continue;seenC["k"+c.code]=true;
      cr.push({code:c.code,name:c.name,label:engCfg.corps.hasOwnProperty("k"+c.code)?engCfg.corps["k"+c.code]:(c.name||"")});
    }
  }
  engMapRows=[];
  for(i=0;i<ord.length;i++){
    r=rows[ord[i]];
    saved=engCfg.rubriques.hasOwnProperty(r.key)?engCfg.rubriques[r.key]:null;
    r.sel=(saved!==null)?saved:engGuessArticle({lib:r.lib,code:r.code},r.kind,r.arab);
    r.guessed=(saved===null&&r.sel!=="");
    engMapRows.push(r);
  }
  engMapCorps=cr;engProjCtx={dosId:dos.id,srcs:srcs};
  engSub("cards");engRenderMap();
}
function engArtOptions(sel){
  var a=engArtsSorted(),i,k,h='<option value=""'+(sel===""?' selected':'')+'>-- choisir --</option><option value="-"'+(sel==="-"?' selected':'')+'>Ne pas engager (ignorer)</option>';
  for(i=0;i<a.length;i++){k=engArtKey(a[i]);h+='<option value="'+k+'"'+(sel===k?' selected':'')+'>'+k+' - '+esc(a[i].mt)+'</option>';}
  return h;
}
function engRenderMap(){
  var h=['<div class="box"><b>Dossier '+esc((engDosById(engProjCtx.dosId)||{no:""}).no)+' &larr; '+engProjCtx.srcs.length+' projet(s) : '+esc((function(){var a=[],q;for(q=0;q<engProjCtx.srcs.length;q++)a.push(engProjCtx.srcs[q].no);return a.join(", ");})())+'</b> - rattachez chaque Rubrique a sa matiere. Les montants ci-dessous proviennent des snapshots propres a chaque projet ; aucune ventilation n est estimee.',
    '<table><tr><th>Rubrique</th><th>Total cumule</th><th>Ventilation importee par projet et corps</th><th>Matiere de la carte</th></tr>'],i,r,k,src,sn,cell,lines,sum,lab;
  for(i=0;i<engMapRows.length;i++){
    r=engMapRows[i];lines=[];sum=0;
    for(k=0;k<engProjCtx.srcs.length;k++){
      src=engProjCtx.srcs[k];sn=src.snap;
      for(var z=0;z<sn.cells.length;z++){
        cell=sn.cells[z];if(String(cell.k)!==String(r.key))continue;
        if(Math.abs(Number(cell.m)||0)<0.005)continue;
        lab="(corps non identifie)";
        for(var c=0;c<sn.corps.length;c++)if(String(sn.corps[c].code)===String(cell.c)){
          lab=engCfg.corps.hasOwnProperty("k"+cell.c)?engCfg.corps["k"+cell.c]:(sn.corps[c].name||cell.c);break;
        }
        lines.push('<tr><td>'+esc(src.no+(src.titre?" - "+src.titre:""))+'</td><td>'+esc(lab)+'</td><td style="text-align:right">'+engFmt(cell.m)+'</td></tr>');
        sum=r2(sum+(Number(cell.m)||0));
      }
    }
    h.push('<tr><td dir="rtl" style="text-align:right">'+esc(r.arab)+'<br><span class="muted">'+esc(r.lib)+'</span></td><td style="text-align:right"><b>'+engFmt(r.total)+'</b></td><td><table style="width:100%"><tr><th>Projet</th><th>Corps</th><th>Montant importe</th></tr>'+lines.join("")+'<tr class="foot"><td colspan="2">Total ventile</td><td style="text-align:right">'+engFmt(sum)+'</td></tr></table></td><td><select id="engmap_'+i+'" style="max-width:520px">'+engArtOptions(r.sel)+'</select>'+(r.guessed?' <span class="muted">(suggestion)</span>':'')+'</td></tr>');
  }
  h.push('</table><p><b>Libelle des corps sur la carte</b> (en arabe, enregistre une fois)</p><table><tr><th>Corps (base)</th><th>Libelle sur la carte</th></tr>');
  for(i=0;i<engMapCorps.length;i++){
    h.push('<tr><td>'+esc(engMapCorps[i].name||engMapCorps[i].code||"(sans corps)")+'</td><td><input id="engmc_'+i+'" size="50" dir="rtl" value="'+esc(engMapCorps[i].label)+'"></td></tr>');
  }
  h.push('</table><p><button onclick="engMapValidate()">Valider et preparer les cartes</button> <button onclick="$(\'engMap\').innerHTML=\'\'">Fermer</button></p></div>');
  $("engMap").innerHTML=h.join("");
}
function engMapValidate(){
  var i,v,bad=0;
  for(i=0;i<engMapRows.length;i++){v=$("engmap_"+i).value;if(v==="")bad++;engMapRows[i].sel=v;}
  if(bad){alert("Choisissez une matiere (ou 'Ne pas engager') pour chaque Rubrique.");return;}
  for(i=0;i<engMapRows.length;i++)engCfg.rubriques[engMapRows[i].key]=engMapRows[i].sel;
  for(i=0;i<engMapCorps.length;i++){
    v=trim($("engmc_"+i).value);engMapCorps[i].label=v;
    if(v&&v!==engMapCorps[i].name)engCfg.corps["k"+engMapCorps[i].code]=v;else delete engCfg.corps["k"+engMapCorps[i].code];
  }
  try{engSaveCfg();}catch(e){engErr("Correspondances non enregistrees : "+errText(e));}
  engBuildDrafts();
  $("engMap").innerHTML="";
}
function engBuildDrafts(){
  /* Build each card from source-project cells. Never merge different projects
     into a single corps line: projectNo + corpsCode is the allocation key. */
  var byArt={},order=[],i,j,r,g,k,s,cell,cl={},out=[],L,a,tot,dos=engDosById(engProjCtx.dosId),lab,ck,
      nos,tit,d1,d2,arSet,ar,m,q,selByKey={},srcKey,allocMap,allocOrder,al,projectAmounts,projectOrder;
  for(i=0;i<engMapCorps.length;i++)cl["k"+engMapCorps[i].code]=engMapCorps[i].label||engMapCorps[i].name;
  for(j=0;j<engMapRows.length;j++){r=engMapRows[j];if(r.sel!==""&&r.sel!=="-")selByKey[r.key]=r.sel;}
  for(k=0;k<engProjCtx.srcs.length;k++){
    s=engProjCtx.srcs[k];
    var sourceCheck=engValidateSnapshot(s.snap);
    if(!sourceCheck.ok){alert("Projet "+s.no+" : "+sourceCheck.msg);return;}
    srcKey=String(s.type||"")+"|"+String(s.no||k);
    for(j=0;j<s.snap.cells.length;j++){
      cell=s.snap.cells[j];
      if(!selByKey.hasOwnProperty(cell.k))continue;
      a=selByKey[cell.k];
      /* Keep every checked source allocation in the draft/printed card.
         Duplicate-card prevention remains centralized in engDraftDup() and
         engEmitDrafts(); it must not silently alter the allocation matrix. */
      if(!byArt.hasOwnProperty("k"+a)){
        byArt["k"+a]={art:a,alloc:{},allocOrder:[],srcs:{},sord:[]};order.push(a);
      }
      g=byArt["k"+a];
      lab=cl.hasOwnProperty("k"+cell.c)?cl["k"+cell.c]:"(sans corps)";
      ck=srcKey+"|"+String(cell.c||"");
      if(!g.alloc.hasOwnProperty(ck)){
        g.alloc[ck]={projectNo:String(s.no||""),projectTitle:String(s.titre||""),sourceType:String(s.type||""),
          corpsCode:String(cell.c||""),corpsLabel:lab,amount:0};
        g.allocOrder.push(ck);
      }
      g.alloc[ck].amount=r2(g.alloc[ck].amount+(Number(cell.m)||0));
      if(!g.srcs.hasOwnProperty("k"+s.no)){
        g.srcs["k"+s.no]={s:s,m:0};g.sord.push("k"+s.no);
      }
      g.srcs["k"+s.no].m=r2(g.srcs["k"+s.no].m+(Number(cell.m)||0));
    }
  }
  order.sort(function(x,y){var a1=x.split("."),b1=y.split(".");return (a1[0]-b1[0])||(a1[1]-b1[1])||(a1[2]-b1[2]);});
  for(i=0;i<order.length;i++){
    g=byArt["k"+order[i]];L=[];tot=0;allocMap=[];projectAmounts={};projectOrder=[];
    for(j=0;j<g.allocOrder.length;j++){
      al=g.alloc[g.allocOrder[j]];al.amount=r2(al.amount);
      if(Math.abs(al.amount)<0.005)continue;
      allocMap.push({projectNo:al.projectNo,projectTitle:al.projectTitle,sourceType:al.sourceType,
        corpsCode:al.corpsCode,corpsLabel:al.corpsLabel,amount:al.amount});
      L.push({l:al.corpsLabel,m:al.amount,projectNo:al.projectNo,projectTitle:al.projectTitle,
        corpsCode:al.corpsCode,corpsLabel:al.corpsLabel});
      tot=r2(tot+al.amount);
      ck="k"+al.projectNo;
      if(!projectAmounts.hasOwnProperty(ck)){projectAmounts[ck]={p:al.projectNo,t:al.projectTitle,m:0};projectOrder.push(ck);}
      projectAmounts[ck].m=r2(projectAmounts[ck].m+al.amount);
    }
    if(!allocMap.length)continue;
    nos=[];tit=[];var parts=[];arSet={};d1="";d2="";
    for(j=0;j<g.sord.length;j++){
      m=g.srcs[g.sord[j]];
      if(Math.abs(m.m)<0.005)continue;
      nos.push(String(m.s.no));tit.push(m.s.no+(m.s.titre?" : "+m.s.titre:""));
      parts.push({p:String(m.s.no),m:r2(m.m)});
      arSet[(ENG_SRC_TYPES[m.s.type]||{ar:""}).ar]=true;
      if(m.s.snap.d1&&(!d1||m.s.snap.d1<d1))d1=m.s.snap.d1;
      if(m.s.snap.d2&&(!d2||m.s.snap.d2>d2))d2=m.s.snap.d2;
    }
    ar=[];for(q in arSet)if(arSet.hasOwnProperty(q)&&q)ar.push(q);
    a=engArt(order[i]);
    out.push({art:order[i],type:"depense",auto:true,I:r2(tot),lignes:L,allocations:allocMap,sel:true,src:"projet",
      srcType:engProjCtx.srcs[0].type,dossierId:dos.id,dossier:dos.no,dossierTitre:dos.titre,
      projet:nos.length===1?nos[0]:nos.join(" + "),projets:nos,parts:parts,
      titreProjet:tit.join(" | "),
      objet:(a?a.mt:"")+" - "+ar.join(" / ")+"\nمشاريع رقم : "+tit.join(" ، ")+(d1?"\nللفترة من "+d1+" إلى "+d2:"")+(dos.objet?"\n"+dos.objet:"")});
  }
  var keep=[];for(i=0;i<engDrafts.length;i++)if(!(engDrafts[i].src==="projet"&&engDrafts[i].dossierId===dos.id))keep.push(engDrafts[i]);
  engDrafts=keep.concat(out);
  engRenderDrafts();
  engMsg('<span class="ok">'+out.length+' carte(s) preparee(s) a partir de '+engProjCtx.srcs.length+' projet(s) du dossier '+esc(dos.no)+' (allocations par projet et par corps conservees).</span>'+(out.length?'':' <span class="err">Rien a engager : les projets coches ont deja des cartes actives sur ces matieres, ou toutes les rubriques sont ignorees.</span>'));
}
function engAddManual(){
  if(!engNeedReg())return;
  var art=$("engmArt").value,type=$("engmType").value,amt=engNum($("engmAmt").value),obj=trim($("engmObj").value),lines=String($("engmLines").value).split(/\r?\n/),L=[],i,p,m;
  if(!art){alert("Choisissez la matiere.");return;}
  if(!(amt>0)){alert("Saisissez un montant positif.");return;}
  for(i=0;i<lines.length;i++){
    if(!trim(lines[i]))continue;
    p=lines[i].split(";");
    m=p.length>1?engNum(p[p.length-1]):null;
    L.push({l:trim(p.length>1?p.slice(0,p.length-1).join(";"):lines[i]),m:(m===null||m===0)?null:m});
  }
  engDrafts.push({art:art,type:type,auto:false,I:amt,lignes:L,sel:true,src:"manuel",srcType:"manuel",dossierId:engDosId,dossier:(engDosCur()||{no:""}).no,dossierTitre:(engDosCur()||{titre:""}).titre,projet:trim($("engmProj").value),titreProjet:"",objet:obj});
  engRenderDrafts();engOk("Carte manuelle ajoutee a la liste.");
}
function engRecalcDrafts(){
  var i,j,d,s;
  for(i=0;i<engDrafts.length;i++){
    d=engDrafts[i];
    if(d.auto){s=0;for(j=0;j<d.lignes.length;j++)s+=(d.lignes[j].m||0);d.I=r2(s);}
  }
}
function engRenderDrafts(){
  var el=$("engDrafts"),sim,i,j,d,c,h=[],l,a,w;
  if(!engReg){el.innerHTML='<p class="muted">Ouvrez une annee financiere.</p>';return;}
  if(!engDrafts.length){el.innerHTML='<p class="muted">Aucune carte en preparation.</p>';return;}
  engRecalcDrafts();sim=engSimulate();
  for(i=0;i<engDrafts.length;i++){
    d=engDrafts[i];c=sim[i];a=engArt(d.art);w=[];
    if(d.type==="depense"&&engDraftDup(d))w.push("Une carte active existe deja pour ce projet et cette matiere (annulez-la d'abord).");
    if(c&&c.err)w.push(c.err);else if(c&&c.K<0)w.push("Solde negatif apres cette carte.");
    h.push('<div class="box" style="margin:6px 0"><label><input type="checkbox" '+(d.sel?'checked ':'')+'onclick="engDraftSel('+i+',this.checked)"> <b>'+esc(d.art)+' - '+esc(a?a.mt:"")+'</b></label> <span class="muted">['+esc(ENG_TYPES[d.type])+(d.projet?' - '+(d.projets&&d.projets.length>1?'projets ':'projet ')+esc(d.projet):'')+']</span> <button onclick="engDraftRemove('+i+')">Retirer</button>');
    if(c&&!c.err)h.push('<div>N&deg; <b>'+c.num+'</b> &nbsp; E: '+engFmt(c.E)+' &nbsp; F: '+engFmt(c.F)+' &nbsp; G: '+engFmt(c.G)+' &nbsp; I: <b>'+engFmt(c.I)+'</b> &nbsp; K: <b'+(c.K<0?' class="err"':'')+'>'+engFmt(c.K)+'</b></div>');
    else if(!d.sel)h.push('<div class="muted">(non selectionnee)</div>');
    if(w.length)h.push('<div class="err">'+esc(w.join(" | "))+'</div>');
    h.push('<div class="muted">Dossier : '+(d.dossier?esc(d.dossier+" - "+(d.dossierTitre||"")):"(aucun)")+'</div>');
    if(!d.auto)h.push('<div>Montant : <input size="14" style="text-align:right" value="'+esc(String(d.I))+'" onchange="engDraftSet('+i+',\'I\',this.value)"></div>');
    h.push('<div>Objet :<br><textarea rows="3" cols="95" dir="rtl" onchange="engDraftSet('+i+',\'objet\',this.value)">'+esc(d.objet||"")+'</textarea></div>');
    h.push('<table dir="rtl"><tr><th>المشروع</th><th>السلك</th><th>المبلغ</th><th></th></tr>');
    for(j=0;j<d.lignes.length;j++){
      l=d.lignes[j];
      if(l.projectNo!==undefined)h.push('<tr><td>'+esc(l.projectNo+(l.projectTitle?' - '+l.projectTitle:''))+'</td><td>'+esc(l.corpsLabel||l.l)+'</td><td style="text-align:right">'+engFmt(l.m||0)+'</td><td></td></tr>');
      else h.push('<tr><td colspan="2"><input size="60" dir="rtl" value="'+esc(l.l)+'" onchange="engDraftLine('+i+','+j+',\'l\',this.value)"></td><td><input size="14" style="text-align:right" value="'+(l.m===null||l.m===undefined?'':esc(String(l.m)))+'" onchange="engDraftLine('+i+','+j+',\'m\',this.value)"></td><td><button onclick="engDraftDelLine('+i+','+j+')">x</button></td></tr>');
    }
    h.push('</table>'+(d.allocations&&d.allocations.length?'':'<button onclick="engDraftAddLine('+i+')">+ ligne</button>')+'</div>');
  }
  el.innerHTML=h.join("");
}
function engDraftSel(i,v){engDrafts[i].sel=!!v;engRenderDrafts();}
function engDraftRemove(i){engDrafts.splice(i,1);engRenderDrafts();}
function engDraftSet(i,f,v){engDrafts[i][f]=(f==="I")?engNum(v):v;engRenderDrafts();}
function engDraftLine(i,j,f,v){
  if(f==="m"){var x=trim(v);engDrafts[i].lignes[j].m=x===""?null:engNum(x);}else engDrafts[i].lignes[j].l=v;
  engRenderDrafts();
}
function engDraftAddLine(i){engDrafts[i].lignes.push({l:"",m:engDrafts[i].auto?0:null});engRenderDrafts();}
function engDraftDelLine(i,j){engDrafts[i].lignes.splice(j,1);engRenderDrafts();}
function engCopyLines(L){var o=[],i,x;for(i=0;i<L.length;i++){x={l:L[i].l,m:(L[i].m===undefined?null:L[i].m)};if(L[i].projectNo!==undefined)x.projectNo=L[i].projectNo;if(L[i].projectTitle!==undefined)x.projectTitle=L[i].projectTitle;if(L[i].corpsCode!==undefined)x.corpsCode=L[i].corpsCode;if(L[i].corpsLabel!==undefined)x.corpsLabel=L[i].corpsLabel;o.push(x);}return o;}
function engCopyAllocations(A){var o=[],i,x;if(!A)return null;for(i=0;i<A.length;i++){x=A[i];o.push({projectNo:x.projectNo,projectTitle:x.projectTitle||"",sourceType:x.sourceType||"",corpsCode:x.corpsCode||"",corpsLabel:x.corpsLabel||"",amount:r2(Number(x.amount)||0)});}return o;}
function engEmitDrafts(doPrint){
  if(!engNeedReg())return;
  engRecalcDrafts();
  var sim=engSimulate(),i,d,c,errs=[],neg=[],dups=[],sel=[],dateIso=engParseDateInput($("engDate").value),lab;
  if(!dateIso){alert("Date de l'operation invalide (jj/mm/aaaa).");return;}
  for(i=0;i<engDrafts.length;i++){
    d=engDrafts[i];if(!d.sel)continue;
    c=sim[i];sel.push(i);lab=d.art+" ("+ENG_TYPES[d.type]+")";
    if(c.err){errs.push(lab+" : "+c.err);continue;}
    if(c.K<0)neg.push(lab+" : solde "+engFmt(c.K));
    if(d.allocations&&d.allocations.length){var allocTotal=0,ai;for(ai=0;ai<d.allocations.length;ai++)allocTotal=r2(allocTotal+(Number(d.allocations[ai].amount)||0));if(Math.abs(r2(allocTotal)-r2(d.I))>=0.01)errs.push(lab+" : total des allocations par projet different du montant de la carte.");}
    if(d.type==="depense"&&engDraftDup(d))dups.push(lab);
  }
  if(!sel.length){alert("Aucune carte selectionnee.");return;}
  if(errs.length){alert("Emission impossible :\n"+errs.join("\n"));return;}
  if(dups.length){alert("Deja emis pour ce projet (annulez d'abord la carte existante) :\n"+dups.join("\n"));return;}
  if(neg.length&&!confirm("Solde negatif apres emission :\n"+neg.join("\n")+"\n\nEmettre quand meme ?"))return;
  if(!confirm("Emettre "+sel.length+" carte(s) ? Elles seront enregistrees dans le registre "+engReg.annee+" et ne seront plus modifiables."))return;
  var n0=engReg.ops.length,seq0=engReg.seq,out=[],op,emitted={};
  try{
    for(i=0;i<sel.length;i++){
      d=engDrafts[sel[i]];c=sim[sel[i]];
      op={id:++engReg.seq,art:d.art,num:c.num,type:d.type,date:dateIso,I:c.I,E:c.E,F:c.F,G:c.G,K:c.K,projet:d.projet||"",projets:d.projets||null,parts:d.parts||null,allocations:engCopyAllocations(d.allocations),titreProjet:d.titreProjet||"",dossier:d.dossier||"",dossierTitre:d.dossierTitre||"",srcType:d.srcType||"",objet:d.objet||"",lignes:engCopyLines(d.lignes),statut:"emise",ts:new Date().toISOString()};
      engReg.ops.push(op);out.push(op);emitted["k"+sel[i]]=true;
    }
    var dbak=JSON.stringify(engReg.dossiers),dd;
    
    engSaveReg();
  }catch(e){engReg.ops.length=n0;engReg.seq=seq0;try{engReg.dossiers=JSON.parse(dbak);}catch(e9){}alert("Enregistrement impossible : "+errText(e));return;}
  var keep=[];for(i=0;i<engDrafts.length;i++)if(!emitted["k"+i])keep.push(engDrafts[i]);
  engDrafts=keep;
  engRenderAll();engOk(out.length+" carte(s) emise(s) et enregistree(s) (N° "+out[0].num+(out.length>1?" ...":"")+").");
  if(doPrint)engOpenHtml(out);
}
function engPreviewDrafts(){
  if(!engNeedReg())return;
  engRecalcDrafts();
  var sim=engSimulate(),i,d,c,ops=[],dateIso=engParseDateInput($("engDate").value)||engIso(new Date());
  for(i=0;i<engDrafts.length;i++){
    d=engDrafts[i];c=sim[i];if(!d.sel||!c||c.err)continue;
    ops.push({id:0,art:d.art,num:c.num,type:d.type,date:dateIso,I:c.I,E:c.E,F:c.F,G:c.G,K:c.K,projet:d.projet,projets:d.projets||null,parts:d.parts||null,allocations:engCopyAllocations(d.allocations),dossier:d.dossier,dossierTitre:d.dossierTitre,objet:d.objet,lignes:d.lignes});
  }
  if(!ops.length){alert("Aucune carte valide a afficher.");return;}
  engOpenHtml(ops);
}
function engOpenHtml(ops){
  try{
    var dt=new Date(),stamp=dt.getFullYear()+rpPad(dt.getMonth()+1)+rpPad(dt.getDate())+"-"+rpPad(dt.getHours())+rpPad(dt.getMinutes())+rpPad(dt.getSeconds());
    var path=saveFile("Cartes_engagement_"+engReg.annee+"_"+stamp+".html",engPageHtml(ops,$("engPrintDate").checked));
    engMsg('<span class="ok">Cartes pretes : '+esc(path)+'</span> <span class="muted">(ouvertes dans le navigateur : Imprimer, A4 portrait)</span>');
    try{sh.Run('"'+path+'"',1,false);}catch(x){}
  }catch(e){engErr("Impression impossible : "+errText(e));}
}

/* ---------- 3. register ---------- */
function engRenderReg(){
  var el=$("engRegTable"),h=[],i,o,f=$("engFilterArt")?$("engFilterArt").value:"",st;
  if(!engReg){el.innerHTML='<p class="muted">Ouvrez une annee financiere.</p>';return;}
  h.push('<table><tr><th></th><th>Article</th><th>N&deg;</th><th>Type</th><th>Date</th><th>E</th><th>F</th><th>G</th><th>I</th><th>K</th><th>Dossier</th><th>Projet</th><th>Statut</th><th></th></tr>');
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];
    if(f&&o.art!==f)continue;
    st=o.annulee_par?"annulee":(o.annulation_de?"annulation":"emise");
    h.push('<tr><td><input type="checkbox" id="engr_'+o.id+'"></td><td>'+esc(o.art)+'</td><td>'+o.num+'</td><td>'+esc(ENG_TYPES[o.type])+'</td><td>'+esc(engDisp(o.date))+'</td><td style="text-align:right">'+engFmt(o.E)+'</td><td style="text-align:right">'+engFmt(o.F)+'</td><td style="text-align:right">'+engFmt(o.G)+'</td><td style="text-align:right"><b>'+engFmt(o.I)+'</b></td><td style="text-align:right"'+(o.K<0?' class="err"':'')+'>'+engFmt(o.K)+'</td><td>'+esc(o.dossier||"")+'</td><td>'+esc(o.projet||"")+'</td><td class="'+(st==="annulee"?'err':'muted')+'">'+st+'</td><td>'+((o.statut==="emise"&&!o.annulee_par&&!o.annulation_de&&o.type!=="ouverture")?'<button onclick="engAnnul('+o.id+')">Annuler</button>':'')+'</td></tr>');
  }
  h.push('</table>');
  el.innerHTML=h.join("");
}
function engFillFilter(){
  var s=$("engFilterArt"),a=engArtsSorted(),i,o,v=s.value;
  s.options.length=0;o=document.createElement("option");o.value="";o.text="(toutes les matieres)";s.options.add(o);
  for(i=0;i<a.length;i++){o=document.createElement("option");o.value=engArtKey(a[i]);o.text=engArtKey(a[i])+" - "+a[i].mt;s.options.add(o);}
  rpSetSelVal("engFilterArt",v);
}
function engPrintSelected(){
  if(!engNeedReg())return;
  var ops=[],i;
  for(i=0;i<engReg.ops.length;i++)if($("engr_"+engReg.ops[i].id)&&$("engr_"+engReg.ops[i].id).checked)ops.push(engReg.ops[i]);
  if(!ops.length){alert("Cochez au moins une operation.");return;}
  engOpenHtml(ops);
}
function engAnnul(id){
  var i,op=null,st,c,opp,nop,n0,seq0,dateIso;
  for(i=0;i<engReg.ops.length;i++)if(engReg.ops[i].id===id)op=engReg.ops[i];
  if(!op||op.annulee_par||op.annulation_de||op.type==="ouverture")return;
  opp=ENG_OPP[op.type];st=engStateOf(op.art,engReg.ops);c=engCalc(st,opp,op.I);
  if(c.err){alert(c.err);return;}
  if(!confirm("Annuler la carte N° "+op.num+" ("+op.art+", "+engFmt(op.I)+") ?\nUne carte inverse N° "+(st.num+1)+" sera emise et enregistree."+(c.K<0?"\n\nAttention : solde negatif apres annulation.":"")))return;
  dateIso=engParseDateInput($("engDate").value)||engIso(new Date());
  n0=engReg.ops.length;seq0=engReg.seq;
  nop={id:++engReg.seq,art:op.art,num:st.num+1,type:opp,date:dateIso,I:op.I,E:c.E,F:c.F,G:c.G,K:c.K,projet:op.projet,projets:op.projets||null,parts:op.parts||null,allocations:engCopyAllocations(op.allocations),titreProjet:op.titreProjet||"",dossier:op.dossier||"",dossierTitre:op.dossierTitre||"",srcType:op.srcType||"",objet:"إلغاء بطاقة الالتزام رقم "+op.num+(op.objet?"\n"+op.objet:""),lignes:engCopyLines(op.lignes||[]),statut:"emise",annulation_de:op.id,ts:new Date().toISOString()};
  op.annulee_par=nop.id;engReg.ops.push(nop);
  try{engSaveReg();}catch(e){delete op.annulee_par;engReg.ops.length=n0;engReg.seq=seq0;alert("Enregistrement impossible : "+errText(e));return;}
  engRenderAll();engOk("Carte N° "+op.num+" annulee par la carte N° "+nop.num+".");
}

/* ---------- 4. budget status ---------- */
function engStatus(){
  var a=engArtsSorted(),i,k,st,ops,n,rows=[],r;
  for(i=0;i<a.length;i++){
    k=engArtKey(a[i]);st=engStateOf(k,engReg.ops);if(!st)continue;
    n=0;for(ops=0;ops<engReg.ops.length;ops++)if(engReg.ops[ops].art===k)n++;
    rows.push({k:k,a:a[i],E:st.E,F:st.F,K:st.K,n:n});
  }
  return rows;
}
function engByProject(){
  var m={},ord=[],i,o,p,k,al,items,j,key,amt,title,seenThis;
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];if(o.type!=="depense"&&o.type!=="economie")continue;
    items=[];
    if(o.allocations&&o.allocations.length){
      for(j=0;j<o.allocations.length;j++){al=o.allocations[j];items.push({no:String(al.projectNo||""),titre:al.projectTitle||"",amount:Number(al.amount)||0});}
    }else if(o.projet){
      if(o.projets&&o.parts){for(j=0;j<o.parts.length;j++)items.push({no:String(o.parts[j].p),titre:o.titreProjet||"",amount:Number(o.parts[j].m)||0});}
      else items.push({no:String(o.projet),titre:o.titreProjet||"",amount:Number(o.I)||0});
    }
    seenThis={};
    for(j=0;j<items.length;j++){
      al=items[j];if(!al.no)continue;key="k"+al.no;amt=al.amount;
      if(!m.hasOwnProperty(key)){m[key]={no:al.no,titre:al.titre,n:0,net:0,arts:{}};ord.push(key);}
      p=m[key];if(al.titre&&!p.titre)p.titre=al.titre;
      if(!seenThis[key]){p.n++;seenThis[key]=true;}
      p.net=r2(p.net+(o.type==="depense"?amt:-amt));p.arts[o.art]=true;
    }
  }
  var out=[];for(i=0;i<ord.length;i++)out.push(m[ord[i]]);return out;
}
function engByDossier(){
  var out=[],i,d,k,q,r,o,arts;
  for(i=0;i<engReg.dossiers.length;i++){
    d=engReg.dossiers[i];
    for(k=0;k<d.sources.length;k++){
      q=engDosSourceStats(d,d.sources[k]);arts={};
      for(o=0;o<engReg.ops.length;o++)if(engReg.ops[o].dossier===d.no&&engReg.ops[o].type==="depense"){
        var opx=engReg.ops[o],hitx=false,ax;
        if(opx.allocations){for(ax=0;ax<opx.allocations.length;ax++)if(String(opx.allocations[ax].projectNo)===String(d.sources[k].no))hitx=true;}
        else if(opx.projet===d.sources[k].no)hitx=true;
        else if(opx.projets){for(ax=0;ax<opx.projets.length;ax++)if(String(opx.projets[ax])===String(d.sources[k].no))hitx=true;}
        if(hitx)arts[opx.art]=true;
      }
      out.push({dos:d.no,dosTitre:d.titre,objet:d.objet,type:(ENG_SRC_TYPES[d.sources[k].type]||{lab:d.sources[k].type}).lab,no:d.sources[k].no,titre:d.sources[k].titre,n:q.n,net:q.net});
    }
  }
  return out;
}
function engByMonth(){
  var m={},ord=[],i,o,k;
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];k=String(o.date).substring(0,7);
    if(!m.hasOwnProperty("k"+k)){m["k"+k]={mois:k,ouv:0,dep:0,eco:0,tp:0,tm:0};ord.push("k"+k);}
    if(o.type==="ouverture")m["k"+k].ouv=r2(m["k"+k].ouv+o.I);
    else if(o.type==="depense")m["k"+k].dep=r2(m["k"+k].dep+o.I);
    else if(o.type==="economie")m["k"+k].eco=r2(m["k"+k].eco+o.I);
    else if(o.type==="transfert_plus")m["k"+k].tp=r2(m["k"+k].tp+o.I);
    else if(o.type==="transfert_moins")m["k"+k].tm=r2(m["k"+k].tm+o.I);
  }
  ord.sort();var out=[],i2;for(i2=0;i2<ord.length;i2++)out.push(m[ord[i2]]);
  return out;
}
function engRenderState(){
  var el=$("engStateOut"),h=[],rows,i,r,tE=0,tF=0,tK=0,pr,mo,j,al=[];
  if(!engReg){el.innerHTML='<p class="muted">Ouvrez une annee financiere.</p>';return;}
  rows=engStatus();
  h.push('<h4>Etat par matiere - annee '+engReg.annee+'</h4><table><tr><th>Article</th><th>Matiere</th><th>Credit (E)</th><th>Engage (F)</th><th>Solde (K)</th><th>%</th><th>Cartes</th></tr>');
  for(i=0;i<rows.length;i++){
    r=rows[i];tE+=r.E;tF+=r.F;tK+=r.K;
    h.push('<tr><td>'+esc(r.k)+'</td><td dir="rtl" style="text-align:right">'+esc(r.a.mt)+'</td><td style="text-align:right">'+engFmt(r.E)+'</td><td style="text-align:right">'+engFmt(r.F)+'</td><td style="text-align:right"'+(r.K<0?' class="err"':'')+'><b>'+engFmt(r.K)+'</b></td><td>'+(r.E?Math.round(r.F/r.E*1000)/10:0)+'</td><td>'+r.n+'</td></tr>');
    if(r.K<0)al.push(r.k);
  }
  h.push('<tr class="b"><td colspan="2"><b>Total</b></td><td style="text-align:right"><b>'+engFmt(r2(tE))+'</b></td><td style="text-align:right"><b>'+engFmt(r2(tF))+'</b></td><td style="text-align:right"><b>'+engFmt(r2(tK))+'</b></td><td></td><td></td></tr></table>');
  if(al.length)h.push('<p class="err">Matieres a solde negatif : '+esc(al.join(", "))+'</p>');
  pr=engByProject();
  h.push('<h4>Par projet</h4><table><tr><th>Projet</th><th>Titre</th><th>Cartes</th><th>Engage net</th><th>Matieres</th></tr>');
  for(i=0;i<pr.length;i++){al=[];for(j in pr[i].arts)if(pr[i].arts.hasOwnProperty(j))al.push(j);h.push('<tr><td>'+esc(pr[i].no)+'</td><td>'+esc(pr[i].titre)+'</td><td>'+pr[i].n+'</td><td style="text-align:right">'+engFmt(pr[i].net)+'</td><td>'+esc(al.join(", "))+'</td></tr>');}
  h.push('</table>');
  var bd=engByDossier();
  h.push('<h4>Par dossier d\'engagement</h4><table><tr><th>Dossier</th><th>Titre</th><th>Type</th><th>Projet importe</th><th>Cartes</th><th>Engage net</th></tr>');
  for(i=0;i<bd.length;i++)h.push('<tr><td>'+esc(bd[i].dos)+'</td><td dir="auto">'+esc(bd[i].dosTitre)+'</td><td>'+esc(bd[i].type)+'</td><td>'+esc(bd[i].no)+'</td><td>'+bd[i].n+'</td><td style="text-align:right">'+engFmt(bd[i].net)+'</td></tr>');
  h.push('</table>');
  mo=engByMonth();
  h.push('<h4>Par mois</h4><table><tr><th>Mois</th><th>Ouvertures</th><th>Depenses</th><th>Economies</th><th>Transferts +</th><th>Transferts -</th></tr>');
  for(i=0;i<mo.length;i++)h.push('<tr><td>'+esc(mo[i].mois)+'</td><td style="text-align:right">'+engFmt(mo[i].ouv)+'</td><td style="text-align:right">'+engFmt(mo[i].dep)+'</td><td style="text-align:right">'+engFmt(mo[i].eco)+'</td><td style="text-align:right">'+engFmt(mo[i].tp)+'</td><td style="text-align:right">'+engFmt(mo[i].tm)+'</td></tr>');
  h.push('</table>');
  el.innerHTML=h.join("");
}
function engExportExcel(){
  if(!engNeedReg())return;
  var H=function(a){var r=[],i;for(i=0;i<a.length;i++)r.push(X("S",a[i],"bf"));return r;};
  var S=function(v){return X("S",String(v),"cx");},N=function(v){return X("N",v,"n");};
  var s1=[H(["Article","N°","Type","Date","E","F","G","I","K","Dossier","Projet","Statut","Objet"])],i,o,rows,r,pr,mo;
  for(i=0;i<engReg.ops.length;i++){
    o=engReg.ops[i];
    s1.push([S(o.art),X("I",o.num,"cx"),S(ENG_TYPES[o.type]),S(engDisp(o.date)),N(o.E),N(o.F),N(o.G),N(o.I),N(o.K),S(o.dossier||""),S(o.projet||""),S(o.annulee_par?"annulee":(o.annulation_de?"annulation":"emise")),S(String(o.objet||"").replace(/\n/g," | "))]);
  }
  var s2=[H(["Article","Matiere","Credit (E)","Engage (F)","Solde (K)","Cartes"])];
  rows=engStatus();
  for(i=0;i<rows.length;i++){r=rows[i];s2.push([S(r.k),S(r.a.mt),N(r.E),N(r.F),N(r.K),X("I",r.n,"cx")]);}
  var s3=[H(["Projet","Titre","Cartes","Engage net"])];
  pr=engByProject();for(i=0;i<pr.length;i++)s3.push([S(pr[i].no),S(pr[i].titre),X("I",pr[i].n,"cx"),N(pr[i].net)]);
  var s4=[H(["Mois","Ouvertures","Depenses","Economies","Transferts +","Transferts -"])];
  mo=engByMonth();for(i=0;i<mo.length;i++)s4.push([S(mo[i].mois),N(mo[i].ouv),N(mo[i].dep),N(mo[i].eco),N(mo[i].tp),N(mo[i].tm)]);
  var s5=[H(["Dossier","Titre","Objet","Type de projet","Projet","Titre du projet","Cartes","Engage net"])],bd2=engByDossier();
  for(i=0;i<bd2.length;i++)s5.push([S(bd2[i].dos),S(bd2[i].dosTitre),S(String(bd2[i].objet||"").replace(/\n/g," | ")),S(bd2[i].type),S(bd2[i].no),S(bd2[i].titre),X("I",bd2[i].n,"cx"),N(bd2[i].net)]);
  try{
    exportXls([{name:"Registre",w:[60,40,110,70,90,90,90,90,90,80,80,70,300],rows:s1},{name:"Etat par matiere",w:[60,300,100,100,100,50],rows:s2},{name:"Par projet",w:[80,250,50,100],rows:s3},{name:"Par dossier",w:[80,200,250,150,80,200,50,100],rows:s5},{name:"Par mois",w:[70,100,100,100,100,100],rows:s4}],"Engagements_"+engReg.annee,"engMsg");
  }catch(e){engErr("Export impossible : "+errText(e));}
}


/* ---------- start ---------- */
function init() {
  detectArch();
  var pref = "";
  try { pref = String(sh.RegRead("HKCU\\Software\\PaieHta\\Bits")); } catch (er) { pref = ""; }
  if (os64 && cmdLine.indexOf("/t32") < 0 && cmdLine.indexOf("/t64") < 0) {
    // start directly in the bitness that worked last time (default 32-bit: Jet / 32-bit ACE)
    if (pref == "64" && !proc64) { if (relaunch(true, "/t32 /t64")) return; }
    else if (pref != "64" && proc64) { if (relaunch(false, "/t32")) return; }
  }
  log("demarrage: processus " + (proc64 ? "64" : "32") + " bits, windows64=" + os64 + ", memorise=" + pref);
  autoStart = true;
  try {
    var dbs = findDbs(hostFolder());
    var s = $("dbSel");
    for (var i = 0; i < dbs.length; i++) {
      var o = document.createElement("option");
      o.value = dbs[i]; o.text = dbs[i].substring(dbs[i].lastIndexOf("\\") + 1);
      s.options.add(o);
    }
  } catch (e0) { }
  $("status").innerHTML = '<span class="err">Aucune base chargee</span> &mdash; cliquez sur "Parcourir" (en haut a droite) pour importer votre fichier .mdb.';
  try { rpRefreshProjList(); } catch (e1) { }
  var mdb = /\/db "([^"]+)"/.exec(cmdLine);       // set when the app restarted itself in another 32/64-bit mode
  if (mdb) connectTo(mdb[1]);
}
</script>
</head>
<body onload="init()">
<div id="top"><a id="langBtn" href="#" onclick="toggleLang();return false;" title="Français / العربية" style="color:#ffe28a;font-weight:bold;margin-right:14px">عربي</a><b>Paie</b> <span id="status">...</span></div>
<div id="tabs">
  <a id="tab_slip" href="#" onclick="showTab('slip');return false;">Bulletin employe</a>
  <a id="tab_journal" href="#" onclick="showTab('journal');return false;">Journal par corps</a>
  <a id="tab_rappel" href="#" onclick="showTab('rappel');return false;">Rappel echelon</a>
  <a id="tab_eng" href="#" onclick="showTab('eng');return false;">Cartes d'engagement</a>
  <a id="tab_json" href="#" onclick="showTab('json');return false;">Conversion JSON</a>
  <a id="tab_tables" href="#" onclick="showTab('tables');return false;">Tables</a>
  <a id="tab_emp" href="#" onclick="showTab('emp');if(conn)searchEmp();return false;">Employes / Bulletins</a>
  <a id="tab_queries" href="#" onclick="showTab('queries');return false;">Requetes</a>
  <a id="tab_schema" href="#" onclick="showTab('schema');return false;">Schema</a>
  <span style="float:right">
    <b>Importer une base (.mdb):</b> <select id="dbSel" onchange="switchDb()"><option value="">(dossier courant)</option></select>
    <input type="file" id="fileIn" onchange="pickFile()" style="width:180px">
  </span>
</div>

<div id="pane_slip" class="pane on">
  <div class="box bar">Employe: <input type="text" id="slipQ" size="28" onkeydown="if(event.keyCode==13)searchSlip()">
  Mois: <select id="perSlip" onchange="showSlip()"></select>
  <label><input type="checkbox" id="slipZero" onclick="showSlip()"> afficher les lignes a zero</label>
  <button onclick="searchSlip()">Chercher</button>
  <span class="muted">matricule, nom ou prenom (FR/AR). Cliquez sur un employe de la liste.</span></div>
  <div id="slipEmpList"></div><div id="slipOut"></div>
</div>

<div id="pane_journal" class="pane">
  <div class="box bar">Corps: <select id="corpsSel"></select>
  Mois: <select id="perJ"></select>
  <label><input type="checkbox" id="jInt"> inclure les rubriques intermediaires</label>
  <button onclick="genJournal()">Generer</button>
  <button onclick="exportJournal()">Exporter Excel 2003 (.xls)</button> <span id="jMsg"></span></div>
  <div id="jOut"></div>
</div>

<div id="pane_rappel" class="pane">
  <div class="box bar">
  <b>1. Filtrer les agents</b><br>
  Corps: <select id="rpCorps"></select>
  &nbsp; Matricules (optionnel): <input type="text" id="rpMats" size="26" placeholder="Matricules separes par virgule">
  &nbsp; Date effet par defaut: <input type="text" id="rpDefaultDate" size="10" placeholder="jj/mm/aaaa"> <span class="muted">Format jj/mm/aaaa (ex. 01/02/2020 = 1er fevrier 2020)</span>
  &nbsp; Fin par defaut: <select id="rpUntil"></select>
  &nbsp; Bulletin de reference (global): <select id="rpBaseGlobal"><option value="">Dernier bulletin archive (auto)</option></select>
  &nbsp; <button onclick="rpLoadEmployees()">Charger les agents</button><br><br>
  <b>2a. Bases supplementaires de reference (facultatif)</b> — ajoutez autant de fichiers .mdb, .accdb ou manifest.json que necessaire (archives par annee par exemple). Le bulletin de reference de chaque periode est choisi AUTOMATIQUEMENT parmi toutes les bases : il doit appartenir a la meme grille que la periode calculee (un bulletin 2022 ne sert jamais pour une periode 2023). <span id="rpRefCount" class="muted">0 base(s) ajoutee(s).</span> <input type="file" id="rpRefFile" onchange="rpAddRefDb()" style="width:210px"> <span id="rpRefList"></span><br><br>
  <b>2b. Projets de rappel</b> — Projet existant: <select id="rpProjSel" onchange="rpPickProject()" style="min-width:260px"></select> &nbsp; Numero de projet: <input type="text" id="rpProjNo" size="14" placeholder="ex. 2026-014"> <button onclick="rpSaveProject()">Enregistrer le projet</button> <button onclick="rpOpenProject()">Ouvrir le projet</button> <button onclick="rpDeleteProject()">Supprimer</button> <span id="rpProjMsg"></span> <span class="muted">(un fichier .json par projet dans le dossier "projets" a cote de l application, independant de la base Access ; choisir un projet dans la liste recharge toute l interface)</span><br><br>
  <b>2. Selection et parametres individuels</b> — cochez les agents et modifiez pour chacun le nouvel echelon, la date d’effet et le mois de fin.
  <div id="rpEmployees" class="box"><span class="muted">Chargez les agents pour afficher la liste de selection.</span></div>
  <b>3. Dates d’application des grilles (modifiables)</b><br>
  Grille 2022: <input id="rpGridDate2022" size="10" value="01/03/2022"> &nbsp;
  Grille 2023: <input id="rpGridDate2023" size="10" value="01/01/2023"> &nbsp;
  Grille 2024: <input id="rpGridDate2024" size="10" value="01/01/2024"><br><br>
  <b>4. Calcul du rappel</b><br>
  Exclure rubriques (codes): <input type="text" id="rpExcl" size="20">
  &nbsp; Forcer FIXES (codes): <input type="text" id="rpFixed" size="16">
  &nbsp; Forcer CALCULEES (codes): <input type="text" id="rpCalc" size="16">
  <label><input type="checkbox" id="rpInt"> afficher les rubriques intermediaires</label>
  &nbsp; <button onclick="rpRun()">Calculer le rappel</button>
   تنسيق الجداول / Mise en forme: حجم الخط <input type="text" id="rpFontSize" size="3" value="10" title="6 à 18 pt"> pt
   ارتفاع الصفوف <input type="text" id="rpLineSpacing" size="4" value="1.0" title="0.5 إلى 2.0؛ 1.0 = عادي">
   عرض الأعمدة <input type="text" id="rpColSpacing" size="4" value="1.0" title="0.5 إلى 2.0؛ 1.0 = عادي"> &nbsp;
  Rendement: taux max % <input type="text" id="rpRendRate" size="4" title="vide = automatique selon le corps (35 / 30)"> note /40 <input type="text" id="rpRendNote" size="3" value="40"> &nbsp; Titre de l’etat (optionnel): <input type="text" id="rpTitle" size="46" dir="auto"> <button onclick="rpExport()">Exporter Excel 2003 (.xls)</button> <button onclick="rpPrint()">Imprimer / PDF (A3)</button> <span id="rpMsg"></span>
  <p class="muted"><b>Regles appliquees (promotion d echelon) :</b> seule l IEP change (points d echelon x 45 DA). Le Salaire de Base (indice minimum x 45 DA) est INCHANGE — son rappel vaut toujours 0. Chaque indemnite calculee est refaite avec SON POURCENTAGE de (base + IEP), le taux etant lu sur le bulletin de reference de la MEME grille que la periode ; les rubriques fixes et I.Cont restent inchangees (rappel 0). Prorata en jours (30 jours par mois). Le bulletin de reference de chaque periode est choisi automatiquement parmi TOUTES les bases ajoutees : un bulletin d une autre grille (2022 pour 2023) est ecarte, sinon avertissement. Sauvegarde de projet : un fichier .json par projet (filtres, agents coches, echelons, dates, parametres) dans le dossier projets ; « Ouvrir le projet » recharge toute l’interface pour poursuivre le travail. Export Excel A3 paysage. Les dates d’application des grilles doivent etre confirmees avec les textes officiels avant validation comptable. La base Access est en lecture seule.</p>
  </div>
  <div id="rpOut"></div>
</div>

<div id="pane_eng" class="pane">
<div class="box bar"><b>Annee financiere</b> : <select id="engYearSel" onchange="engPickYear()"></select> &nbsp; ou nouvelle annee : <input id="engYear" size="5"> <button onclick="engOpenYear($('engYear').value)">Ouvrir / creer</button> &nbsp;&nbsp; Date de l'operation : <input id="engDate" size="10"> <label><input type="checkbox" id="engPrintDate"> imprimer la date sur la carte</label> <span id="engMsg"></span>
<div class="muted">Registre = un fichier JSON par annee dans le dossier "engagements" (independant de la base Access). Chaque carte emise enregistre E, F, G, K : la chaine des operations est contrôlee de bout en bout.</div></div>
<div class="engbar"><button id="engb_dos" onclick="engSub('dos')">0. Dossiers d'engagement</button> <button id="engb_credits" onclick="engSub('credits')">1. Ouverture des credits</button> <button id="engb_cards" onclick="engSub('cards')">2. Cartes a emettre</button> <button id="engb_reg" onclick="engSub('reg')">3. Registre des operations</button> <button id="engb_state" onclick="engSub('state')">4. Etat budgetaire</button></div>

<div id="eng_dos" class="engsub">
<div class="box"><b>Dossiers (projets) d'engagement</b> - un dossier regroupe les cartes d'engagement issues d'un ou de plusieurs projets importes (rappel d'echelon, et plus tard : categories, recrutement, rappels partiels de rubrique).<br>
Dossier : <select id="engDosSel" onchange="engDosPick()" style="min-width:320px"></select> <button onclick="engDosNew()">Nouveau</button> <button onclick="engDosDelete()">Supprimer</button><br>
N&deg; <input id="engdNo" size="14" placeholder="ex. 2027/001"> Titre <input id="engdTitre" size="60" dir="auto"> Statut <select id="engdStat"><option value="ouvert">ouvert</option><option value="clos">clos</option></select><br>
Objet (repris sur les cartes) :<br><textarea id="engdObjet" rows="3" cols="95" dir="rtl"></textarea><br>
<button onclick="engDosSave()"><b>Enregistrer le dossier</b></button></div>
<div class="box"><b>Projets enregistres a ajouter au dossier choisi</b> (cochez autant de projets que necessaire : paramedicaux, psychologues, ...) : type <select id="engdSrcType"></select> <button onclick="engDosAddProjects()"><b>Ajouter les projets coches au dossier</b></button> <button onclick="engRenderProjAvail()">Actualiser la liste</button>
<div id="engdProjList" style="max-height:220px;overflow:auto"></div></div>
<div class="box"><b>Ou : ajouter le projet affiche dans l'onglet Rappel echelon</b> : <button onclick="engDosImport()">Ajouter le projet en cours</button></div>
<div id="engDosInfo"></div>
</div>

<div id="eng_credits" class="engsub">
<div class="box"><b>Decision de notification</b> (texte de la carte d'ouverture) : N&deg; <input id="engDecNo" size="16"> date <input id="engDecDate" size="12"> <button onclick="engSaveDecision()">Enregistrer</button></div>
<div class="box"><b>Entete des cartes</b> (modifiable) :<br>
<input id="engH1" size="60" dir="rtl"> <input id="engH2" size="40" dir="rtl"><br><input id="engH3" size="60" dir="rtl"> <input id="engH4" size="40" dir="rtl"> <button onclick="engSaveEntete()">Enregistrer</button></div>
<div class="box"><b>Coller des credits</b> (une ligne par matiere : <code>1.2.7 ; 24000000</code>) :<br><textarea id="engPaste" rows="3" cols="60"></textarea> <button onclick="engImportPaste()">Remplir le tableau</button></div>
<p><button onclick="engEmitOpenings(false)">Emettre les cartes d'ouverture</button> <button onclick="engEmitOpenings(true)">Emettre et imprimer</button> <span class="muted">(seules les matieres avec un montant saisi et non encore ouvertes)</span></p>
<div id="engCreditTable" style="max-height:380px;overflow:auto"></div>
<div class="box"><b>Ajouter / modifier une matiere du catalogue</b> : Titre <select id="engaT"><option value="1">1 (personnel)</option><option value="2">2 (fonctionnement)</option><option value="4">4 (transferts)</option></select> Bab <input id="engaB" size="3"> texte <input id="engaBt" size="30" dir="rtl"> Mada <input id="engaM" size="3"> texte <input id="engaMt" size="40" dir="rtl"> <button onclick="engAddArticle()">Enregistrer</button></div>
</div>

<div id="eng_cards" class="engsub">
<p><button onclick="engDosPrepare()"><b>Preparer les cartes des projets coches du dossier</b></button> <span id="engCardsDos" class="muted"></span> <span class="muted">(projets coches dans l'onglet 0 ; une carte par matiere, une ligne par corps, montants additionnes)</span></p>
<div id="engMap"></div>
<details><summary><b>Operation manuelle</b> (transfert, economie, depense hors projet)</summary>
<div class="box">Matiere <select id="engmArt" style="max-width:420px"></select> Type <select id="engmType"></select> Montant <input id="engmAmt" size="14" style="text-align:right"> Projet (optionnel) <input id="engmProj" size="12"><br>
Objet :<br><textarea id="engmObj" rows="3" cols="80" dir="rtl"></textarea><br>
Lignes (une par ligne, <code>texte ; montant</code>, montant facultatif) :<br><textarea id="engmLines" rows="3" cols="80" dir="rtl"></textarea><br><button onclick="engAddManual()">Ajouter a la liste</button></div></details>
<p><button onclick="engPreviewDrafts()">Apercu (sans emettre)</button> <button onclick="engEmitDrafts(false)">Emettre les cartes cochees</button> <button onclick="engEmitDrafts(true)"><b>Emettre et imprimer</b></button> <span class="muted">Une carte emise est verrouillee ; pour corriger, utilisez Annuler dans le registre.</span></p>
<div id="engDrafts"></div>
</div>

<div id="eng_reg" class="engsub">
<p>Matiere : <select id="engFilterArt" onchange="engRenderReg()" style="max-width:420px"></select> <button onclick="engPrintSelected()">Imprimer les operations cochees</button> <button onclick="engExportExcel()">Exporter Excel</button></p>
<div id="engRegTable" style="max-height:480px;overflow:auto"></div>
</div>

<div id="eng_state" class="engsub">
<p><button onclick="engRenderState()">Actualiser</button> <button onclick="engExportExcel()">Exporter Excel</button></p>
<div id="engStateOut"></div>
</div>
</div>

<div id="pane_json" class="pane">
  <div class="box">
    <h3>Conversion des bases Access vers JSON</h3>
    <p>Choisissez un dossier contenant plusieurs bases .mdb / .accdb, puis un dossier de destination. L'application cree un dossier par base, un manifeste et un fichier JSON par table.</p>
    <button onclick="jsonConvertFolder()">Choisir les dossiers et convertir les bases</button>
    <p class="muted">Les bases Access originales restent intactes. Les tables sont exportees separement pour eviter un unique fichier JSON geant. Les champs binaires sont exportes comme null. Pour utiliser une base convertie dans les calculs, selectionnez son fichier manifest.json dans « Bases supplementaires de reference » de l'onglet استدراك.</p>
  </div>
  <div id="jsonOut"></div>
</div>

<div id="pane_tables" class="pane"><div id="tl"></div><div id="tg"></div></div>

<div id="pane_emp" class="pane">
  <div class="box">Recherche: <input type="text" id="q" size="30" onkeydown="if(event.keyCode==13)searchEmp()">
  <button onclick="searchEmp()">Chercher</button> <span class="muted">matricule / nom / prenom (FR ou AR)</span></div>
  <div id="empList"></div><div id="empDetail"></div>
</div>

<div id="pane_queries" class="pane"><div id="queriesOut"></div></div>

<div id="pane_schema" class="pane">
  <button onclick="exportSchema()">Enregistrer schema_export.txt</button>
  <div id="schemaOut"></div>
</div>
</body>
</html>
