var RUB_AR = [
  [/^salairedebase/, "الراتب القاعدي"],
  [/^indemnitedexperience|^iep$/, "تعويض الخبرة المهنية"],
  [/^ipsup|^isup|postesuperieur/, "ت. المنصب العالي"],
  [/^indforfaitairecomplim|^indemniteforfaitaire/, "التعويض الجزافي التكميلي"],
  [/^icont|contagi/, "تعويض العدوى"],
  [/^igarde|^indemnitedegarde|^garde/, "تعويض الحراسة"],
  [/^indlog|^indemnitelogement|^logement/, "تعويض السكن"],
  [/^izone|^indemnitedezone|^zone/, "تعويض المنطقة"],
  [/astreinte/, "تعويض المناوبة"],
  [/suividumalade/, "تعويض متابعة المريض"],
  [/soutienauxactivites|soutien/, "تعويض الدعم للنشاطات"],
  [/nuisance/, "تعويض الضرر"],
  [/rendement/, "منحة المردودية"],
  [/^allocationfamil/, "المنحة العائلية"],
  [/^mifr/, "تعويض M.I.F.R."],
  [/^salaireunique/, "منحة الأجر الوحيد"],
  [/impotsurlerevenu|^irg/, "الضريبة على الدخل الإجمالي (IRG)"],
  [/cotisationsoci|^cs$/, "اشتراك الضمان الاجتماعي"],
  [/^retos|oeuvressociales/, "اقتطاع الأعمال الاجتماعية"],
  [/retenueabsence|^absence/, "اقتطاع الغياب"]
];
var RUB_WORDS = [[/indemnit[eé]s?/gi,"تعويض"],[/primes?/gi,"منحة"],[/retenues?/gi,"اقتطاع"],[/allocations?/gi,"منحة"],
  [/salaire/gi,"الأجر"],[/familiale?/gi,"العائلية"],[/\bde la\b|\bdu\b|\bde l'|\bdes\b|\bde\b|\bd'/gi,""],[/forfaitaire/gi,"جزافي"],
  [/compl[eé]mentaire/gi,"تكميلي"],[/sp[eé]ciale?/gi,"خاص"],[/exceptionnelle?/gi,"استثنائي"],[/travail/gi,"العمل"],
  [/nuit/gi,"الليل"],[/transport/gi,"النقل"],[/panier/gi,"السلة"],[/responsabilit[eé]/gi,"المسؤولية"],
  [/sujetion/gi,"الإلزام"],[/mission/gi,"المهمة"],[/rappel/gi,"استدراك"],[/total/gi,"مجموع"]];
function rubNormKey(s) { return String(s || "").toLowerCase().replace(/[éèêë]/g, "e").replace(/[àâä]/g, "a").replace(/[\s._\-\/()%'’`0-9]+/g, ""); }
var rubArabic = function (code, lib, isRet) {
  var k1 = rubNormKey(lib), k2 = rubNormKey(code), q, t, w, out, base;
  for (q = 0; q < RUB_AR.length; q++) {
    if (RUB_AR[q][0].test(k1) || RUB_AR[q][0].test(k2)) {
      t = RUB_AR[q][1];
      w = /\d+\s*%|%\s*\d+/.exec(String(lib || ""));      // keep a percentage written in the label (ISTC 40%)
      if (w && t.indexOf(w[0]) < 0) t += " " + w[0].replace(/\s+/g, "");
      return t;
    }
  }
  out = String(lib || code || "");
  for (q = 0; q < RUB_WORDS.length; q++) out = out.replace(RUB_WORDS[q][0], RUB_WORDS[q][1]);
  out = trim(out.replace(/\s{2,}/g, " "));
  if (/[؀-ۿ]/.test(out)) return out;
  base = trim(String(lib || code || ""));
  if (base === "") base = trim(String(code || ""));
  return (isRet ? "اقتطاع " : "تعويض ") + base;   // unknown acronym: generic Arabic word + the code
};
function T(s) { return (LANG === "ar" && TR[s]) ? TR[s] : s; }
function toggleLang() { LANG = (LANG === "ar") ? "fr" : "ar"; applyLang(); }
function applyLang() {
  $("tab_slip").innerHTML = T("Bulletin employe");
  $("tab_journal").innerHTML = T("Journal par corps");
  $("tab_rappel").innerHTML = T("Rappel echelon");
  $("tab_tables").innerHTML = T("Tables");
  $("tab_emp").innerHTML = T("Employes / Bulletins");
  $("tab_queries").innerHTML = T("Requetes");
  $("tab_schema").innerHTML = T("Schema");
  $("langBtn").innerHTML = (LANG === "ar") ? "FR" : "عربي";
  if (curR) rpRenderOut();
}
function rpRenderOut() {
  var d = curR; if (!d) return;
  var i, showSal = true, oldCb = $("rpShowSalary");
  if (oldCb) showSal = oldCb.checked;
  var h = ['<p style="text-align:center"><b style="font-size:15px">' + esc(ENTETE1) + '<br>' + esc(ENTETE2) + '</b></p>'];
  h.push('<p><b>' + esc(T("Journal des rappels d’echelon")) + ' — ' + d.recap.length + ' ' + esc(T("agent(s)")) + '</b></p>');
  h.push('<p class="muted">' + esc(T("Affichage detaille : ancien salaire, nouveau salaire et rappel pour chaque periode de grille. Desactivez l’option pour retrouver l’affichage compact precedent (rappel uniquement). Les rubriques du catalogue sont toutes affichees, y compris celles dont le montant calcule est nul.")) + '</p>');
  h.push('<p><label><input type="checkbox" id="rpShowSalary"' + (showSal ? ' checked' : '') + ' onchange="rpSetView()"> ' + esc(T("Afficher ancien salaire + nouveau salaire (mode detaille)")) + '</label></p>');
  if (d.warns.length) h.push('<div class="box"><b>' + esc(T("Avertissements")) + ' (' + d.warns.length + ')</b><pre>' + esc(d.warns.slice(0, 60).join("\n")) + (d.warns.length > 60 ? "\n..." : "") + '</pre></div>');
  h.push('<h3>' + esc(T("Recapitulatif par agent")) + '</h3><div id="rpRecap"></div><h3>' + esc(T("Journal horizontal des rappels par rubrique")) + '</h3><div id="rpDetail"></div>');
  var cl = ['<p><a href="#" onclick="rpToggleClass();return false;">' + esc(T("Afficher / masquer la classification des rubriques (calculee ou fixe)")) + '</a></p><div id="rpClass" style="display:none"><table><tr><th>' + esc(T("Code")) + '</th><th>' + esc(T("Libelle")) + '</th><th>' + esc(T("Nature")) + '</th><th>' + esc(T("Mode calcul")) + '</th><th>' + esc(T("Automatique")) + '</th><th>' + esc(T("Bareme")) + '</th><th>' + esc(T("Base")) + '</th><th>' + esc(T("Nombre / taux")) + '</th></tr>'];
  for (i = 0; i < d.rubs.length; i++) {
    var isC = d.contIdx.indexOf(i) >= 0;
    cl.push('<tr><td>' + esc(d.rubs[i].code) + '</td><td dir="auto">' + esc(d.rubs[i].lib) + '</td><td>' + (isC ? esc(T("fixe (I.Cont)")) : (d.rubs[i].calculated ? '<b>' + esc(T("calculee")) + '</b>' : esc(T("fixe")))) + '</td><td>' + esc(d.rubs[i].mode || "") + '</td><td>' + esc(d.rubs[i].automatic || "") + '</td><td>' + esc(d.rubs[i].bareme || "") + '</td><td dir="auto">' + esc(d.rubs[i].base || "") + '</td><td dir="auto">' + esc(d.rubs[i].taux || "") + '</td></tr>');
  }
  cl.push('</table></div>'); h.push(cl.join(""));
  $("rpOut").innerHTML = h.join("");
  d.rows = showSal ? d.detailRows : d.compactRows;
  memTable("rpRecap", d.rcols, d.recap, 1, 100, null);
  memTable("rpDetail", d.cols, d.rows, 1, 100, d.foot);
}

/* typed rows: every cell is a string whose first letter is the type: N number, I integer, D date, S text, E empty */
function qr(sql) {
  var rs = conn.Execute(sql), cols = [], rows = [], i;
  for (i = 0; i < rs.Fields.Count; i++) cols.push(rs.Fields(i).Name);
  while (!rs.EOF) { rows.push(RowRaw(rs).split(SEP)); rs.MoveNext(); }
  rs.Close();
  return { cols: cols, rows: rows };
}
function fmtNum(x) {
  var s = r2(x).toFixed(2), neg = (s.charAt(0) == "-");
  if (neg) s = s.substring(1);
  var p = s.split("."), a = p[0], o = "";
  while (a.length > 3) { o = " " + a.substring(a.length - 3) + o; a = a.substring(0, a.length - 3); }
  return (neg ? "-" : "") + a + o + "," + p[1];
}
function disp(c) {
  var t = rt(c);
  if (t == "E" || c === "") return "";
  if (t == "N") return fmtNum(parseFloat(rv(c)));
  return rv(c);
}
function cellTd(c) {
  var ty = rt(c), d = disp(c);
  if (LANG === "ar" && ty === "S") d = T(d);
  return '<td dir="auto"' + ((ty == "N" || ty == "I") ? ' class="num"' : '') + '>' + esc(d) + '</td>';
}

var mem = {};
var rpSortState = {};
function rpSortKey(c) { var t = rt(c); if (t == "N" || t == "I") return parseFloat(rv(c)); return lc(rv(c)); }
function rpSortCmp(x, y, asc) {
  var r;
  if (typeof x == "number" && typeof y == "number") r = x - y;
  else { x = String(x); y = String(y); r = (x < y ? -1 : (x > y ? 1 : 0)); }
  return asc ? r : -r;
}
/* click on a column header: sorts the agents (the detail table keeps each agent's block together). The exports follow the same order. */
function rpSort(target, col) {
  if (!curR) return;
  var st = rpSortState[target] || (rpSortState[target] = { col: -1, asc: true }), i, dec = [], blocks = [], cur = [];
  if (st.col === col) st.asc = !st.asc; else { st.col = col; st.asc = true; }
  if (target == "rpRecap") {
    for (i = 0; i < curR.recap.length; i++) dec.push({ k: rpSortKey(curR.recap[i][col] || "E"), i: i, v: curR.recap[i] });
    dec.sort(function (a, b) { var c = rpSortCmp(a.k, b.k, st.asc); return c !== 0 ? c : a.i - b.i; });
    curR.recap = []; for (i = 0; i < dec.length; i++) curR.recap.push(dec[i].v);
  } else {
    for (i = 0; i < curR.detailRows.length; i++) {
      cur.push(curR.detailRows[i]);
      if (rv(curR.detailRows[i][4]) == "TOTAL EMPLOYE") { blocks.push(cur); cur = []; }
    }
    if (cur.length) blocks.push(cur);
    for (i = 0; i < blocks.length; i++) {
      var ref = (col >= 7) ? blocks[i][blocks[i].length - 1] : blocks[i][0];
      dec.push({ k: rpSortKey(ref[col] || "E"), i: i, v: blocks[i] });
    }
    dec.sort(function (a, b) { var c = rpSortCmp(a.k, b.k, st.asc); return c !== 0 ? c : a.i - b.i; });
    var nr = [], nc2 = [], j2, nat;
    for (i = 0; i < dec.length; i++) for (j2 = 0; j2 < dec[i].v.length; j2++) {
      nr.push(dec[i].v[j2]); nat = rv(dec[i].v[j2][2]);
      if (nat === "RAPPEL" || nat === "TOTAL EMPLOYE") nc2.push(dec[i].v[j2]);
    }
    curR.detailRows = nr; curR.compactRows = nc2;
  }
  rpRenderOut();
}
function memTable(target, cols, rows, page, ps, foot) {
  mem[target] = { cols: cols, rows: rows, ps: ps, foot: foot };
  memRender(target, page);
}
function memRender(target, page) {
  var m = mem[target], pc = Math.max(1, Math.ceil(m.rows.length / m.ps)), i, j, h = [];
  if (page < 1) page = 1;
  if (page > pc) page = pc;
  var a = (page - 1) * m.ps, b = Math.min(m.rows.length, a + m.ps);
  h.push('<p class="muted">' + m.rows.length + ' lignes' + (pc > 1 ? ' &mdash; page ' + page + ' / ' + pc + ' &nbsp; ' : ' '));
  if (page > 1) h.push('<a href="#" onclick="memRender(\'' + target + '\',' + (page - 1) + ');return false;">&laquo; precedent</a> ');
  if (page < pc) h.push('<a href="#" onclick="memRender(\'' + target + '\',' + (page + 1) + ');return false;">suivant &raquo;</a>');
  h.push('</p><div style="overflow:auto"><table><tr>');
  var sst = rpSortState[target];
  for (j = 0; j < m.cols.length; j++) {
    if (target == "rpDetail" || target == "rpRecap")
      h.push('<th dir="auto" style="cursor:pointer" title="Trier" onclick="rpSort(\'' + target + '\',' + j + ')">' + esc(T(m.cols[j])) + ((sst && sst.col === j) ? (sst.asc ? " &#9650;" : " &#9660;") : "") + '</th>');
    else h.push('<th dir="auto">' + esc(T(m.cols[j])) + '</th>');
  }
  h.push('</tr>');
  for (i = a; i < b; i++) {
    var rowClass = "";
    if (target == "rpDetail" && m.rows[i].length > 4 && rv(m.rows[i][4]) == "TOTAL EMPLOYE") rowClass = "rp-employee-end";
    h.push('<tr' + (rowClass ? ' class="' + rowClass + '"' : '') + '>');
    for (j = 0; j < m.rows[i].length; j++) h.push(cellTd(m.rows[i][j]));
    h.push('</tr>');
  }
  if (m.foot) {
    h.push('<tr class="' + (target == "rpDetail" ? 'rp-grand-total' : 'foot') + '">');
    for (j = 0; j < m.foot.length; j++) h.push(cellTd(m.foot[j]));
    h.push('</tr>');
  }
  h.push('</table></div>');
  $(target).innerHTML = h.join("");
}

/* ---------- Excel 2003 (SpreadsheetML) writer ---------- */
function X(t, v, s, m, ix) { return { t: t, v: v, s: s, m: m, ix: ix }; }
function xr(c, s) { var t = rt(c); if (t == "E" || c === "") return X("E", "", s); return X(t, (t == "S" ? T(rv(c)) : rv(c)), s); }
function xmlEsc(s) {
  return String(s).replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function xlsCellXml(c) {
  var at = (c.ix ? ' ss:Index="' + c.ix + '"' : "") + (c.m ? ' ss:MergeAcross="' + c.m + '"' : "");
  var sid = c.s || (c.t == "N" ? "n" : (c.t == "D" ? "d" : "cx"));
  var st = ' ss:StyleID="' + sid + '"' + at;
  if (c.t == "E") return '<Cell' + st + '/>';
  if ((c.t == "N" || c.t == "I") && !isNaN(parseFloat(c.v)))
    return '<Cell' + st + '><Data ss:Type="Number">' + parseFloat(c.v) + '</Data></Cell>';
  if (c.t == "D") return '<Cell' + st + '><Data ss:Type="DateTime">' + c.v + 'T00:00:00.000</Data></Cell>';
  return '<Cell' + st + '><Data ss:Type="String">' + xmlEsc(c.v) + '</Data></Cell>';
}
function xCopy(c, ix) { return { t: c.t, v: c.v, s: c.s, m: c.m, ix: ix }; }
/* logical layout: column 1 = right-most. Physical layout for a left-to-right sheet: table rows reversed, heading rows re-anchored. */
function mirrorRows(rows, n) {
  var out = [], i, r, st, rr, c;
  for (i = 0; i < rows.length; i++) {
    r = rows[i];
    if (!r.length) { out.push(r); continue; }
    st = r[0].s || "";
    if (st === "e1" || st === "e4" || st === "e7") { out.push(r); continue; }
    if (st === "e2") { rr = [xCopy(r[0], n - r.length + 1)].concat(r.slice(1)); }
    else if (st === "e3") { rr = r.slice().reverse(); }
    else if (st === "e6") { rr = [xCopy(r[0], undefined)]; }
    else if (st === "e5") { rr = [xCopy(r[0], n)]; }
    else if (r.length === n) { rr = r.slice().reverse(); }
    else { rr = r; }
    rr.h = r.h; out.push(rr);
  }
  return out;
}
var RP_FONT_SIZE=10;
function buildXls(sheets) {
  var o = [], i, j, k, bd = '<Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/></Borders>';
  var f = '<Font ss:FontName="Arial" ss:Size="'+RP_FONT_SIZE+'"';
  o.push('<?xml version="1.0" encoding="UTF-8"?>\r\n<?mso-application progid="Excel.Sheet"?>\r\n');
  o.push('<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40">\r\n');
  o.push('<Styles>');
  o.push('<Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Bottom"/>' + f + '/></Style>');
  o.push('<Style ss:ID="cx"><Alignment ss:Vertical="Bottom"/>' + f + '/>' + bd + '</Style>');
  o.push('<Style ss:ID="h">' + f + ' ss:Bold="1"/><Interior ss:Color="#DCE6F1" ss:Pattern="Solid"/><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"' + (LANG === "ar" ? ' ss:ReadingOrder="RightToLeft"' : '') + '/>' + bd + '</Style>');
  o.push('<Style ss:ID="b">' + f + ' ss:Bold="1"/>' + bd + '</Style>');
  o.push('<Style ss:ID="bf">' + f + ' ss:Bold="1"/><Interior ss:Color="#EEF3FA" ss:Pattern="Solid"/>' + bd + '</Style>');
  o.push('<Style ss:ID="t"><Font ss:FontName="Arial" ss:Size="' +(RP_FONT_SIZE+4)+'" ss:Bold="1"/></Style>');
  o.push('<Style ss:ID="et1"><Font ss:FontName="Arial" ss:Size="' +(RP_FONT_SIZE+4)+'" ss:Bold="1"/><Alignment ss:Horizontal="Center"/></Style>');
  o.push('<Style ss:ID="et2"><Font ss:FontName="Arial" ss:Size="' +(RP_FONT_SIZE+2)+'" ss:Bold="1"/><Alignment ss:Horizontal="Center"/></Style>');
  o.push('<Style ss:ID="n">' + f + '/><NumberFormat ss:Format="#,##0.00"/>' + bd + '</Style>');
  o.push('<Style ss:ID="bn">' + f + ' ss:Bold="1"/><Interior ss:Color="#EEF3FA" ss:Pattern="Solid"/><NumberFormat ss:Format="#,##0.00"/>' + bd + '</Style>');
  o.push('<Style ss:ID="d">' + f + '/><NumberFormat ss:Format="yyyy\\-mm\\-dd"/>' + bd + '</Style>');
  var nb = '<Borders><Border ss:Position="Bottom" ss:LineStyle="None"/><Border ss:Position="Left" ss:LineStyle="None"/><Border ss:Position="Right" ss:LineStyle="None"/><Border ss:Position="Top" ss:LineStyle="None"/></Borders>';
  var ae = '<Font ss:FontName="Arabic Transparent" x:CharSet="178" ss:Size=';
  o.push('<Style ss:ID="x6"><Alignment ss:Vertical="Bottom"/>' + f + '/><NumberFormat ss:Format="0.000000"/>' + bd + '</Style>');
  o.push('<Style ss:ID="cxa"><Alignment ss:Vertical="Center"' + (LANG === "ar" ? ' ss:ReadingOrder="RightToLeft"' : '') + '/>' + f + '/><Interior ss:Color="#F7F7F2" ss:Pattern="Solid"/>' + bd + '</Style>');
  o.push('<Style ss:ID="e7"><Alignment ss:Horizontal="CenterAcrossSelection" ss:Vertical="Bottom"/>' + ae + '"' +(RP_FONT_SIZE+10)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e6"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/>' + ae + '"' +(RP_FONT_SIZE+6)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e5"><Font ss:FontName="Arial" ss:Size="' +(RP_FONT_SIZE+4)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e1"><Alignment ss:Horizontal="CenterAcrossSelection" ss:Vertical="Bottom"/>' + ae + '"' +(RP_FONT_SIZE+12)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e2"><Alignment ss:Horizontal="CenterAcrossSelection" ss:Vertical="Bottom"/>' + ae + '"' +(RP_FONT_SIZE+8)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e3"><Alignment ss:Horizontal="Right" ss:Vertical="Bottom"/>' + ae + '"' +(RP_FONT_SIZE+10)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('<Style ss:ID="e4"><Alignment ss:Horizontal="CenterAcrossSelection" ss:Vertical="Bottom"/>' + ae + '"' +(RP_FONT_SIZE+8)+'" ss:Bold="1"/>' + nb + '</Style>');
  o.push('</Styles>\r\n');
  for (i = 0; i < sheets.length; i++) {
    var sh1 = sheets[i];
    var sName = xmlEsc(String(sh1.name).replace(/[\\/\?\*\[\]:]/g, " ").substring(0, 31));
    var rowsOut = sh1.rows, rowOff = 0, wOut = sh1.w;
    if (sh1.rtl && LANG === "ar") { rowsOut = mirrorRows(rowsOut, sh1.w.length); wOut = sh1.w.slice().reverse(); }
    if (sh1.entete) { rowsOut = [[X("S", ENTETE1, "et1")], [X("S", ENTETE2, "et2")]].concat(rowsOut); rowOff = 2; }
    o.push('<Worksheet ss:Name="' + sName + '">');
    if (sh1.printRow) o.push('<Names><NamedRange ss:Name="Print_Titles" ss:RefersTo="=\'' + sName + '\'!R' + sh1.printRow + ':R' + sh1.printRow + '"/></Names>');
    o.push('<Table>');
    for (j = 0; j < wOut.length; j++) o.push('<Column ss:AutoFitWidth="0" ss:Width="' + wOut[j] + '"/>');
    for (j = 0; j < rowsOut.length; j++) {
      var r = rowsOut[j];
      var rh = r.h ? ' ss:AutoFitHeight="0" ss:Height="' + r.h + '"' : "";
      if (r.length == 0) { o.push('<Row' + rh + '/>'); continue; }
      o.push('<Row' + rh + '>');
      for (k = 0; k < r.length; k++) o.push(xlsCellXml(r[k]));
      o.push('</Row>');
    }
    o.push('</Table>');
    if (sh1.entete) o.push('<Names><NamedRange ss:Name="_xlnm.Print_Titles" ss:RefersTo="=\'' + sName + '\'!$' + (sh1.headRow + rowOff) + ':$' + (sh1.headRow + rowOff) + '"/></Names>');
    if (sh1.land || sh1.entete) {
      o.push('<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup>');
      if (sh1.land) o.push('<Layout x:Orientation="Landscape" x:PaperSize="8"/>');
      if (sh1.entete) o.push('<Header x:Margin="0.2" x:Data="&amp;C' + xmlEsc(ENTETE1) + '&#10;' + xmlEsc(ENTETE2) + '"/><Footer x:Margin="0.2" x:Data="&amp;C' + T("Page") + ' &amp;P / &amp;N"/>');
      if (!sh1.entete && sh1.footer) o.push('<Footer x:Margin="0.2" x:Data="&amp;C' + xmlEsc(T("Page")) + ' &amp;P / &amp;N"/>');
      if (sh1.land) o.push('<PageMargins x:Bottom="0.35" x:Left="0.25" x:Right="0.25" x:Top="' + (sh1.top || "0.6") + '" x:Header="0.15" x:Footer="0.15"/>');
      o.push('</PageSetup>');
      if (sh1.land) o.push('<FitToPage/><Print><ValidPrinterInfo/><PaperSizeIndex>8</PaperSizeIndex><FitWidth>1</FitWidth><FitHeight>0</FitHeight><HorizontalResolution>600</HorizontalResolution><VerticalResolution>600</VerticalResolution></Print>');
      o.push('</WorksheetOptions>');
      if (sh1.plan && sh1.plan.breaks.length) {
        o.push('<PageBreaks xmlns="urn:schemas-microsoft-com:office:excel"><RowBreaks>');
        for (k = 0; k < sh1.plan.breaks.length; k++) o.push('<RowBreak><Row>' + sh1.plan.breaks[k] + '</Row></RowBreak>');
        o.push('</RowBreaks></PageBreaks>');
      }
    }
    o.push('</Worksheet>\r\n');
  }
  o.push('</Workbook>');
  return o.join("");
}
function saveFile(name, text) {
  var dirs = [hostFolder(), sh.ExpandEnvironmentStrings("%TEMP%")], last = null, i;
  for (i = 0; i < dirs.length; i++) {
    try {
      var st = new ActiveXObject("ADODB.Stream");
      st.Type = 2; st.Charset = "utf-8"; st.Open();
      st.WriteText(text);
      st.SaveToFile(dirs[i] + "\\" + name, 2);
      st.Close();
      return dirs[i] + "\\" + name;
    } catch (e) { last = e; }
  }
  throw last;
}
function exportXls(sheets, base, msgId) {
  try {
    var dt = new Date(), stamp = dt.getFullYear() + rpPad(dt.getMonth() + 1) + rpPad(dt.getDate()) + "-" + rpPad(dt.getHours()) + rpPad(dt.getMinutes()) + rpPad(dt.getSeconds());
    var name = String(base).replace(/[\\/:*?"<>|\s]+/g, "_") + "_" + stamp + ".xls";
    var path = saveFile(name, buildXls(sheets));
    $(msgId).innerHTML = '<span class="ok">Fichier cree: ' + esc(path) + '</span>';
    try { sh.Run('"' + path + '"', 1, false); } catch (x) { }
  } catch (e) { $(msgId).innerHTML = '<span class="err">Export impossible: ' + esc(errText(e)) + '</span>'; }
}

/* ---------- lists (periods with archives, corps) ---------- */
function fillSel(id, items) {
  var s = $(id), i;
  s.options.length = 0;
  for (i = 0; i < items.length; i++) {
    var o = document.createElement("option");
    o.value = items[i][0]; o.text = items[i][1];
    s.options.add(o);
  }
}
function loadLists() {
  var per = [], i, r;
  var p = qr("SELECT pe.Code, pe.Annee, p.Libelle FROM Periode_Exercice pe LEFT JOIN Periode p ON p.Code = pe.Code_Periode " +
    "WHERE pe.Code IN (SELECT DISTINCT Code_Periode_Exercice FROM Archive WHERE Code_Traitement = 0) ORDER BY pe.Annee DESC, p.Code DESC");
  for (i = 0; i < p.rows.length; i++) {
    r = p.rows[i];
    per.push([rv(r[0]), (rv(r[2]) + " " + rv(r[1])) + "   [" + rv(r[0]) + "]"]);
  }
  if (per.length == 0) {
    var p2 = qr("SELECT DISTINCT Code_Periode_Exercice FROM Archive WHERE Code_Traitement = 0 ORDER BY Code_Periode_Exercice DESC");
    for (i = 0; i < p2.rows.length; i++) per.push([rv(p2.rows[i][0]), rv(p2.rows[i][0])]);
  }
  fillSel("perSlip", per);
  fillSel("perJ", per);
  fillSel("rpUntil", per);
  var cs = [["", "(Tous les corps)"]];
  var c = qr("SELECT Code, Libelle FROM Corps ORDER BY Libelle");
  for (i = 0; i < c.rows.length; i++) cs.push([rv(c.rows[i][0]), rv(c.rows[i][1]) + "   [" + rv(c.rows[i][0]) + "]"]);
  fillSel("corpsSel", cs);
  fillSel("rpCorps", cs);
}
function selText(id) { var s = $(id); return s.selectedIndex >= 0 ? s.options[s.selectedIndex].text : ""; }

/* ---------- Feature 1: payslip of one employee for one month ---------- */
var curSlip = { mat: "", data: null };
function needDb(id) {
  if (conn) return false;
  $(id).innerHTML = '<p class="err">Aucune base chargee. Cliquez sur "Parcourir" (en haut a droite) pour importer le fichier .mdb.</p>';
  return true;
}
function searchSlip() {
  if (needDb("slipOut")) return;
  var q = trim($("slipQ").value), qs = sq(q);
  $("slipOut").innerHTML = "";
  if (q && scalar("SELECT COUNT(*) FROM Dossier WHERE Matricule='" + qs + "'") == "1") {
    $("slipEmpList").innerHTML = "";
    pickSlip(enc(q));
    return;
  }
  var sql = "SELECT dos.Matricule, dos.Nom, dos.Prenom, dos.Nom_Arab, dos.Prenom_Arab, g.Libelle AS Grade FROM Dossier dos LEFT JOIN Grade g ON g.Code = dos.Code_Grade";
  if (q) sql += " WHERE dos.Matricule LIKE '%" + qs + "%' OR dos.Nom LIKE '%" + qs + "%' OR dos.Prenom LIKE '%" + qs + "%' OR dos.Nom_Arab LIKE '%" + qs + "%' OR dos.Prenom_Arab LIKE '%" + qs + "%'";
  sql += " ORDER BY dos.Nom, dos.Prenom";
  showGrid("slipEmpList", sql, 1, "pickSlip");
}
function pickSlip(e) { curSlip.mat = decodeURIComponent(e); showSlip(); }
function showSlip() {
  var m = curSlip.mat;
  if (!m) return;
  var per = $("perSlip").value, perLabel = selText("perSlip"), i;
  if (!per) { $("slipOut").innerHTML = '<p class="err">Aucune periode dans les archives.</p>'; return; }
  try {
    var info = qr("SELECT dos.Matricule, dos.Nom, dos.Prenom, dos.Nom_Arab, dos.Prenom_Arab, g.Libelle AS Grade, sv.Libelle AS Service, dos.Date_Entree, dos.N_Securite, dos.N_Compte " +
      "FROM ((Dossier dos LEFT JOIN Grade g ON g.Code = dos.Code_Grade) LEFT JOIN Service sv ON sv.Code = dos.Code_Service) WHERE dos.Matricule='" + sq(m) + "'");
    if (info.rows.length == 0) { $("slipOut").innerHTML = '<p class="err">Employe introuvable.</p>'; return; }
    var z = $("slipZero").checked ? "" : " AND d.Valeur<>0";
    var lines = qr("SELECT d.Code_Rubrique AS Rubrique, r.Libelle, r.Libelle_Arab, d.Base, d.Nombre, " +
      "IIf(r.Code_Type=0,d.Valeur,NULL) AS Gain, IIf(r.Code_Type=1,d.Valeur,NULL) AS Retenue, IIf(r.Code_Type=2,d.Valeur,NULL) AS Intermediaire " +
      "FROM (Archive_Detail d INNER JOIN Archive a ON d.Cle_Archive = a.Cle_Archive) LEFT JOIN Rubrique r ON d.Code_Rubrique = r.Code " +
      "WHERE a.Matricule='" + sq(m) + "' AND a.Code_Periode_Exercice='" + sq(per) + "' AND a.Code_Traitement=0" + z + " ORDER BY r.Ordre");
    var h = ['<h3>Bulletin &mdash; ' + esc(perLabel) + '</h3><div class="box"><table>'];
    for (i = 0; i < info.cols.length; i++) h.push('<tr><th>' + esc(info.cols[i]) + '</th><td dir="auto">' + esc(disp(info.rows[0][i])) + '</td></tr>');
    h.push('</table></div>');
    if (lines.rows.length == 0) {
      curSlip.data = null;
      $("slipOut").innerHTML = h.join("") + '<p class="err">Aucun bulletin pour cet employe pendant cette periode.</p>';
      return;
    }
    var g = 0, r = 0;
    for (i = 0; i < lines.rows.length; i++) { g += rnum(lines.rows[i][5]); r += rnum(lines.rows[i][6]); }
    g = r2(g); r = r2(r);
    var net = r2(g - r);
    curSlip.data = { info: info, lines: lines, g: g, r: r, net: net, perLabel: perLabel, per: per, mat: m };
    h.push('<div id="slipLines"></div>');
    h.push('<p><b>Total gains: ' + fmtNum(g) + ' &nbsp; Total retenues: ' + fmtNum(r) + ' &nbsp; Net (gains - retenues): ' + fmtNum(net) + '</b>');
    h.push(' <span class="muted">(calcule &mdash; a comparer avec le bulletin Delphi)</span></p>');
    h.push('<p><button onclick="exportSlip()">Exporter Excel 2003 (.xls)</button> <span id="slipMsg"></span></p>');
    $("slipOut").innerHTML = h.join("");
    memTable("slipLines", lines.cols, lines.rows, 1, 500, ["STotaux", "E", "E", "E", "E", "N" + g, "N" + r, "E"]);
  } catch (e) { $("slipOut").innerHTML = '<p class="err">' + esc(errText(e)) + '</p>'; }
}
function exportSlip() {
  var d = curSlip.data, rows = [], i, j, row;
  if (!d) return;
  rows.push([X("S", T("Bulletin de paie") + " - " + d.perLabel, "t")]);
  rows.push([]);
  for (i = 0; i < d.info.cols.length; i++) rows.push([X("S", d.info.cols[i], "b"), xr(d.info.rows[0][i])]);
  rows.push([]);
  row = [];
  for (i = 0; i < d.lines.cols.length; i++) row.push(X("S", T(d.lines.cols[i]), "h"));
  rows.push(row);
  for (i = 0; i < d.lines.rows.length; i++) {
    row = [];
    for (j = 0; j < d.lines.rows[i].length; j++) row.push(xr(d.lines.rows[i][j]));
    rows.push(row);
  }
  rows.push([]);
  rows.push([X("S", T("TOTAL GAINS"), "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("N", d.g, "bn")]);
  rows.push([X("S", T("TOTAL RETENUES"), "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("N", d.r, "bn")]);
  rows.push([X("S", T("NET (GAINS - RETENUES)"), "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("E", "", "bf"), X("N", d.net, "bn")]);
  exportXls([{ name: T("Bulletin"), w: [90, 220, 220, 80, 60, 95, 95, 95], rows: rows, entete: true, headRow: 14 }], "Bulletin_" + d.mat + "_" + d.per, "slipMsg");
}

/* ---------- Feature 2: payroll journal of a whole corps for one month ---------- */
var curJ = null;
function genJournal() {
  if (needDb("jOut")) return;
  var per = $("perJ").value;
  if (!per) { $("jOut").innerHTML = '<p class="err">Aucune periode dans les archives.</p>'; return; }
  $("jMsg").innerHTML = "";
  $("jOut").innerHTML = '<span class="muted">Calcul en cours...</span>';
  setTimeout(function () {
    try { doJournal(per, $("corpsSel").value); }
    catch (e) { curJ = null; $("jOut").innerHTML = '<p class="err">' + esc(errText(e)) + '</p>'; }
  }, 30);
}
function doJournal(per, corps) {
  var i, j, k, e;
  var fromE = "FROM ((Archive a INNER JOIN Dossier dos ON dos.Matricule = a.Matricule) LEFT JOIN Grade g ON g.Code = dos.Code_Grade) ";
  var where = "WHERE a.Code_Periode_Exercice='" + sq(per) + "' AND a.Code_Traitement=0" + (corps ? " AND g.Code_Corps='" + sq(corps) + "'" : "");
  var emps = qr("SELECT dos.Matricule, dos.Nom, dos.Prenom, dos.Nom_Arab, dos.Prenom_Arab, g.Libelle AS Grade " + fromE + where + " ORDER BY dos.Nom, dos.Prenom, dos.Matricule");
  if (emps.rows.length == 0) { curJ = null; $("jOut").innerHTML = '<p class="err">Aucun bulletin pour ce corps pendant cette periode.</p>'; return; }
  var vr = qr("SELECT a.Matricule, d.Code_Rubrique, d.Valeur FROM (((Archive_Detail d INNER JOIN Archive a ON d.Cle_Archive = a.Cle_Archive) " +
    "INNER JOIN Dossier dos ON dos.Matricule = a.Matricule) LEFT JOIN Grade g ON g.Code = dos.Code_Grade) " + where + " AND d.Valeur<>0");
  var meta = qr("SELECT Code, Libelle, Code_Type, Ordre FROM Rubrique ORDER BY Ordre");

  var V = {}, seen = {};
  for (i = 0; i < vr.rows.length; i++) {
    var mk = "k" + lc(rv(vr.rows[i][0])), ck = "k" + lc(rv(vr.rows[i][1]));
    if (!V[mk]) V[mk] = {};
    V[mk][ck] = (V[mk][ck] || 0) + rnum(vr.rows[i][2]);
    seen[ck] = true;
  }
  var gains = [], rets = [], ints = [], known = {};
  for (i = 0; i < meta.rows.length; i++) {
    var code = rv(meta.rows[i][0]), key = "k" + lc(code), lib = rv(meta.rows[i][1]) || code, ty = parseFloat(rv(meta.rows[i][2]));
    known[key] = true;
    if (!seen[key]) continue;
    var it = { key: key, lib: lib };
    if (ty == 0) gains.push(it); else if (ty == 1) rets.push(it); else ints.push(it);
  }
  for (k in seen) { if (seen.hasOwnProperty(k) && !known[k]) ints.push({ key: k, lib: k.substring(1) }); }
  var inclInt = $("jInt").checked;

  function journalNorm(t) { return String(t||"").toLowerCase().replace(/[éèêë]/g,"e").replace(/[àâä]/g,"a").replace(/['’`]/g,"").replace(/[\s._\-\/()]+/g,""); }
  function journalIsAF(it) { var c=journalNorm(String(it.key||"").replace(/^k/,"")),l=journalNorm(it.lib); return /allocationfamil/.test(c)||/allocationfamil/.test(l)||/^mifr$/.test(c)||/^mifr/.test(l)||/^salaireunique/.test(c)||/salaireunique/.test(l); }
  function journalIsHousing(it) { var c=journalNorm(String(it.key||"").replace(/^k/,"")),l=journalNorm(it.lib); return /^indlog/.test(c)||/^indlog/.test(l)||/indemnitelogement/.test(c)||/indemnitelogement/.test(l)||/^logement/.test(c)||/^logement/.test(l); }
  var cols = ["N", "Matricule", "Nom", "Prenom", "Grade"];
  for (i = 0; i < gains.length; i++) cols.push(gains[i].lib);
  cols.push("TOTAL GAINS HORS A.F");
  cols.push("TOTAL GAINS HORS A.F ET LOGEMENT");
  for (i = 0; i < rets.length; i++) cols.push(rets[i].lib);
  cols.push("TOTAL RETENUES"); cols.push("NET (GAINS - RETENUES)");
  if (inclInt) for (i = 0; i < ints.length; i++) cols.push(ints[i].lib);

  var rows = [], tot = [];
  for (j = 0; j < cols.length; j++) tot.push(0);
  for (i = 0; i < emps.rows.length; i++) {
    e = emps.rows[i];
    var vals = V["k" + lc(rv(e[0]))] || {}, sg = 0, sgNoAF = 0, sgNoAFNoHousing = 0, sr = 0, v;
    var row = ["I" + (i + 1), e[0], "S" + (rv(e[3]) || rv(e[1])), "S" + (rv(e[4]) || rv(e[2])), e[5]];
    for (j = 0; j < gains.length; j++) {
      v = vals[gains[j].key] || 0; sg += v;
      if (!journalIsAF(gains[j])) { sgNoAF += v; if (!journalIsHousing(gains[j])) sgNoAFNoHousing += v; }
      row.push(v ? "N" + r2(v) : "E");
    }
    row.push("N" + r2(sgNoAF));
    row.push("N" + r2(sgNoAFNoHousing));
    for (j = 0; j < rets.length; j++) { v = vals[rets[j].key] || 0; sr += v; row.push(v ? "N" + r2(v) : "E"); }
    row.push("N" + r2(sr)); row.push("N" + r2(sg - sr));
    if (inclInt) for (j = 0; j < ints.length; j++) { v = vals[ints[j].key] || 0; row.push(v ? "N" + r2(v) : "E"); }
    for (j = 5; j < row.length; j++) tot[j] += rnum(row[j]);
    rows.push(row);
  }
  var foot = ["STOTAL", "S" + emps.rows.length + " agents", "E", "E", "E"];
  for (j = 5; j < cols.length; j++) foot.push("N" + r2(tot[j]));
  var gi = 5 + gains.length, g2i = gi + 1, ri = g2i + 1 + rets.length, ni = ri + 1;
  curJ = { cols: cols, rows: rows, foot: foot, per: per, perLabel: selText("perJ"), corpsLabel: corps ? selText("corpsSel") : "Tous les corps", corpsCode: corps };
  $("jOut").innerHTML = '<p><b>' + esc(curJ.corpsLabel) + ' &mdash; ' + esc(curJ.perLabel) + '</b><br>' + emps.rows.length + ' agents &nbsp; Gains hors A.F: ' + fmtNum(tot[gi]) +
    ' &nbsp; Gains hors A.F et logement: ' + fmtNum(tot[g2i]) + ' &nbsp; Retenues: ' + fmtNum(tot[ri]) + ' &nbsp; Net (avec A.F): ' + fmtNum(tot[ni]) + '</p><div id="jGrid"></div>';
  memTable("jGrid", cols, rows, 1, 50, foot);
}
function exportJournal() {
  var d = curJ, rows = [], i, j, row, c;
  if (!d) { $("jMsg").innerHTML = '<span class="err">Generez d\'abord le journal.</span>'; return; }
  rows.push([X("S", T("Journal de paie") + " - " + d.corpsLabel + " - " + d.perLabel, "t")]);
  rows.push([]);
  row = [];
  for (i = 0; i < d.cols.length; i++) row.push(X("S", T(d.cols[i]), "h"));
  rows.push(row);
  for (i = 0; i < d.rows.length; i++) {
    row = [];
    for (j = 0; j < d.rows[i].length; j++) row.push(xr(d.rows[i][j]));
    rows.push(row);
  }
  row = [];
  for (j = 0; j < d.foot.length; j++) { c = xr(d.foot[j], rt(d.foot[j]) == "N" ? "bn" : "bf"); if (c.t == "E") c.s = "bf"; row.push(c); }
  rows.push(row);
  var w = [30, 70, 110, 110, 160];
  for (j = 5; j < d.cols.length; j++) w.push(88);
  exportXls([{ name: T("Journal"), w: w, rows: rows, land: true, entete: true, headRow: 3 }], "Journal_" + (d.corpsCode || "tous") + "_" + d.per, "jMsg");
}


